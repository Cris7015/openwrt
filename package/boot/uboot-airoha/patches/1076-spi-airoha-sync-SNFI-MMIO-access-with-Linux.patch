 			err = regmap_read(regmap_scu, REG_SCUCLK_BOOT_TRP, boot_trp);
@@ -303,12 +318,8 @@ airoha_snand_get_bootstrap(struct airoha_snand_priv *priv, u32 *boot_trp,
