+static void airoha_snand_update_bits(void __iomem *base, u32 reg,
+				     u32 mask, u32 value)
+{
+	u32 val = readl(base + reg);
+
+	val &= ~mask;
+	val |= value & mask;
+	writel(val, base + reg);
+}
