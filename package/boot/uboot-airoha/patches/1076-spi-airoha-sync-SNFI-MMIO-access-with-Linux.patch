-		err = regmap_write(priv->regmap_ctrl,
-				   REG_SPI_CTRL_MTX_MODE_TOG, 0);
-		if (err)
-			return err;
+		CTRL_WRITE(priv, REG_SPI_CTRL_MTX_MODE_TOG, 0);
 
-		err = regmap_write(priv->regmap_ctrl,
-				   REG_SPI_CTRL_MANUAL_EN, 0);
