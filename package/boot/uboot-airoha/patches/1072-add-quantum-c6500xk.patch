From 9cadfc4c837b284763f903a20b05790b1e8ce4d1 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Thu, 1 Oct 2026 22:56:22 -0300
Subject: [PATCH] add quantum c6500xk

---
 .../dts/econet,en7580-quantum_c6500xk.dts     | 99 +++++++++++++++++++
 arch/mips/dts/econet,en7580.dtsi              | 62 +++++++++---
 configs/en7580_quantum-c6500xk_defconfig      | 86 ++++++++++++++++
 defenvs/en7580-quantum_c6500xk_env            | 40 ++++++++
 4 files changed, 276 insertions(+), 11 deletions(-)
 create mode 100644 arch/mips/dts/econet,en7580-quantum_c6500xk.dts
 create mode 100644 configs/en7580_quantum-c6500xk_defconfig
 create mode 100644 defenvs/en7580-quantum_c6500xk_env

diff --git a/arch/mips/dts/econet,en7580-quantum_c6500xk.dts b/arch/mips/dts/econet,en7580-quantum_c6500xk.dts
new file mode 100644
index 00000000..8b561bfb
--- /dev/null
+++ b/arch/mips/dts/econet,en7580-quantum_c6500xk.dts
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+#include "econet,en7580.dtsi"
+
+/ {
+	model = "Quantum C6500XK";
+	compatible = "quantum,c6500xk", "econet,en7580", "airoha,en7580";
+
+	/* The RAM-training stage replaces this size during U-Boot startup. */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x00000000 0x10000000>;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&spi0 {
+	status = "okay";
+
+/*
+[    3.222338] 0x000000000000-0x000000200000 : "bootloader"
+[    3.242515] 0x000000200000-0x000000400000 : "dsd"
+[    3.348448] 0x000000400000-0x000004400000 : "tclinux"
+[    3.462141] 0x000004400000-0x000008400000 : "tclinux_slave"
+[    3.481968] 0x000008400000-0x00001c400000 : "system"
+[    3.500182] 0x00001c400000-0x00001c600000 : "uenv"
+[    3.517237] 0x00001d5c0000-0x00001d740000 : "art"
+*/
+	
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+		spi-tx-bus-width = <1>;
+		spi-rx-bus-width = <2>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			bootloader@0 {
+				label = "tcboot";
+				reg = <0x00000000 0x00200000>;
+				read-only;
+			};
+
+			dsd@200000 {
+				label = "dsd";
+				reg = <0x00200000 0x00200000>;
+			};
+
+			tclinux@400000 {
+				label = "tclinux";
+				reg = <0x00400000 0x00400000>;
+			};
+
+			tclinux_slave@440000 {
+				label = "tclinux_slave";
+				reg = <0x00440000 0x00400000>;
+			};
+
+			system@840000 {
+				label = "system";
+				reg = <0x00840000 0x01400000>;
+			};
+
+			uenv@1c400000 {
+				label = "uenv";
+				reg = <0x01c40000 0x00200000>;
+			};
+
+			art@1d5c0000 {
+				label = "art";
+				reg = <0x1d5c0000 0x00180000>;
+			};
+		};
+	};
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+};
\ No newline at end of file
diff --git a/arch/mips/dts/econet,en7580.dtsi b/arch/mips/dts/econet,en7580.dtsi
index 46ce0f81..c1b8eb65 100644
--- a/arch/mips/dts/econet,en7580.dtsi
+++ b/arch/mips/dts/econet,en7580.dtsi
@@ -1,9 +1,14 @@
 // SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
 
-#include <dt-bindings/reset/airoha,en7523-reset.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/clock/econet,en7580-scu.h>
+#include <dt-bindings/reset/econet,en7580-scu.h>
 
 / {
-	compatible = "airoha,en7580";
+	compatible = "econet,en7580", "airoha,en7580";
 	#address-cells = <1>;
 	#size-cells = <1>;
 
@@ -20,6 +25,7 @@
 
 	aliases {
 		serial0 = &uart0;
+		ethernet0 = &gdm1;
 	};
 
 	soc {
@@ -29,27 +35,43 @@
 		ranges;
 
 		chip_scu: syscon@1fa20000 {
-			compatible = "airoha,en7580-chip-scu",
-				     "airoha,en7528-chip-scu", "syscon";
+			compatible = "airoha,scuclk", "airoha,en7580-chip-scu", "syscon";
 			reg = <0x1fa20000 0x400>;
 		};
 
 		scuclk: system-controller@1fb00000 {
-			compatible = "airoha,en7580-scu", "airoha,en7528-scu",
-				     "syscon";
+			compatible = "airoha,en7580-scu", "syscon";
 			reg = <0x1fb00000 0x1000>;
+
 			airoha,chip-scu = <&chip_scu>;
 			#clock-cells = <1>;
 			#reset-cells = <1>;
 		};
 
+		system-controller@1fbf0200 {
+			compatible = "syscon", "simple-mfd";
+			reg = <0x1fbf0200 0xc0>;
+
+			pinctrl: pinctrl {
+				compatible = "airoha,en7580-pinctrl";
+				airoha,chip-scu = <&chip_scu>;
+
+				gpio-controller;
+				#gpio-cells = <2>;
+				gpio-ranges = <&pinctrl 0 0 42>;
+			};
+		};
+
 		uart0: serial@1fbf0000 {
 			compatible = "ns16550";
 			reg = <0x1fbf0000 0x30>;
+
 			reg-io-width = <4>;
 			reg-shift = <2>;
+
 			clock-frequency = <1843200>;
 			current-speed = <115200>;
+
 			status = "disabled";
 		};
 
@@ -57,25 +79,33 @@
 			compatible = "airoha,en7523-spi";
 			reg = <0x1fa10000 0x140>,
 			      <0x1fa11000 0x600>;
+
+			clocks = <&scuclk EN7580_CLK_SPI>;
+			clock-names = "spi";
+
 			#address-cells = <1>;
 			#size-cells = <0>;
+
 			status = "disabled";
 		};
 
 		eth: ethernet@1fb50000 {
 			compatible = "econet,en7580-eth";
+			status = "disabled";
 			reg = <0x1fb50000 0x2600>,
 			      <0x1fb54000 0x2000>,
 			      <0x1fb56000 0x2000>,
 			      <0x1fa40000 0x8000>;
 			reg-names = "fe", "qdma0", "qdma1", "gdmp";
-			resets = <&scuclk EN7523_FE_RST>,
-				 <&scuclk EN7523_FE_PDMA_RST>,
-				 <&scuclk EN7523_FE_QDMA_RST>;
-			reset-names = "fe", "pdma", "qdma";
+
+			resets = <&scuclk EN7580_FE_RST>,
+				 <&scuclk EN7580_FE_QDMA1_RST>,
+				 <&scuclk EN7580_FE_QDMA2_RST>,
+				 <&scuclk EN7580_GSW_RST>;
+			reset-names = "fe", "pdma", "qdma", "switch";
+
 			#address-cells = <1>;
 			#size-cells = <0>;
-			status = "disabled";
 
 			gdm1: mac@1 {
 				compatible = "econet,eth-mac";
@@ -93,7 +123,17 @@
 		switch: switch@1fb58000 {
 			compatible = "airoha,en7580-switch";
 			reg = <0x1fb58000 0x8000>;
+
 			status = "disabled";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+			dsa,member = <0 0>;
+
+			mdio {
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
 		};
 	};
 };
