#!/bin/sh /etc/rc.common
# Persistent dual-FXS service. Runtime rendering never replaces stored accounts.
USE_PROCD=1
START=99
STOP=10

CFGDIR=/etc/xr500v-voip
RUNDIR=/var/run/xr500v-voip

prepare_slic() {
	local mode kver attempt
	[ -d /sys/kernel/debug/econet-slic ] || mount -t debugfs none /sys/kernel/debug 2>/dev/null
	kver=$(uname -r)
	[ -d /sys/module/pcm_en751221 ] || insmod "/lib/modules/$kver/pcm-en751221.ko" || return 1
	mode=$(cat /sys/module/econet_slic/parameters/dual_fxs 2>/dev/null)
	if [ "$mode" != Y ] && [ "$mode" != 1 ]; then
		if [ -d /sys/module/econet_slic ]; then
			# Never force an unload or reset another active voice stream.
			rmmod econet_slic || return 1
		fi
		insmod "/lib/modules/$kver/econet-slic.ko" dual_fxs=1 zsi_gap_us=1000 || return 1
	fi
	for attempt in 1 2 3 4 5; do
		[ -e /dev/xr500v-voice ] && [ -e /dev/xr500v-voice1 ] && return 0
		sleep 1
	done
	return 1
}

# idle_feed: "standby" (default, silent) or "active" (instant dial tone, the
# router's DC-DC hiss is audible in the handset). Anything else falls back.
voip_idle_feed() {
	local value
	config_get value "phone$1" idle_feed standby
	case "$value" in
		standby|active) ;;
		*) logger -t voip "phone$1 idle_feed '$value' invalid, using standby"; value=standby ;;
	esac
	echo "$value"
}

start_service() {
	local enabled aec denoise gain line active ip device cfg mode net ring_on ring_off ring_prefeed emergency cid
	local cw flash_min flash_max
	local mode1 mode2 shared feed feed1 feed2
	. /lib/functions.sh
	config_load xr500v-voip
	config_get_bool enabled globals enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get_bool aec globals echo_cancel 1
	config_get_bool denoise globals noise_suppress 1
	config_get gain globals playback_percent 50
	case "$gain" in ''|*[!0-9]*) return 1 ;; esac
	[ "$gain" -ge 25 ] && [ "$gain" -le 100 ] || return 1
	config_get ring_on globals ring_on_ms 1000
	config_get ring_off globals ring_off_ms 4000
	config_get ring_prefeed globals ring_prefeed_ms 1500
	config_get emergency globals emergency_numbers ''
	config_get cid globals caller_id off
	case "$cid" in off|v23|bell202) ;; *) return 1 ;; esac
	config_get_bool cw globals call_waiting 1
	config_get flash_min globals flash_min_ms 80
	config_get flash_max globals flash_max_ms 750
	case "$flash_min$flash_max" in ''|*[!0-9]*) return 1 ;; esac
	case "$ring_on$ring_off$ring_prefeed" in ''|*[!0-9]*) return 1 ;; esac
	# Empty is valid (no emergency numbers, the shipped default).
	case "$emergency" in *[!0-9*#\ ,\;]*) return 1 ;; esac
	ip=$(uci -q get network.lan.ipaddr)
	ip=${ip%%/*}
	# The legacy template needs a placeholder, but a managed profile resolves
	# its own selected interface. It must never fall back to this address.
	[ -n "$ip" ] || ip=127.0.0.1
	prepare_slic || { logger -t voip 'Dual FXS initialization failed'; return 1; }
	feed1=$(voip_idle_feed 1)
	feed2=$(voip_idle_feed 2)
	# Shared ring group: phone2 joins phone1's account. Only phone1 gets a
	# baresip + a manager, and that manager drives BOTH jacks. Without a
	# managed account on phone1 there is nothing to share, so phone2 stays down.
	config_get mode1 phone1 account_mode
	config_get mode2 phone2 account_mode
	shared=0
	if [ "$mode2" = shared ]; then
		if [ -n "$mode1" ]; then
			shared=1
		else
			logger -t voip 'phone2 shared mode ignored: phone1 has no managed account; phone2 not started'
		fi
	fi
	for line in 1 2; do
		config_get_bool active "phone$line" enabled 1
		[ "$active" = 1 ] || continue
		if [ "$line" = 2 ] && [ "$mode2" = shared ]; then
			[ "$shared" = 1 ] && logger -t voip 'phone2 rings with phone1 (shared); no separate SIP account'
			# Drop a rendered profile left by a previous mode so Status
			# does not report a phone2 account that nothing serves.
			rm -f "$RUNDIR/phone2/accounts" "$RUNDIR/phone2/config" \
				"$RUNDIR/phone2/dialing" "$RUNDIR/phone2/speeddial"
			continue
		fi
		/usr/libexec/xr500v-voip-render "$line" "$ip" "$CFGDIR" "$RUNDIR" || return 1
		if ! /usr/libexec/xr500v-voip-profile "$line"; then
			logger -t voip "Phone $line not started: profile invalid or selected interface unavailable"
			continue
		fi
		cfg="$RUNDIR/phone$line"
		device=/dev/xr500v-voice
		[ "$line" = 2 ] && device=/dev/xr500v-voice1
		procd_open_instance "phone$line-sip"
		procd_set_param command /usr/bin/baresip -f "$cfg"
		procd_set_param file "$cfg/config" "$cfg/accounts" "$cfg/dialing" "$cfg/speeddial"
		if [ "$shared" = 1 ] && [ "$line" = 1 ]; then
			# The manager publishes the jack that answered; baresip reads
			# it when the call starts (xr500v.c xr_get_fd).
			procd_set_param env "XR500V_DEVICE=$device" "XR500V_DEVICE_FILE=$cfg/audio_device" \
				"XR500V_AEC=$aec" "XR500V_DENOISE=$denoise" "XR500V_PLAYBACK_PERCENT=$gain" \
				"XR500V_CALL_WAITING=$cw"
		else
			procd_set_param env "XR500V_DEVICE=$device" "XR500V_AEC=$aec" "XR500V_DENOISE=$denoise" "XR500V_PLAYBACK_PERCENT=$gain" \
				"XR500V_CALL_WAITING=$cw"
		fi
		procd_set_param respawn 3600 5 5
		config_get mode "phone$line" account_mode
		if [ -n "$mode" ]; then
			config_get net "phone$line" network lan
			procd_set_param data "network=$net"
		fi
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		procd_open_instance "phone$line-manager"
		procd_set_param command /usr/sbin/xr500v-callmgr
		procd_set_param file "$cfg/config" "$cfg/accounts" "$cfg/dialing" "$cfg/speeddial"
		if [ "$shared" = 1 ] && [ "$line" = 1 ]; then
			procd_set_param env "XR500V_LINE=1" "XR500V_RUNTIME_DIR=$RUNDIR" "XR500V_SHARED=1" \
				"XR500V_RING_ON_MS=$ring_on" "XR500V_RING_OFF_MS=$ring_off" "XR500V_RING_PREFEED_MS=$ring_prefeed" \
				"XR500V_EMERGENCY_NUMBERS=$emergency" "XR500V_CALLER_ID=$cid" \
				"XR500V_CALL_WAITING=$cw" "XR500V_FLASH_MIN_MS=$flash_min" "XR500V_FLASH_MAX_MS=$flash_max" \
				"XR500V_IDLE_FEED_1=$feed1" "XR500V_IDLE_FEED_2=$feed2"
		else
			feed=$feed1
			[ "$line" = 2 ] && feed=$feed2
			procd_set_param env "XR500V_LINE=$line" "XR500V_RUNTIME_DIR=$RUNDIR" \
				"XR500V_RING_ON_MS=$ring_on" "XR500V_RING_OFF_MS=$ring_off" "XR500V_RING_PREFEED_MS=$ring_prefeed" \
				"XR500V_EMERGENCY_NUMBERS=$emergency" "XR500V_CALLER_ID=$cid" \
				"XR500V_CALL_WAITING=$cw" "XR500V_FLASH_MIN_MS=$flash_min" "XR500V_FLASH_MAX_MS=$flash_max" \
				"XR500V_IDLE_FEED=$feed"
		fi
		procd_set_param respawn 3600 5 5
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	done
}

service_triggers() {
	local line mode net
	. /lib/functions.sh
	config_load xr500v-voip
	procd_add_reload_trigger xr500v-voip
	for line in 1 2; do
		config_get mode "phone$line" account_mode
		[ -n "$mode" ] || continue
		[ "$mode" = shared ] && continue
		config_get net "phone$line" network lan
		procd_add_interface_trigger 'interface.*' "$net" /etc/init.d/voip reload
	done
}

# Default procd reload re-renders profiles and compares file contents.
# Stable interface events do not restart calls; only changed/down bindings
# replace/remove the affected port's instances.

stop_service() {
	# Do not leave a stale diagnostic endpoint when switching back to the
	# saved RAM service. No persistent account files are removed.
	local line
	for line in 1 2; do
		[ ! -p "$RUNDIR/phone$line/control" ] || rm -f "$RUNDIR/phone$line/control"
	done
}
