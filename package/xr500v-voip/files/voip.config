config voip 'globals'
	option enabled '1'
	option echo_cancel '1'
	option noise_suppress '1'
	option playback_percent '50'
	# Ring cadence (ms) and numbers dialed without the inter-digit wait.
	# The list is per country and matched exactly, so a longer number that
	# starts with one of them can no longer be dialed; e.g. for Argentina:
	# option emergency_numbers '911 100 101 103 105 106 107 135 142 144'
	option ring_on_ms '1000'
	option ring_off_ms '4000'
	# Active line feed held before the first burst, so that it rings as fully
	# as the later ones (0 = ring straight out of standby).
	option ring_prefeed_ms '1500'
	option emergency_numbers ''
	# Caller ID sent after the first burst: 'v23' (ETSI FSK, Argentina and
	# most of Europe), 'bell202' (North America) or 'off'. Experimental: not
	# yet decoded by the phone it was tested with.
	option caller_id 'off'
	# Call waiting: a second call during a conversation gives a tone
	# instead of busy; the R key (a hook flash of flash_min_ms..flash_max_ms,
	# the Movistar AR HGU uses 120..750) answers it and swaps between the two.
	option call_waiting '1'
	option flash_min_ms '80'
	option flash_max_ms '750'

# idle_feed: 'standby' (silent line while on hook, default) or 'active'
# (instant dial tone, the DC-DC hiss is audible in the earpiece at idle).
# account_mode on phone2 also accepts 'shared': both jacks ring and dial on
# the phone1 account; phone2 then runs no baresip and no manager of its own.
config line 'phone1'
	option enabled '1'
	option idle_feed 'standby'

config line 'phone2'
	option enabled '1'
	option idle_feed 'standby'
