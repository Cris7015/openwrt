From: Cristian Papa <pcristian292@gmail.com>
Subject: [PATCH] econet: release port spinlock before enabling QDMA

Limit the port register lock to the RX length threshold update.  QDMA use
takes a mutex and enables NAPI, so it must not run while the spinlock is
held by the function-scoped guard.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
---
 econet_port.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

--- a/econet_port.c
+++ b/econet_port.c
@@ -153,11 +153,12 @@ static int en75_dev_open(struct net_devi
 	// 			GDM_STAG_EN_MASK);
 
-	guard(spinlock)(&port->reg_lock);
-	rlt = en75_rreg(&port->regs->rx_len_threshold);
-	rlt.runt_len = 60;
-	rlt.oversize_len = ETH_HLEN + dev->mtu + ETH_FCS_LEN;
-	en75_wreg(rlt, &port->regs->rx_len_threshold);
+	scoped_guard(spinlock, &port->reg_lock) {
+		rlt = en75_rreg(&port->regs->rx_len_threshold);
+		rlt.runt_len = 60;
+		rlt.oversize_len = ETH_HLEN + dev->mtu + ETH_FCS_LEN;
+		en75_wreg(rlt, &port->regs->rx_len_threshold);
+	}
 
 	return en75_qdma_use(port->qdma);
 }
