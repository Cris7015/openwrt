From: Cristian Papa <pcristian292@gmail.com>
Subject: [PATCH] econet: reserve QDMA TX descriptors for real traffic

The WiFi-to-PPE path shares QDMA0 TX chain 0 with real Ethernet traffic. A
dev-less internal injection must not exhaust that ring: if a real netdev is
then stopped while no real skb remains in flight, an injected completion has
no device to wake and the network can remain wedged.

Add an atomic reserve-aware xmit helper and keep 32 descriptors available by
default for the normal datapath. Reserve refusals are fail-open and counted
separately from actual QDMA errors.

---
--- a/econet_eth.h
+++ b/econet_eth.h
@@ -204,6 +204,9 @@
 int en75_qdma_destroy(struct en75_qdma *qdma);
 int en75_qdma_xmit(struct en75_qdma *qdma, struct sk_buff *skb,
 		   union desc_msg *msg, int qid);
+int en75_qdma_xmit_reserve(struct en75_qdma *qdma, struct sk_buff *skb,
+			   union desc_msg *msg, int qid,
+			   unsigned int reserve);
 int en75_qdma_set_tx_immediate_done(struct en75_qdma *qdma, bool enable,
 				    u32 *old_cfg, u32 *new_cfg);
 
--- a/econet_qdma.c
+++ b/econet_qdma.c
@@ -1462,16 +1462,18 @@
 }
 EXPORT_SYMBOL_GPL(en75_qdma_set_loopback);
 
-int en75_qdma_xmit(struct en75_qdma *qdma, struct sk_buff *skb,
-		   union desc_msg *msg, int qid)
+static int __en75_qdma_xmit(struct en75_qdma *qdma, struct sk_buff *skb,
+			    union desc_msg *msg, int qid,
+			    unsigned int reserve)
 {
 	struct en75_q_tx *q = &qdma->q_tx[qid];
 	int len = skb_headlen(skb);
 	struct en75_q_tx_ent *e;
-	u16 index, next_index;
+	u16 index, next_index, probe;
 	struct desc *desc;
 	dma_addr_t addr;
 	bool ring_full;
+	unsigned int i;
 
 	guard(spinlock_bh)(&q->lock_bh);
 
@@ -1488,6 +1490,21 @@
 		return -EBUSY;
 	}
 
+	/* CPU-injected internal traffic shares this ring with real Ethernet. Keep
+	 * a hard reserve so it cannot consume the descriptor that a stopped real
+	 * netdev would need in order to queue a packet and later wake itself. The
+	 * check and allocation run under the same lock, so the reserve cannot race
+	 * another producer. A reserve refusal is not a full-ring condition and must
+	 * not set queues_stopped. */
+	if (reserve) {
+		probe = index;
+		for (i = 0; i <= reserve; i++) {
+			probe = q->entry[probe].freelist_next;
+			if (probe == 0xffff)
+				return -EAGAIN;
+		}
+	}
+
 	e = &q->entry[index];
 	next_index = e->freelist_next;
 	if (next_index == 0xffff) {
@@ -1541,8 +1558,22 @@
 
 	return ring_full ? EBUSY : 0;
 }
+
+int en75_qdma_xmit(struct en75_qdma *qdma, struct sk_buff *skb,
+		   union desc_msg *msg, int qid)
+{
+	return __en75_qdma_xmit(qdma, skb, msg, qid, 0);
+}
 EXPORT_SYMBOL_GPL(en75_qdma_xmit);
 
+int en75_qdma_xmit_reserve(struct en75_qdma *qdma, struct sk_buff *skb,
+			   union desc_msg *msg, int qid,
+			   unsigned int reserve)
+{
+	return __en75_qdma_xmit(qdma, skb, msg, qid, reserve);
+}
+EXPORT_SYMBOL_GPL(en75_qdma_xmit_reserve);
+
 /* The OEM LAN-QDMA driver enables this bit specifically for the learning
  * path QDMA->PPE->QDMA: no real GDM egress exists there to return pkt_done,
  * so QDMA must generate its own completion. Keep it runtime-gated for the
--- a/econet_ppe.c
+++ b/econet_ppe.c
@@ -1321,6 +1321,8 @@
 unsigned int en75_whnat_up_err_copy;	/* copy/expand allocation failed */
 unsigned int en75_whnat_up_err_headroom;	/* invariant failure after expansion */
 unsigned int en75_whnat_up_err_xmit;	/* QDMA ring rejected the copy */
+unsigned int en75_whnat_up_backpressure;	/* refused early to preserve real TX */
+unsigned int en75_whnat_up_reserve = 32;	/* descriptors kept for real traffic */
 unsigned int en75_whnat_up_err_txdev;	/* optional BQL A/B netdev missing */
 unsigned int en75_whnat_up_fraglist;	/* aggregated frames skipped (see below) */
 unsigned int en75_whnat_up_dup = 1;	/* injections per frame, to beat the noise */
@@ -1754,13 +1756,18 @@
 			netdev_tx_sent_queue(txq, inj->len);
 		en75_whnat_up_track_injected(inj);
 
-		ret = en75_qdma_xmit(en75_whnat_probe_qdma, inj, &msg, 0);
+		ret = en75_qdma_xmit_reserve(en75_whnat_probe_qdma, inj, &msg, 0,
+					      READ_ONCE(en75_whnat_up_reserve));
 		if (ret < 0) {
 			if (txq)
 				netdev_tx_completed_queue(txq, 1, inj->len); /* undo */
 			kfree_skb(inj);
-			en75_whnat_up_err++;
-			en75_whnat_up_err_xmit++;
+			if (ret == -EAGAIN)
+				en75_whnat_up_backpressure++;
+			else {
+				en75_whnat_up_err++;
+				en75_whnat_up_err_xmit++;
+			}
 			if (take)
 				en75_whnat_up_take_fallback++;
 			break;		/* ring is full; stop pushing */
--- a/econet_ppe.h
+++ b/econet_ppe.h
@@ -341,6 +341,8 @@
 extern unsigned int en75_whnat_up_err_copy;
 extern unsigned int en75_whnat_up_err_headroom;
 extern unsigned int en75_whnat_up_err_xmit;
+extern unsigned int en75_whnat_up_backpressure;
+extern unsigned int en75_whnat_up_reserve;
 extern unsigned int en75_whnat_up_err_txdev;
 extern unsigned int en75_whnat_up_fraglist;
 extern unsigned int en75_whnat_up_dup;
--- a/econet_eth.c
+++ b/econet_eth.c
@@ -496,6 +496,8 @@
 module_param_named(whnat_up_err_copy, en75_whnat_up_err_copy, uint, 0444);
 module_param_named(whnat_up_err_headroom, en75_whnat_up_err_headroom, uint, 0444);
 module_param_named(whnat_up_err_xmit, en75_whnat_up_err_xmit, uint, 0444);
+module_param_named(whnat_up_backpressure, en75_whnat_up_backpressure, uint, 0444);
+module_param_named(whnat_up_reserve, en75_whnat_up_reserve, uint, 0644);
 module_param_named(whnat_up_err_txdev, en75_whnat_up_err_txdev, uint, 0444);
 module_param_named(whnat_up_fraglist, en75_whnat_up_fraglist, uint, 0444);
 module_param_named(whnat_up_dup, en75_whnat_up_dup, uint, 0644);
