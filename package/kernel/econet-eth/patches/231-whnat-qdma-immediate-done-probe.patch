+/* Generic SoC register peek/poke by PHYSICAL address, for blocks this driver
+ * does not map. ppe_fe only reaches fe_base+0..0xfffc, and the OEM hw_nat.ko
+ * touches a whole region we never mapped (it reads 0x1fb00064 and branches on
+ * the top 16 bits being 7 or 8 -- a silicon revision check).
+ *   echo 0x1fb00064 > phys_rw            (read)
+ *   echo 0x1fb00064=0x1234 > phys_rw     (write)
+ * Address is physical and must be 4-byte aligned. */
+static int en75_phys_rw_set(const char *val, const struct kernel_param *kp)
+{
+	char buf[48], *eq;
+	void __iomem *m;
+	u32 addr, v = 0;
+	bool write;
+
+	strscpy(buf, val, sizeof(buf));
+	eq = strchr(buf, '=');
+	write = (eq != NULL);
+	if (eq) {
+		*eq = '\0';
+		if (kstrtou32(eq + 1, 0, &v))
+			return -EINVAL;
+	}
+	if (kstrtou32(buf, 0, &addr))
+		return -EINVAL;
+	addr &= ~3u;
+
+	m = ioremap(addr, 4);
+	if (!m)
+		return -ENOMEM;
+	if (write) {
+		u32 old = readl(m);
+
+		writel(v, m);
+		pr_info("XR500v phys[%08x]: %08x -> %08x (rb=%08x)\n",
+			addr, old, v, readl(m));
+	} else {
+		pr_info("XR500v phys[%08x] = %08x\n", addr, readl(m));
+	}
+	iounmap(m);
+	return 0;
+}
+static const struct kernel_param_ops en75_phys_rw_ops = {
+	.set = en75_phys_rw_set, .get = param_get_int,
+};
+static int phys_rw_v;
+module_param_cb(phys_rw, &en75_phys_rw_ops, &phys_rw_v, 0644);
