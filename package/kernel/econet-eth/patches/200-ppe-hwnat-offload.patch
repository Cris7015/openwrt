+static void en75_mac_from_hilo(u8 *m, u32 hi, u32 lo)
+{
+	m[0] = hi >> 24; m[1] = hi >> 16; m[2] = hi >> 8; m[3] = hi;
+	m[4] = lo >> 8;  m[5] = lo;
+}
+static int en75_ppe_run_test(bool bind)
+{
+	u8 smac[ETH_ALEN], dmac[ETH_ALEN];
+
+	if (!en75_the_ppe)
+		return -ENODEV;
+	en75_mac_from_hilo(smac, ppe_t_smac_hi, ppe_t_smac_lo);
+	en75_mac_from_hilo(dmac, ppe_t_dmac_hi, ppe_t_dmac_lo);
+	if (bind)
+		en75_ppe_bindtest_register(en75_the_ppe, htonl(ppe_t_sip),
+			htonl(ppe_t_dip), htons(ppe_t_sport), htons(ppe_t_dport),
+			ppe_t_proto, smac, dmac, ppe_t_dsaport, ppe_t_pt, ppe_t_pseport);
+	else
+		en75_ppe_committest(en75_the_ppe, htonl(ppe_t_sip),
+			htonl(ppe_t_dip), htons(ppe_t_sport), htons(ppe_t_dport),
+			ppe_t_proto, smac, dmac, ppe_t_dsaport, ppe_t_pt, ppe_t_pseport);
+	return 0;
+}
+/* only act on a non-zero write: 'echo 0' (used in test revert) must NOT
