+static int en75_ppe_committest_set(const char *val, const struct kernel_param *kp)
+{ bool go; if (kstrtobool(val, &go) || !go) return 0; return en75_ppe_run_test(false); }
+static int en75_ppe_bindtest_set(const char *val, const struct kernel_param *kp)
+{ bool go; if (kstrtobool(val, &go) || !go) return 0; return en75_ppe_run_test(true); }
