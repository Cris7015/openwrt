+module_param(ppe_t_dmac_lo, uint, 0644);
+module_param(ppe_t_dsaport, int, 0644);
+module_param(ppe_t_pt, uint, 0644);
+static unsigned int ppe_t_pseport = 1;	/* 1=GDM1, 7=DISCARD (divert oracle) */
+module_param(ppe_t_pseport, uint, 0644);
+module_param_named(ppe_rxdump, en75_ppe_rxdump, bool, 0644);
+module_param_named(ppe_fpdump, en75_ppe_fpdump, bool, 0644);
+module_param_named(ppe_fpdump_bind, en75_ppe_fpdump_bind, bool, 0644);
+module_param_named(ppe_foedump, en75_ppe_foedump, bool, 0644);
