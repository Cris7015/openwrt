+/* === XR500v PPE: productized engine-arm (patch 381, replaces the op139 script) ===
+ * One-shot HW steering so flowtable HW-NAT offload works with zero userspace
+ * poking. Replicates the validated op139 sequence (cont31e, 51.5 MB/s):
+ *   - FE steering pokes: GDM1_FWD steer-to-PPE, FLOW_CFG, stag VLAN_CHECK/CTRL
+ *   - GLO_CFG engine enable + lookup cache enable
+ *   - the commit-time flags en75_foe_entry_commit depends on (swab_all, etc.)
+ * Armed once, lazily, on the first flowtable FLOW_BLOCK_BIND. Idempotent: the
+ * en75_ppe_armed guard makes repeat BINDs no-ops. Never disarmed live --
+ * `echo 0 > ppe_engine` wedges the datapath; a reboot is the clean teardown.
+ * NOTE: pairs with the switch-side special tag (gsw_stag, econet-gsw); whether
+ * that is still required is being verified separately. */
+static bool en75_ppe_armed;
+
+/* gates the per-packet/flow trace logs (ppe_trace_rl in econet_ppe.h); default
+ * OFF so production builds keep dmesg/console quiet under load. */
+bool en75_ppe_trace;
+module_param_named(ppe_trace, en75_ppe_trace, bool, 0644);
+MODULE_PARM_DESC(ppe_trace, "verbose per-packet/flow PPE trace logs (default off)");
+
+int en75_ppe_engine_arm(struct en75_ppe *ppe)
+{
+	if (!ppe || !en75_ppe_base)
+		return -ENODEV;
+	if (READ_ONCE(en75_ppe_armed))		/* already armed -> no-op */
+		return 0;
+
+	/* commit-time flags: the flowtable commit path (en75_foe_entry_commit)
+	 * reads these; their module-param defaults differ from the validated
+	 * values, so pin them here. cache_mode(=1) and flip_dp(=1) already default
+	 * correct. */
+	WRITE_ONCE(en75_ppe_prebind, false);	/* direct STATE=BIND, no PREBIND handshake */
+	WRITE_ONCE(en75_ppe_swab_all, true);	/* commit every FoE word in engine byte-lane */
+	WRITE_ONCE(en75_ppe_tuple_swab, true);	/* store orig tuple in engine LOOKUP order */
+	WRITE_ONCE(en75_ppe_preserve_key, true);/* keep the engine's UNBIND key on commit */
+
+	/* FE steering pokes (fe_base-relative). Order matches op139: the engine is
+	 * enabled before FLOW_CFG/GDM1_FWD steer traffic into it. */
+	en75_ppe_fe_rw(ppe, 0xE1C, true, 0x0000ffbc);
+	en75_ppe_fe_rw(ppe, 0xE34, true, 0x01010001);
+
+	en75_ppe_engine_set(true);		/* GLO_CFG.EN + mainline mtk_ppe_start value */
+	en75_ppe_cache_set(ppe, true);		/* PPE lookup cache ON */
+
+	en75_ppe_fe_rw(ppe, 0xE04, true, 0x0600f700);		/* FLOW_CFG */
+	en75_ppe_fe_rw(ppe, 0xF18, true, 0x00008100);		/* special-tag TPID */
+	en75_ppe_fe_rw(ppe, EN75_CDMA1_VLAN_CTRL, true, 0x81000001);	/* stag VLAN_CTRL (0x400) */
+	en75_ppe_fe_rw(ppe, 0x510, true, 0x00000001);		/* GDMA1 VLAN_CHECK (stag-aware) */
+	en75_ppe_fe_rw(ppe, 0x500, true, 0x03f04004);		/* GDM1_FWD: steer to PPE */
+	en75_ppe_fe_rw(ppe, 0xE48, true, 0x00000500);
+
+	WRITE_ONCE(en75_ppe_engine, true);	/* reflect armed state in the sysfs param */
+	WRITE_ONCE(en75_ppe_armed, true);
+	pr_info("XR500v PPE: engine armed (flowtable BIND) GDM1_FWD=0x%08x FLOW_CFG=0x%08x\n",
+		readl(ppe->fe_base + 0x500), readl(ppe->fe_base + 0xE04));
+	return 0;
+}
+
+/* Symmetric teardown for en75_ppe_engine_arm. Called from FLOW_BLOCK_UNBIND
+ * when the LAST flowtable block goes away (toggle offload to none/sw, firewall
+ * reload). Without it the engine stays armed and GDM1_FWD(0x500) keeps steering
+ * ALL conduit ingress into a PPE whose FoE entries are stale/empty -> a black
+ * hole that persists until reboot (the en75_ppe_armed latch also makes any
+ * corrective re-arm a no-op). Reverse order of arm: de-steer GDM1 back to CPU
+ * FIRST so traffic falls back to the SW path, only THEN flush the FoE table and
+ * disable the engine -- never leave traffic steered into a torn-down engine. */
+void en75_ppe_engine_disarm(struct en75_ppe *ppe)
+{
+	if (!ppe || !en75_ppe_base)
+		return;
+	if (!READ_ONCE(en75_ppe_armed))		/* not armed -> no-op (symmetric guard) */
+		return;
+	en75_ppe_fe_rw(ppe, 0x500, true, 0x03f00000);	/* GDM1_FWD: steer back to CPU */
+	en75_ppe_flush_all(ppe);			/* invalidate FoE + clear offload_enabled */
+	en75_ppe_engine_set(false);			/* GLO_CFG.EN off */
+	WRITE_ONCE(en75_ppe_engine, false);
+	WRITE_ONCE(en75_ppe_armed, false);		/* clear latch -> next BIND re-arms clean */
+	pr_info("XR500v PPE: engine DISARMED (flowtable UNBIND, list empty) GDM1_FWD=0x%08x\n",
+		readl(ppe->fe_base + 0x500));
+}
+
+static void en75_ppe_init(struct en75_eth_pvt *eth)
+{
+	void __iomem *base = (void __iomem *)eth->regs->ppe;
+	size_t sz = EN75_PPE_NUM_ENTRIES * EN75_FOE_ENTRY_SIZE;
+	dma_addr_t phys;
+	u32 tb_cfg;
+	void *tbl;
+
+	/* build #63: OEM FoeAllocTbl ioremaps a FIXED reserved high phys (NOT
+	 * kernel dma_alloc). Test the hypothesis that the FE DMA master only
+	 * materializes its FORWARD_BUILD entries into that reserved window.
+	 * 0x0dc00000 = OEM live PPE_TB_BASE; reserved no-map in the DTS so the
+	 * kernel never touches it. Access uncached via the MIPS KSEG1 alias. */
+	phys = 0x0dc00000;
+	tbl = (void *)(unsigned long)(0xa0000000u | (u32)phys);
+	memset(tbl, 0, sz);
+	en75_ppe_foe_virt = tbl;
+	en75_ppe_foe_phys = phys;
+	en75_ppe_base = base;
+	en75_the_ppe = en75_ppe_attach(eth->pub.dev, base,
+				       (void __iomem *)eth->regs->fe,
+				       tbl, phys, eth->ports[0]);
+	eth->pub.ppe = en75_the_ppe;
+
+	writel((u32)phys, base + EN75_PPE_TB_BASE);
+	tb_cfg = BIT(7) | BIT(8) | BIT(9) | BIT(10) | BIT(11)	/* AGE bits */
+	       | (3u << 4)					/* SEARCH_MISS=FORWARD_BUILD */
+	       | (3u << 14)					/* HASH_MODE=3 (OEM, build #47) */
+	       | (1u << 16)					/* SCAN_MODE=CHECK_AGE */
+	       | (4u << 0)					/* ENTRY_NUM=ENTRIES_SHIFT */
+	       | BIT(3);					/* ENTRY_80B */
+	writel(tb_cfg, base + EN75_PPE_TB_CFG);
+	writel(0xffffffffu, base + EN75_PPE_IP_PROTO_CHK);
+	writel(BIT(0), base + EN75_PPE_CACHE_CTL);
+	writel((1u<<8)|(1u<<9)|(1u<<10)|(1u<<12)|(1u<<13)|(1u<<17),
+	       base + EN75_PPE_FLOW_CFG);
+	writel((1000u << 16) | 3u, base + EN75_PPE_UNBIND_AGE);
+	writel((12u << 0) | (1u << 16), base + EN75_PPE_BIND_AGE0);
+	writel((7u << 0) | (1u << 16), base + EN75_PPE_BIND_AGE1);
+	writel(GENMASK(13, 0) | GENMASK(29, 16), base + EN75_PPE_BIND_LIMIT0);
+	writel(GENMASK(13, 0) | (1u << 16), base + EN75_PPE_BIND_LIMIT1);
+	writel((30u << 0) | (1u << 16), base + EN75_PPE_BIND_RATE);
+	writel(0, base + EN75_PPE_DEFAULT_CPU_PORT);
+	/* GLO_CFG.EN intentionally left unset in phase 1a (engine off). */
+
+	dev_info(eth->pub.dev,
+		 "XR500v PPE 1a: foe_phys=0x%08x TB_BASE_rb=0x%08x TB_CFG_w=0x%08x TB_CFG_rb=0x%08x GLO_CFG_rb=0x%08x TB_USED_rb=0x%08x\n",
+		 (u32)phys, readl(base + EN75_PPE_TB_BASE),
+		 tb_cfg, readl(base + EN75_PPE_TB_CFG),
+		 readl(base + EN75_PPE_GLO_CFG), readl(base + EN75_PPE_TB_USED));
+
+	if (en75_ppe_engine)
+		en75_ppe_engine_set(true);
+}
