+/* === XR500v PPE (HW NAT offload) phase 1a ===
+ * PPE config init + register-map verification via a TB_BASE readback. The
+ * engine is left DISABLED (GLO_CFG.EN=0) -> zero forwarding impact. Offsets
+ * and values are from mainline mtk_ppe (mt7622-class, FoE V1 80B, 16384
+ * entries). */
+#define EN75_PPE_GLO_CFG		0x200
+#define EN75_PPE_FLOW_CFG		0x204
+#define EN75_PPE_IP_PROTO_CHK		0x208
+#define EN75_PPE_TB_CFG			0x21c
+#define EN75_PPE_TB_BASE		0x220
+#define EN75_PPE_TB_USED		0x224
+#define EN75_PPE_BIND_RATE		0x228
+#define EN75_PPE_BIND_LIMIT0		0x22c
+#define EN75_PPE_BIND_LIMIT1		0x230
+#define EN75_PPE_UNBIND_AGE		0x238
+#define EN75_PPE_BIND_AGE0		0x23c
+#define EN75_PPE_BIND_AGE1		0x240
+#define EN75_PPE_DEFAULT_CPU_PORT	0x248
+#define EN75_PPE_CACHE_CTL		0x320
+#define EN75_PPE_NUM_ENTRIES		16384
+#define EN75_FOE_ENTRY_SIZE		80
+
+static void *en75_ppe_foe_virt;
+static dma_addr_t en75_ppe_foe_phys;
+
+/* === XR500v PPE phase 3 P1: enable the engine behind a default-off gate ===
+ * GLO_CFG.EN is already set at reset (0x60d); this writes the explicit
+ * mainline mtk_ppe_start value and gives a live toggle to A/B test without a
+ * reflash. GDM fwd_cfg stays = CPU, so the engine is starved (no blast radius). */
+#define EN75_PPE_GLO_CFG_EN	BIT(0)
+#define EN75_PPE_GLO_CFG_BUSY	BIT(31)
+/* EN | IP4_L4_CS_DROP | IP4_CS_DROP | FLOW_DROP_UPDATE (mtk_ppe.c mtk_ppe_start) */
+#define EN75_PPE_GLO_CFG_ON	(EN75_PPE_GLO_CFG_EN | BIT(2) | BIT(3) | BIT(9))
+
+static void __iomem *en75_ppe_base;	/* set in en75_ppe_init */
+struct en75_ppe *en75_the_ppe;	/* binding-phase PPE state (patch 356: non-static,
+				 * the RX/TX hook call-sites live in qdma/port) */
+
+/* patch 383: WHNAT TX probe target -- qdma[0] (GDM1/conduit/PPE QDMA, the same
+ * ring the OEM wifi_fast uses). Set in en75_probe once the QDMA is created. */
+struct en75_qdma *en75_whnat_probe_qdma;
+
+static int en75_ppe_engine_set(bool on)
+{
+	void __iomem *g;
+	u32 v;
+
+	if (!en75_ppe_base)
+		return -ENODEV;
+	g = en75_ppe_base + EN75_PPE_GLO_CFG;
+	if (on) {
+		if (readl_poll_timeout_atomic(g, v, !(v & EN75_PPE_GLO_CFG_BUSY),
+					      10, 10000))
+			return -EBUSY;
+		writel(EN75_PPE_GLO_CFG_ON, g);
+	} else {
+		writel(readl(g) & ~EN75_PPE_GLO_CFG_EN, g);
+	}
+	pr_info("XR500v PPE P1: engine %s, GLO_CFG=0x%08x\n",
+		on ? "ON" : "OFF", readl(g));
+	return 0;
+}
+
+static int en75_ppe_engine_param_set(const char *val,
+				     const struct kernel_param *kp)
+{
+	bool on;
+	int ret = kstrtobool(val, &on);
+
+	if (ret)
+		return ret;
+	*(bool *)kp->arg = on;
+	if (en75_ppe_base)	/* runtime toggle; at load time en75_ppe_init applies it */
+		return en75_ppe_engine_set(on);
+	return 0;
+}
+
+static const struct kernel_param_ops en75_ppe_engine_ops = {
+	.set = en75_ppe_engine_param_set,
+	.get = param_get_bool,
+};
+static bool en75_ppe_engine;
+/* echo 1 > /sys/module/econet_eth/parameters/ppe_engine (default off) */
+module_param_cb(ppe_engine, &en75_ppe_engine_ops, &en75_ppe_engine, 0644);
+
+static int en75_ppe_test_param_set(const char *val,
+				   const struct kernel_param *kp)
+{
+	if (!en75_the_ppe)
+		return -ENODEV;
+	en75_ppe_test_commit(en75_the_ppe);
+	return 0;
+}
+static const struct kernel_param_ops en75_ppe_test_ops = {
+	.set = en75_ppe_test_param_set,
+	.get = param_get_int,
+};
+static int en75_ppe_test;
+/* echo 1 > /sys/module/econet_eth/parameters/ppe_test -> commit 1 test FoE entry */
+module_param_cb(ppe_test, &en75_ppe_test_ops, &en75_ppe_test, 0644);
