+static void en75_ppe_diag_print_hist(const char *name, atomic_t *hist)
+{
+	int i, v, any = 0;
+
+	for (i = 0; i < EN75_PPE_DIAG_CRSN_BUCKETS; i++) {
+		v = atomic_read(&hist[i]);
+		if (!v)
+			continue;
+		any = 1;
+		pr_info("XR500v PPE diag %s[%02x]=%d\n", name, i, v);
+	}
+	if (!any)
+		pr_info("XR500v PPE diag %s: empty\n", name);
+}
