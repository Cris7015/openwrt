+
+bool en75_ppe_offload_enabled;	/* RX hook is inert until a test/offload arms it */
+bool en75_ppe_rxdump;		/* diagnostic: dump crsn/ppe_entry on RX */
+bool en75_ppe_fpdump;		/* build #75: one-shot dump of first sport>=8 bounced frame */
+bool en75_ppe_fpdump_bind;	/* build #77: one-shot dump of first crsn>=0x10 (HIT_BIND fam)
+				 * frame -- tells whether dp=0 delivers the REWRITTEN frame
+				 * to the CPU (half-offload viable) or the raw one. */
+bool en75_ppe_atomic;		/* build #41: one-shot atomic cache+DRAM dump from RX hook */
+bool en75_ppe_foedump;		/* diagnostic: dump the engine-built FoE entry */
+u32  en75_force_hash = 0xffffffff;  /* committest: if != ~0, commit at this slot (engine hash) */
+int  en75_t_vlan1 = -1;	/* build #71: >=0 -> author egress VTAG-style (plain VID via set_vlan,
+			 * etype=0, the OEM stag_to_vtag model seen in the real GPON bind
+			 * vlan1=8/etype=0) instead of the DSA dp-bitmap encoding (set_dsa). */
+int  en75_tx_dpbm_override = -1;	/* debug: >=0 overrides TX-bind parsed DSA dp_bm */
+bool en75_t_static = true;	/* build #72: committest STATIC bit. OEM real binds do NOT set
+				 * STATIC (ib1=0x21410316, bit31=0); set 0 to match the OEM. */
+bool en75_ppe_no_cache;	/* build #73: skip ALL cache ops in the bind/flip path. The
+			 * RA_HWNAT reference FoeBindToPpe writes the fields + state=BIND
+			 * to the coherent DRAM entry and RETURNS -- no cache flush, no
+			 * barrier, no engine poke. Our cache_clean_all may be forcing the
+			 * engine to re-FORWARD_BUILD (= "overwrites our bind"). Test that. */
+
+/* build #42 TX-hook (OEM FoeBindToPpe model): RX arms the slot, TX fills the
+ * COMPLETE entry from the egress packet and commits. See econet_ppe.h. */
+bool en75_ppe_tx_hook;		/* master enable */
+bool en75_tx_bind_arm;		/* set by RX hook, cleared by TX hook after commit */
+u32  en75_tx_match_dip;		/* network-order inner IPv4 dst that flags the test egress frame */
+bool en75_ppe_match_all;	/* patch 376 spike: bind EVERY forwarded NAT'd flow, ignore match_dip */
+bool en75_ppe_ft_active;	/* patch 379: flowtable on -> RX hook records ALL flows (tuple->engine slot) so the replace can commit at the engine LOOKUP slot, not the hash */
+u8   en75_ppe_tuple_swab;	/* build #44: 1 = store orig tuple swab32 (engine LOOKUP encoding) */
+bool en75_ppe_preserve_key = true;	/* build #48: keep the engine's UNBIND key, only add rewrite */
+bool en75_ppe_mirror_lookup;		/* build #56: also write BIND at the RX-descriptor lookup slot */
+bool en75_ppe_use_rxslot = true;	/* build #57: commit at the RX-recorded descriptor (lookup) slot */
+bool en75_ppe_port_mg0;			/* build #59: ib2 PORT_MG/AG=0 (vs OEM 0x3f) A/B */
+bool en75_ppe_cah_bind = true;		/* build #60: in-cache BIND (flip the CAH line) */
+bool en75_ppe_prebind = true;		/* build #61: OEM PREBIND handshake (preb=1, NOT state=BIND) */
+bool en75_ppe_oemregs;			/* build #61: OEM reg-config toggle (default OFF; PPE-block
+					 * GLO_CFG=0x763 has bit6 which HUNG the device in cont15 --
+					 * placeholder param, NOT wired this build; prebind is the lever) */
+
+/* build #57: per-flow RX->TX carry of the engine's LOOKUP slot (the RX-descriptor
+ * FOE_ENTRY_NUM). The RX hook records (pre-NAT tuple -> descriptor slot) for our
+ * test flow; the TX hook (post-NAT) looks it up by the NAT-invariant dst + dport
+ * and binds at THAT slot, where the engine actually looks up (foedump proved the
+ * tuple-scan write-slot is NOT the lookup slot). Ring is small + best-effort. */
+struct en75_rx_slot { u32 sip, dip; u16 sport, dport, slot; u8 valid; };
+static struct en75_rx_slot en75_rx_ring[32];
+static u8 en75_rx_ring_idx;
+
+void en75_ppe_rx_record(struct en75_ppe *ppe, struct sk_buff *skb, u16 hash)
+{
+	const u8 *d = skb->data, *iph, *l4;
+	unsigned int len = skb->len;
+	int eo = 0, po;
+	u8 ihl, proto, i;
+
+	/* patch 379: also run when the flowtable is active (ft_active) -- there the
+	 * commit is done by the TC_SETUP_FT replace, not the TX hook, but we still
+	 * need to record (tuple -> engine slot) here for it to look up. */
+	if ((!READ_ONCE(en75_ppe_tx_hook) && !READ_ONCE(en75_ppe_ft_active)) ||
+	    hash >= EN75_PPE_ENTRIES || len < 40)
+		return;
+	/* locate IPv4 past optional MTK special tag, VLAN, or PPPoE session header. */
+	if (get_unaligned_be16(d + 12) == ETH_P_IP)
+		eo = 14;
+	else if (get_unaligned_be16(d + 16) == ETH_P_IP)
+		eo = 18;					/* 4-byte special tag at d[12] */
+	else if (get_unaligned_be16(d + 12) == ETH_P_8021Q &&
+		 get_unaligned_be16(d + 16) == ETH_P_IP)
+		eo = 18;
+	else if (get_unaligned_be16(d + 16) == ETH_P_PPP_SES) {
+		po = 16;
+		if (len < po + 30 || get_unaligned_be16(d + po + 8) != 0x0021)
+			return;
+		eo = po + 10;
+	} else if (get_unaligned_be16(d + 12) == ETH_P_PPP_SES) {
+		po = 12;
+		if (len < po + 30 || get_unaligned_be16(d + po + 8) != 0x0021)
+			return;
+		eo = po + 10;
+	} else
+		return;
+	if (len < eo + 20)
+		return;
+	iph = d + eo;
+	if ((iph[0] >> 4) != 4)
+		return;
+	proto = iph[9];
+	if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+		return;
+	/* Upstream has DIP=target; return path has SIP=target before DNAT.
+	 * patch 376 spike: with match_all, record EVERY forwarded TCP/UDP flow
+	 * (the engine already reports a slot for all of them). */
+	if (!READ_ONCE(en75_ppe_match_all) && !READ_ONCE(en75_ppe_ft_active) &&
+	    get_unaligned_be32(iph + 16) != en75_tx_match_dip &&
+	    get_unaligned_be32(iph + 12) != en75_tx_match_dip)
+		return;
+	ihl = (iph[0] & 0x0f) * 4;
+	if (len < eo + ihl + 4)
+		return;
+	l4 = iph + ihl;
+	i = en75_rx_ring_idx++ & 31;
+	en75_rx_ring[i].sip   = get_unaligned_be32(iph + 12);
+	en75_rx_ring[i].dip   = get_unaligned_be32(iph + 16);
+	en75_rx_ring[i].sport = get_unaligned_be16(l4);
+	en75_rx_ring[i].dport = get_unaligned_be16(l4 + 2);
+	en75_rx_ring[i].slot  = hash;
+	en75_rx_ring[i].valid = 1;
+	ppe_trace_rl("XR500v RX-rec(#57) slot=%u eo=%d %08x:%u -> %08x:%u\n",
+		hash, eo, en75_rx_ring[i].sip, en75_rx_ring[i].sport,
+		en75_rx_ring[i].dip, en75_rx_ring[i].dport);
+}
+
+/* find the RX-record (ring index) for an egress flow, matched by the NAT-invariant
+ * dst+dport; prefer the entry whose sport matches (NAT preserved it). Returns the
+ * ring index (caller reads .slot/.sip/.sport) or -1. */
+static int en75_ppe_rxslot_lookup(u32 ndip, u32 nsip, u16 nsport, u16 ndport)
+{
+	int i, idx = -1;
+
+	for (i = 0; i < 32; i++) {
+		if (!en75_rx_ring[i].valid || en75_rx_ring[i].dip != ndip ||
+		    en75_rx_ring[i].dport != ndport)
+			continue;
+		/* patch 374: NEVER bind from a record of our own egress echo.
+		 * A re-ingressed post-NAT frame has sip == the NAT'd source and
+		 * is otherwise indistinguishable from the pre-NAT flow here
+		 * (dip, sport, dport are all NAT-invariant). Binding on it
+		 * creates a self-referential entry (orig == new, TTL-1, dp=1)
+		 * -> infinite forwarding loop (op100: same TCP segment x63
+		 * copies, TTL 63->0). */
+		if (en75_rx_ring[i].sip == nsip)
+			continue;
+		idx = i;
+		if (en75_rx_ring[i].sport == nsport)
+			break;				/* exact (sport preserved) */
+	}
+	return idx;
+}
+/* Return-direction lookup for WAN->LAN ACK/data. The original key is pre-DNAT
+ * (server -> WAN IP), while the TX egress frame is post-DNAT (server -> LAN
+ * client), so match by source + ports and reject our own post-DNAT egress echo. */
+static int en75_ppe_rxslot_lookup_return(u32 nsip, u32 ndip, u16 nsport, u16 ndport)
+{
+	int i, idx = -1;
+
+	for (i = 0; i < 32; i++) {
+		if (!en75_rx_ring[i].valid || en75_rx_ring[i].sip != nsip ||
+		    en75_rx_ring[i].sport != nsport)
+			continue;
+		if (en75_rx_ring[i].dip == ndip)
+			continue;			/* post-DNAT egress echo */
+		idx = i;
+		if (en75_rx_ring[i].dport == ndport)
+			break;				/* exact if NAT preserved port */
+	}
+	return idx;
+}
+/* patch 379: exact-tuple lookup for the TC_SETUP_FT replace. The RX hook records
+ * (pre-NAT tuple -> engine LOOKUP slot); the flowtable gives us that same pre-NAT
+ * 5-tuple (the orig match), so the replace commits at THAT slot -- build #57: the
+ * engine looks up there, NOT at en75_ppe_hash_entry(). Args in host order.
+ * Returns the engine slot, or -1 if the flow hasn't been seen on RX yet. */
+int en75_ppe_ft_lookup_slot(u32 sip, u32 dip, u16 sport, u16 dport)
+{
+	int i;
+
+	for (i = 0; i < 32; i++)
+		if (en75_rx_ring[i].valid &&
+		    en75_rx_ring[i].sip == sip && en75_rx_ring[i].dip == dip &&
+		    en75_rx_ring[i].sport == sport && en75_rx_ring[i].dport == dport)
+			return en75_rx_ring[i].slot;
+	return -1;
+}
+/* patch 380 (Hito 2c): multi-flow RX bind for the flowtable. The TC_SETUP_FT replace
+ * REGISTERS each flow's entry (real-IP tuple + NAT rewrite) in foe_flow[]; when the
+ * engine FORWARD_BUILDs that flow's slot and reports it on RX, commit the matching
+ * registered entry at the engine's slot (build #43/RANK-1: from-scratch slots are
+ * ignored; only a commit at the engine's reported slot binds). Picks the registered
+ * entry whose orig pre-NAT 5-tuple matches THIS RX frame. Caller holds ppe->lock. */
+void en75_ppe_ft_rx_bind(struct en75_ppe *ppe, struct sk_buff *skb, u16 hash)
+{
+	const u8 *d = skb->data, *iph, *l4;
+	unsigned int len = skb->len;
+	struct en75_flow_entry *e;
+	struct hlist_node *n;
+	u32 sip, dip;
+	u16 sport, dport;
+	int eo = 0, po, b;
+	u8 ihl;
+
+	if (get_unaligned_be16(d + 12) == ETH_P_IP)
+		eo = 14;
+	else if (get_unaligned_be16(d + 16) == ETH_P_IP)
+		eo = 18;
+	else if (get_unaligned_be16(d + 12) == ETH_P_8021Q &&
+		 get_unaligned_be16(d + 16) == ETH_P_IP)
+		eo = 18;
+	else if (get_unaligned_be16(d + 16) == ETH_P_PPP_SES) {
+		po = 16;
+		if (len < po + 30 || get_unaligned_be16(d + po + 8) != 0x0021)
+			return;
+		eo = po + 10;
+	} else if (get_unaligned_be16(d + 12) == ETH_P_PPP_SES) {
+		po = 12;
+		if (len < po + 30 || get_unaligned_be16(d + po + 8) != 0x0021)
+			return;
+		eo = po + 10;
+	} else
+		return;
+	if (len < eo + 20)
+		return;
+	iph = d + eo;
+	if ((iph[0] >> 4) != 4 || (iph[9] != IPPROTO_TCP && iph[9] != IPPROTO_UDP))
+		return;
+	ihl = (iph[0] & 0x0f) * 4;
+	if (len < eo + ihl + 4)
+		return;
+	l4 = iph + ihl;
+	sip = get_unaligned_be32(iph + 12);
+	dip = get_unaligned_be32(iph + 16);
+	sport = get_unaligned_be16(l4);
+	dport = get_unaligned_be16(l4 + 2);
+
+	for (b = 0; b < EN75_PPE_NUM_FLOWS; b++)
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[b], list) {
+			/* patch 380d: match by the host-order tuple stored at register time. */
+			if (e->ft_sip == sip && e->ft_dip == dip &&
+			    e->ft_sport == sport && e->ft_dport == dport) {
+				struct mtk_foe_entry *hwe = (struct mtk_foe_entry *)
+					((u8 *)ppe->foe_virt +
+					 (u32)hash * EN75_FOE_ENTRY_SIZE);
+				struct mtk_foe_entry fin = e->data;	/* the rewrite */
+
+				/* patch 380e PRESERVE_KEY (build #74, like en75_ppe_tx_bind): commit
+				 * the engine's EXACT orig key, NOT ours -- the engine LOOKUP only HITs
+				 * its own FORWARD_BUILD byte layout (op139..2d: our-order orig never
+				 * HIT -> re-build forever). Copy its RAW words + pre-swab32 so commit's
+				 * swab_all round-trips them byte-identical to the engine's own. */
+				fin.ipv4.orig = hwe->ipv4.orig;
+				if (READ_ONCE(en75_ppe_swab_all)) {
+					fin.ipv4.orig.src_ip  = swab32(fin.ipv4.orig.src_ip);
+					fin.ipv4.orig.dest_ip = swab32(fin.ipv4.orig.dest_ip);
+					fin.ipv4.orig.ports   = swab32(fin.ipv4.orig.ports);
+				}
+				e->hash = hash;
+				en75_foe_entry_commit(ppe, &fin, hash);
+				ppe_trace_rl("XR500v FT(380) RX-bind slot=%u %08x:%u->%08x:%u (preserve-key)\n",
+						    hash, sip, sport, dip, dport);
+				return;
+			}
+		}
+}
+/* patch 380: FLOW_CLS_DESTROY -- unregister + free the entry with this cookie. */
+void en75_ppe_ft_unregister_cookie(struct en75_ppe *ppe, unsigned long cookie)
+{
+	struct en75_flow_entry *e, *found = NULL;
+	struct hlist_node *n;
+	int b;
+
+	spin_lock_bh(&ppe->lock);
+	for (b = 0; b < EN75_PPE_NUM_FLOWS && !found; b++)
+		hlist_for_each_entry_safe(e, n, &ppe->foe_flow[b], list)
+			if (e->cookie == cookie) {
+				found = e;
+				break;
+			}
+	spin_unlock_bh(&ppe->lock);
+	if (found) {
+		en75_foe_entry_unregister(ppe, found);
+		kfree(found);
+	}
+}
+static u16 en75_tx_bind_slot;	/* the engine-reported FoE slot to bind (from RX) */
