+module_param_named(ppe_t_hash, en75_force_hash, uint, 0644);
+module_param_named(ppe_t_vlan1, en75_t_vlan1, int, 0644);
+module_param_named(ppe_t_dpbm, en75_tx_dpbm_override, int, 0644);
