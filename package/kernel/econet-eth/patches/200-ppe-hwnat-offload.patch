+void en75_ppe_diag_reset(void)
+{
+	int i;
+
+	atomic_set(&en75_ppe_diag.pre_total, 0);
+	atomic_set(&en75_ppe_diag.post_total, 0);
+	atomic_set(&en75_ppe_diag.rate_limited, 0);
+	atomic_set(&en75_ppe_diag.invalid_hash, 0);
+	atomic_set(&en75_ppe_diag.gate_pass, 0);
+	atomic_set(&en75_ppe_diag.gate_skip, 0);
+	atomic_set(&en75_ppe_diag.prebind_promote, 0);
+	atomic_set(&en75_ppe_diag.prebind_arm, 0);
+	atomic_set(&en75_ppe_diag.flip, 0);
+	atomic_set(&en75_ppe_diag.rx_commit, 0);
+	atomic_set(&en75_ppe_diag.nobind, 0);
+	atomic_set(&en75_ppe_diag.tx_arm, 0);
+	atomic_set(&en75_ppe_diag.first_slot, -1);
+	atomic_set(&en75_ppe_diag.last_slot, -1);
+	atomic_set(&en75_ppe_diag.slot_changes, 0);
+	for (i = 0; i < EN75_PPE_DIAG_CRSN_BUCKETS; i++) {
+		atomic_set(&en75_ppe_diag.pre_hist[i], 0);
+		atomic_set(&en75_ppe_diag.post_hist[i], 0);
+		atomic_set(&en75_ppe_diag.limited_hist[i], 0);
+		atomic_set(&en75_ppe_diag.gate_skip_hist[i], 0);
