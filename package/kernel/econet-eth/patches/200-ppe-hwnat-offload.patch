+static unsigned int ppe_t_proto = 6;
+static unsigned int ppe_t_sip, ppe_t_dip, ppe_t_sport, ppe_t_dport;
+static unsigned int ppe_t_smac_hi, ppe_t_smac_lo, ppe_t_dmac_hi, ppe_t_dmac_lo;
+static int ppe_t_dsaport = -1;
+static unsigned int ppe_t_pt;
+module_param(ppe_t_proto, uint, 0644);
+module_param(ppe_t_sip, uint, 0644);
+module_param(ppe_t_dip, uint, 0644);
+module_param(ppe_t_sport, uint, 0644);
+module_param(ppe_t_dport, uint, 0644);
