+ * DSA reenvia TC_SETUP_FT de los user-ports (lanX/wan) a ESTE conduit
+ * (dsa_user_setup_ft_block -> conduit->ndo_setup_tc). 'replace' (patch 378)
+ * traduce la flow_rule que ofrece conntrack a una FoE entry y la committea
+ * (dp=1, GSW switch egress; el MT7530 externo rutea por la dst MAC via ARL --
+ * el modelo del spike match_all). Portado de mainline mtk_ppe_offload.c. */
+
+/* patch 378/380 (Hito 2/2c): the replace builds the FoE entry from the flow_rule and
+ * REGISTERS it in the PPE foe_flow[] table (keyed by tuple for the RX bind, carrying
+ * the tc cookie for FLOW_CLS_DESTROY); en75_ppe_ft_rx_bind() commits it at the engine
+ * slot. */
+
+/* mangle helpers portados de mtk_ppe_offload.c. El de ETH lo adaptamos a
+ * big-endian: act->mangle.val guarda los bytes en orden de memoria, y los
+ * half-word mangles codifican la mitad via el mask. mainline (LE) hace
+ * src/dest += 2 cuando mask==0x0000ffff; en MIPS BE las mitades del u32 estan
+ * al reves (verificado en HW: dmac/smac salian con la mitad en 00:00). */
+static void en75_ft_mangle_eth(const struct flow_action_entry *act, void *eth)
+{
+	const u8 *val = (const u8 *)&act->mangle.val;
+	u8 *dest = (u8 *)eth + act->mangle.offset;
+
+	if (act->mangle.offset > 8)
+		return;
+	if (act->mangle.mask == 0)			/* full word */
+		memcpy(dest, val, 4);
+	else if (act->mangle.mask == 0xffff0000)	/* high half -> val[2:4] */
+		memcpy(dest, val + 2, 2);
+	else if (act->mangle.mask == 0x0000ffff)	/* low half -> dest[2:4] */
+		memcpy(dest + 2, val, 2);
+	else
+		pr_warn_ratelimited("XR500v FT: unexpected eth mangle mask=%08x\n",
+				    act->mangle.mask);
+}
+
+static void en75_ft_mangle_ports(const struct flow_action_entry *act,
+				 __be16 *sport, __be16 *dport)
+{
+	u32 val = ntohl(act->mangle.val);
+
+	switch (act->mangle.offset) {
+	case 0:
+		if (act->mangle.mask == ~htonl(0xffff))
+			*dport = cpu_to_be16(val);
+		else
+			*sport = cpu_to_be16(val >> 16);
+		break;
+	case 2:
+		*dport = cpu_to_be16(val);
+		break;
+	}
+}
+
+static void en75_ft_mangle_ipv4(const struct flow_action_entry *act,
+				__be32 *sip, __be32 *dip)
+{
+	switch (act->mangle.offset) {
+	case 12:		/* offsetof(struct iphdr, saddr) */
+		memcpy(sip, &act->mangle.val, 4);
+		break;
+	case 16:		/* offsetof(struct iphdr, daddr) */
+		memcpy(dip, &act->mangle.val, 4);
+		break;
+	}
+}
+
+static int en75_flow_offload_replace(struct flow_cls_offload *f)
+{
+	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
+	struct flow_match_basic mb;
+	struct flow_match_ipv4_addrs ma;
+	struct flow_match_ports mp;
+	struct flow_action_entry *act;
+	struct mtk_foe_entry e;
+	struct ethhdr eth = {};
+	__be32 o_sip, o_dip, n_sip, n_dip;
+	__be16 o_sport, o_dport, n_sport, n_dport;
+	u8 l4proto;
+	int sid = 0, i, wifi_idx;
+	struct en75_flow_entry *fe;
+	struct net_device *odev = NULL;	/* fport-p3p4: egress netdev from REDIRECT */
+
+	if (!en75_the_ppe)
+		return -ENODEV;
+	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
+	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS))
+		return -EOPNOTSUPP;		/* only IPv4 HNAPT for now */
+
+	flow_rule_match_basic(rule, &mb);
+	l4proto = mb.key->ip_proto;
+	if (l4proto != IPPROTO_TCP && l4proto != IPPROTO_UDP)
+		return -EOPNOTSUPP;
+
+	flow_rule_match_ipv4_addrs(rule, &ma);
+	flow_rule_match_ports(rule, &mp);
+	o_sip = ma.key->src; o_dip = ma.key->dst;
+	o_sport = mp.key->src; o_dport = mp.key->dst;
+	/* new (post-NAT) starts == orig; the MANGLE actions rewrite it */
+	n_sip = o_sip; n_dip = o_dip; n_sport = o_sport; n_dport = o_dport;
+
+	flow_action_for_each(i, act, &rule->action) {
+		switch (act->id) {
+		case FLOW_ACTION_MANGLE:
+			switch (act->mangle.htype) {
+			case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
+				en75_ft_mangle_eth(act, &eth);
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
+				en75_ft_mangle_ipv4(act, &n_sip, &n_dip);
+				break;
+			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
+			case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
+				en75_ft_mangle_ports(act, &n_sport, &n_dport);
+				break;
+			default:
+				break;
+			}
+			break;
+		case FLOW_ACTION_PPPOE_PUSH:
+			sid = act->pppoe.sid;
+			break;
+		case FLOW_ACTION_REDIRECT:
+		case FLOW_ACTION_MIRRED:
+			odev = act->dev;	/* fport-p3p4: the egress netdev */
+			break;
+		default:
+			break;
+		}
+	}
+
+	if (!is_valid_ether_addr(eth.h_dest) || !is_valid_ether_addr(eth.h_source))
+		return -EOPNOTSUPP;		/* need the next-hop MACs from MANGLE */
+
+	/* Build the FoE entry. orig = pre-NAT 5-tuple (the match), new = post-NAT
+	 * (the rewrite). Ethernet egress: dp=1 (GSW switch routes by the next-hop
+	 * dst MAC via its ARL -- match_all spike, cont29). WiFi egress (F2: smac ==
+	 * a registered mt76 AP vif): HALF-OFFLOAD -- force-to-CPU (dp=fcpu) so the
+	 * engine does the NAT then bounces the frame to the CPU, where the F3 demux
+	 * dev_queue_xmit's it to the mt76 vif (the OEM WHNAT model, cont32r/s).
+	 * PPPoE sid from FLOW_ACTION_PPPOE_PUSH (WiFi downstream has none). */
+	wifi_idx = en75_whnat_idx_by_mac(eth.h_source);
+	en75_foe_entry_prepare(&e, MTK_PPE_PKT_TYPE_IPV4_HNAPT, l4proto,
+			       wifi_idx >= 0 ? READ_ONCE(en75_ppe_fcpu_dp) : 1,
+			       eth.h_source, eth.h_dest);
+	en75_foe_entry_set_ipv4_tuple(&e, false, o_sip, o_sport, o_dip, o_dport);
+	en75_foe_entry_set_ipv4_tuple(&e, true, n_sip, n_sport, n_dip, n_dport);
+	/* fix fport-p3p4: encode the physical egress DSA port BEFORE pppoe (as the old
+	 * tx_bind + the gsw/tag-mtk.c tagger do). The FT path never did this, so all 4
+	 * LAN entries came out with l2.etype=ETH_P_IP(0x0800) and the cascaded MT7530
+	 * fell back to ARL-by-MAC: only p2 (lan3, next to the conduit) resolved, p1/p3/p4
+	 * (lan4/lan2/lan1) blackholed. l2.etype = BIT(dp->index) [| BIT(7) passthrough on
+	 * the MCM switch]. Restores the 06-16 935M behaviour the flowtable path dropped. */
+	if (wifi_idx < 0 && odev && dsa_user_dev_check(odev)) {
+		struct dsa_port *dp = dsa_port_from_netdev(odev);
+
+		if (!IS_ERR(dp))
+			en75_foe_entry_set_dsa(&e, dp->index, dp->ds->index != 0);
+	}
+	if (sid)
+		en75_foe_entry_set_pppoe(&e, sid);
+	if (wifi_idx >= 0) {
+		/* magic VLAN the engine rides on the force-to-CPU frame: TCI = vif
+		 * index (0..15), etype 0x5678 (OEM QDMA-to-CPU tag). The F3 demux in
+		 * econet_qdma.c reads the TCI to pick the destination BSS netdev.
+		 * (The OEM force-to-CPU put vlan1=slot here; we put the vif idx so the
+		 * RX side recovers the BSS directly -- econet_ppe.c:2146 model.) */
+		e.ipv4.l2.vlan1 = wifi_idx;
+		e.ipv4.l2.etype = htons(0x5678);
+		e.ib1 &= ~MTK_FOE_IB1_BIND_VLAN_LAYER;
+		e.ib1 |= MTK_FOE_IB1_BIND_VLAN_TAG |
+			 FIELD_PREP(MTK_FOE_IB1_BIND_VLAN_LAYER, 1);
+		if (READ_ONCE(en75_ppe_fcpu_fqos))
+			e.ipv4.ib2 |= MTK_FOE_IB2_PSE_QOS;
+	}
+	/* build #72: the engine FORWARD_BUILDs its UNBIND key in swab32 order; match it
+	 * so the engine's LOOKUP of the real frame HITs our entry (we commit the real
+	 * tuple with no preserve_key, so we pre-swab like en75_build_test_flow does --
+	 * without this the entry never HITs and re-commits forever -> traffic degrades). */
+	if (READ_ONCE(en75_ppe_tuple_swab)) {
+		e.ipv4.orig.src_ip  = swab32(e.ipv4.orig.src_ip);
+		e.ipv4.orig.dest_ip = swab32(e.ipv4.orig.dest_ip);
+		e.ipv4.orig.ports   = swab32(e.ipv4.orig.ports);
+	}
+	/* patch 380 (Hito 2c): REGISTER the entry (real-IP tuple + NAT rewrite), do NOT
+	 * commit from-scratch. The engine FORWARD_BUILDs this flow's slot and reports it
+	 * on RX, where en75_ppe_ft_rx_bind() commits THIS registered entry at the engine's
+	 * slot (build #43 flip-in-place: a from-scratch commit at a foreign slot is
+	 * ignored -- op139/2b proved it). offload_enabled gates the RX path (check_skb). */
+	fe = kzalloc(sizeof(*fe), GFP_ATOMIC);
+	if (!fe)
+		return -ENOMEM;
+	fe->data = e;		/* orig may be swab32 (tuple_swab) for the engine HIT */
+	fe->cookie = f->cookie;
+	fe->wifi_vif_idx = wifi_idx;	/* F2: >=0 if egress is an mt76 AP vif */
+	fe->ft_sip = ntohl(o_sip);	/* host-order match tuple for en75_ppe_ft_rx_bind */
+	fe->ft_dip = ntohl(o_dip);
+	fe->ft_sport = ntohs(o_sport);
+	fe->ft_dport = ntohs(o_dport);
+	en75_foe_entry_register(en75_the_ppe, fe);
+	WRITE_ONCE(en75_ppe_offload_enabled, true);
+
+	ppe_trace_rl("XR500v FT(380) REGISTER ck=%lx sid=%d wifi=%d etype=%04x odev=%s nact=%d %pI4:%u->%pI4:%u => %pI4:%u->%pI4:%u dmac=%pM smac=%pM\n",
+		f->cookie, sid, wifi_idx, ntohs(e.ipv4.l2.etype), odev ? odev->name : "NULL", i,
+		&o_sip, ntohs(o_sport), &o_dip, ntohs(o_dport),
+		&n_sip, ntohs(n_sport), &n_dip, ntohs(n_dport),
+		eth.h_dest, eth.h_source);
+	return 0;
+}
+
+static int en75_flow_offload_destroy(struct flow_cls_offload *f)
+{
+	if (en75_the_ppe)
+		en75_ppe_ft_unregister_cookie(en75_the_ppe, f->cookie);
+	return 0;
+}
+
+static int en75_flow_offload_stats(struct flow_cls_offload *f)
+{
+	/* keep-alive: report recent use so conntrack doesn't expire the offloaded
+	 * flow while it stays bound. (Hito 3 will read real per-entry counters.) */
+	flow_stats_update(&f->stats, 0, 0, 0, jiffies, FLOW_ACTION_HW_STATS_DELAYED);
+	return 0;
+}
+
+static int en75_ft_cmd(struct flow_cls_offload *cls)
+{
+	switch (cls->command) {
+	case FLOW_CLS_REPLACE:
+		return en75_flow_offload_replace(cls);
+	case FLOW_CLS_DESTROY:
+		return en75_flow_offload_destroy(cls);
+	case FLOW_CLS_STATS:
+		return en75_flow_offload_stats(cls);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int en75_setup_tc_block_cb(enum tc_setup_type type, void *type_data,
+				  void *cb_priv)
+{
+	struct net_device *dev = cb_priv;
+
+	if (!tc_can_offload(dev))
+		return -EOPNOTSUPP;
+	if (type != TC_SETUP_CLSFLOWER)
+		return -EOPNOTSUPP;
+	return en75_ft_cmd(type_data);
+}
+
+static LIST_HEAD(en75_ft_block_cb_list);
+
+static int en75_setup_tc_block(struct net_device *dev,
+			       struct flow_block_offload *f)
+{
+	struct flow_block_cb *block_cb;
+	flow_setup_cb_t *cb = en75_setup_tc_block_cb;
+
+	if (f->binder_type != FLOW_BLOCK_BINDER_TYPE_CLSACT_INGRESS)
+		return -EOPNOTSUPP;
+
+	f->driver_block_list = &en75_ft_block_cb_list;
+	switch (f->command) {
+	case FLOW_BLOCK_BIND:
+		WRITE_ONCE(en75_ppe_ft_active, true);	/* patch 379: RX records all flows */
+		en75_ppe_engine_arm(en75_the_ppe);	/* patch 381: productized engine-arm (was op139) */
+		block_cb = flow_block_cb_lookup(f->block, cb, dev);
+		if (block_cb) {
+			flow_block_cb_incref(block_cb);
+			return 0;
+		}
+		block_cb = flow_block_cb_alloc(cb, dev, dev, NULL);
+		if (IS_ERR(block_cb))
+			return PTR_ERR(block_cb);
+		flow_block_cb_incref(block_cb);
+		flow_block_cb_add(block_cb, f);
+		list_add_tail(&block_cb->driver_list, &en75_ft_block_cb_list);
+		return 0;
+	case FLOW_BLOCK_UNBIND:
+		block_cb = flow_block_cb_lookup(f->block, cb, dev);
+		if (!block_cb)
+			return -ENOENT;
+		if (!flow_block_cb_decref(block_cb)) {
+			flow_block_cb_remove(block_cb, f);
+			list_del(&block_cb->driver_list);
+		}
+		/* fix (2026-06-14): keep ft_active true while ANY flowtable block
+		 * is still bound. A single device's UNBIND (e.g. a WiFi AP flapping
+		 * at boot) must NOT clear this global flag while the LAN ports are
+		 * still offloading -- else RX drops to the NObind path + HW-NAT dies. */
+		WRITE_ONCE(en75_ppe_ft_active, !list_empty(&en75_ft_block_cb_list));
+		/* fix (2026-06-21): when the LAST flowtable block goes away (toggle
+		 * offload to none/sw + firewall reload), tear the engine DOWN to mirror
+		 * the BIND-time arm. Without this the engine stays armed + GDM1 keeps
+		 * steering all ingress into a PPE with stale FoE -> black hole that
+		 * persists until reboot (the armed latch even kills the corrective re-arm). */
+		if (list_empty(&en75_ft_block_cb_list))
+			en75_ppe_engine_disarm(en75_the_ppe);
+		return 0;
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
+static int en75_setup_tc(struct net_device *dev, enum tc_setup_type type,
+			 void *type_data)
+{
+	switch (type) {
+	case TC_SETUP_BLOCK:
+	case TC_SETUP_FT:
+		return en75_setup_tc_block(dev, type_data);
+	default:
+		return -EOPNOTSUPP;
+	}
+}
+
 static const struct net_device_ops en75_netdev_ops = {
 	.ndo_init		= en75_dev_init,
 	.ndo_open		= en75_dev_open,
@@ -400,6 +782,7 @@ static const struct net_device_ops en75_netdev_ops = {
 	.ndo_start_xmit		= en75_dev_xmit,
 	.ndo_get_stats64        = en75_dev_get_stats64,
 	.ndo_set_mac_address	= en75_dev_set_macaddr,
+	.ndo_setup_tc		= en75_setup_tc,	/* patch 377: flow-table offload */
 };
 
 static const struct ethtool_ops en75_ethtool_ops = {
@@ -446,7 +829,9 @@ struct net_device *en75_alloc_gdm_port(struct en75_eth *eth,
 	 *   - TODO: When we get the PPE working, we will enable this for
