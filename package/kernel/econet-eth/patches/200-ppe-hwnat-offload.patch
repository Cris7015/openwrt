+module_param_named(ppe_tx_hook, en75_ppe_tx_hook, bool, 0644);
+module_param_named(ppe_t_match_dip, en75_tx_match_dip, uint, 0644);
+/* patch 376 spike: ppe_match_all=1 -> generalize the offload to EVERY forwarded
+ * TCP/UDP NAT'd flow (ignore ppe_t_match_dip). Direction is implied by the egress
+ * encap: PPPoE = LAN->WAN (up), plain IPv4 = WAN->LAN return (ret). The engine
+ * already auto-learns a slot for all flows; the RX/TX correlation + 374/375
+ * guards stay active. Default 0 keeps the single-flow test behavior. */
+module_param_named(ppe_match_all, en75_ppe_match_all, bool, 0644);
+/* build #43 FLIP-IN-PLACE: ppe_flip=1 -> RX hook patches the engine-built entry
+ * (dest_port=ppe_flip_dp + state=BIND, keep engine tuple) instead of from-scratch.
