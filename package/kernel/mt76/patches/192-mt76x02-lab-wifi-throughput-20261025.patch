From: Cristian Papa <pcristian292@gmail.com>
Subject: [PATCH] mt76: XR500v WiFi lab of 25-oct (TX status, completions, RX)

Lab state of the 25-oct WiFi work, which the wifiagents image carried
only as build_dir edits (lost when 190/191 made the package re-prepare).
Most of it is behind parameters (the deferred TX status queue added
unconditionally stays empty unless txs_defer_batch is set); the lab
profile is turned on by /etc/modules.conf on the router:

mt76x02-lib: rx_buf_size (4096: one A-MSDU of 2x1500 per buffer, so the
WHNAT zero copy takes every subframe), tx_status_interval, tx_delay_int
(completions from TXDELAYINT), tx_stat_irq, txs_complete_poll (poll the
status FIFO one frame in N), tx_wb_ddone (TX DMA_DONE writeback).
mt76: txs_defer_batch (TX status deferred out of rx_lock), rx_batch,
tx_ddone. Also the agents' A01-07 and B05/06/09 (fewer uncached reads,
RX batching, small A-MSDU linearised) and diagnostic counters.

Measured on 25-oct (Samsung SM-A566E, Ookla Movistar Mendoza): 494-513
down / 440 up, against ~400/330 without.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
---
diff -ruN a/dma.c b/dma.c
--- a/dma.c
+++ b/dma.c
@@ -216,6 +216,7 @@
 
 	q->head = mt76_dma_read_dma_idx(q, 0);
 	q->tail = q->head;
+	q->kicked = q->head;
 }
 
 void mt76_dma_queue_reset(struct mt76_dev *dev, struct mt76_queue *q,
@@ -417,35 +418,160 @@
 		*q->emi_cpu_idx = cpu_to_le16(q->head);
 	else
 		Q_WRITE(q, cpu_idx, q->head);
+	/* After the barrier: see mt76_dma_tx_ddone_last() */
+	WRITE_ONCE(q->kicked, q->head);
+}
+
+static unsigned int txc_reread, txc_reread_more;
+module_param(txc_reread, uint, 0444);
+module_param(txc_reread_more, uint, 0444);
+
+static int tx_max_reread = -1;
+module_param(tx_max_reread, int, 0644);
+MODULE_PARM_DESC(tx_max_reread,
+		 "TX cleanup: read the DMA index again at most N times per sweep once it is reached, -1 no limit (lab)");
+
+static bool tx_ddone;
+module_param(tx_ddone, bool, 0644);
+MODULE_PARM_DESC(tx_ddone,
+		 "TX cleanup: take completions from the DMA_DONE bit the DMA writes back into TX descriptors, if the driver enables that, and read the DMA index only when none is set (lab)");
+
+/* lab: descriptors completed from DMA_DONE; DMA index reads in that mode, and
+ * those that found completions DMA_DONE had not shown (yet).
+ */
+static unsigned int txc_ddone, txc_verify, txc_verify_more;
+module_param(txc_ddone, uint, 0444);
+module_param(txc_verify, uint, 0444);
+module_param(txc_verify_more, uint, 0444);
+
+/*
+ * lab safety check: on one sweep in N that DMA_DONE served, read the index
+ * after the scan and count the sweeps where DMA_DONE claimed descriptors the
+ * index had not passed yet. Anything but 0 means DMA_DONE is written before
+ * the DMA is done with the buffers: do not use tx_ddone then.
+ */
+static unsigned int tx_ddone_check = 64;
+module_param(tx_ddone_check, uint, 0644);
+static unsigned int txc_ddone_sweeps, txc_ddone_ahead;
+module_param(txc_ddone_ahead, uint, 0444);
+
+/*
+ * First descriptor from @tail on that the DMA has not marked done. Only
+ * descriptors before the last kick are looked at: they were complete (and
+ * their old DMA_DONE overwritten) before q->kicked moved past them, while the
+ * enqueue path on the other CPU may still be writing the ones after it. The
+ * descriptors are coherent (uncached) memory: a DRAM read each, not PCIe.
+ */
+static int
+mt76_dma_tx_ddone_last(struct mt76_queue *q, int tail, int max)
+{
+	int kicked = READ_ONCE(q->kicked);
+	int n = 0;
+
+	smp_rmb();
+	while (n < max && tail != kicked &&
+	       (READ_ONCE(q->desc[tail].ctrl) &
+		cpu_to_le32(MT_DMA_CTL_DMA_DONE))) {
+		tail = (tail + 1) % q->ndesc;
+		n++;
+	}
+	txc_ddone += n;
+
+	return tail;
 }
 
 static void
 mt76_dma_tx_cleanup(struct mt76_dev *dev, struct mt76_queue *q, bool flush)
 {
 	struct mt76_queue_entry entry;
-	int last;
+	int last, tail, done = 0, rereads = 0;
+	int max_reread = READ_ONCE(tx_max_reread);
+	bool ddone;
 
 	if (!q || !q->ndesc)
 		return;
 
+	/*
+	 * The TX interrupt sweeps every queue, mostly idle ones. Reading their
+	 * DMA index is an uncached MMIO access each time: skip it when there
+	 * is nothing to clean.
+	 */
+	if (!flush && !READ_ONCE(q->queued))
+		return;
+
+	ddone = !flush && READ_ONCE(tx_ddone) &&
+		(q->flags & MT_QFLAG_TX_DDONE) && q->desc &&
+		!mt76_queue_is_emi(q) && !mt76_queue_is_npu(q);
+
 	spin_lock_bh(&q->cleanup_lock);
-	if (flush)
+	tail = q->tail;
+	if (flush) {
 		last = -1;
-	else
+	} else if (ddone) {
+		last = mt76_dma_tx_ddone_last(q, tail, q->queued);
+		/*
+		 * Nothing marked: the write-back may be off, or not visible
+		 * yet. One read of the index then, as without DMA_DONE.
+		 */
+		if (last == tail) {
+			last = mt76_dma_read_dma_idx(q, -1);
+			txc_verify++;
+			txc_verify_more += last != tail;
+		} else if (READ_ONCE(tx_ddone_check) &&
+			   !(++txc_ddone_sweeps % READ_ONCE(tx_ddone_check))) {
+			int idx = mt76_dma_read_dma_idx(q, -1);
+
+			if (idx >= 0 &&
+			    (last - tail + q->ndesc) % q->ndesc >
+			    (idx - tail + q->ndesc) % q->ndesc)
+				txc_ddone_ahead++;
+		}
+	} else {
 		last = mt76_dma_read_dma_idx(q, -1);
+	}
 
-	while (q->queued > 0 && q->tail != last) {
-		mt76_dma_tx_cleanup_idx(dev, q, q->tail, &entry);
-		mt76_npu_txdesc_cleanup(q, q->tail);
-		mt76_queue_tx_complete(dev, q, &entry);
+	/*
+	 * Only this function moves the tail, under cleanup_lock. Advance it
+	 * once per sweep instead of taking q->lock, which the enqueue path
+	 * holds on the other CPU, for every completed frame.
+	 */
+	while (q->queued > done && tail != last) {
+		mt76_dma_tx_cleanup_idx(dev, q, tail, &entry);
+		mt76_npu_txdesc_cleanup(q, tail);
+		if (entry.skb)
+			dev->drv->tx_complete_skb(dev, &entry);
 
 		if (entry.txwi) {
 			if (!(dev->drv->drv_flags & MT_DRV_TXWI_NO_FREE))
 				mt76_put_txwi(dev, entry.txwi);
 		}
 
-		if (!flush && q->tail == last)
+		tail = (tail + 1) % q->ndesc;
+		done++;
+		if (flush || tail != last)
+			continue;
+
+		/*
+		 * Reached the bound: look again for frames completed while
+		 * these were processed. A DMA_DONE scan costs DRAM reads; a
+		 * new read of the index costs a PCIe read and, with the TX
+		 * delay interrupt, finds a few frames that the next interrupt
+		 * would bring anyway.
+		 */
+		if (ddone) {
+			last = mt76_dma_tx_ddone_last(q, tail, q->queued - done);
+		} else if (max_reread < 0 || rereads < max_reread) {
+			rereads++;
 			last = mt76_dma_read_dma_idx(q, -1);
+			txc_reread++;
+			txc_reread_more += last != tail && q->queued > done;
+		}
+	}
+	if (done) {
+		spin_lock_bh(&q->lock);
+		q->tail = tail;
+		q->queued -= done;
+		spin_unlock_bh(&q->lock);
 	}
 	spin_unlock_bh(&q->cleanup_lock);
 
@@ -456,7 +582,7 @@
 		spin_unlock_bh(&q->lock);
 	}
 
-	if (!q->queued)
+	if (!q->queued && wq_has_sleeper(&dev->tx_wait))
 		wake_up(&dev->tx_wait);
 }
 
@@ -505,7 +631,8 @@
 
 static void *
 mt76_dma_get_buf(struct mt76_dev *dev, struct mt76_queue *q, int idx,
-		 int *len, u32 *info, bool *more, bool *drop, bool flush)
+		 int *len, u32 *info, bool *more, bool *drop, bool flush,
+		 const u32 *ctrl_read)
 {
 	struct mt76_queue_entry *e = &q->entry[idx];
 	struct mt76_desc *desc = &q->desc[idx];
@@ -518,17 +645,32 @@
 	if (mt76_queue_is_wed_rro(q))
 		goto done;
 
-	ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
+	/* The ring is uncached memory: reuse the ctrl word dequeue read. */
+	ctrl = ctrl_read ? *ctrl_read : le32_to_cpu(READ_ONCE(desc->ctrl));
 	if (len) {
 		*len = FIELD_GET(MT_DMA_CTL_SD_LEN0, ctrl);
 		*more = !(ctrl & MT_DMA_CTL_LAST_SEC0);
 	}
 
-	desc_info = le32_to_cpu(desc->info);
+	/*
+	 * info and buf1 only carry WED/RRO data (descriptor version >= 1).
+	 * Drivers whose rx_skb() ignores info can skip two more uncached
+	 * reads per buffer on their data queues. Not on the MCU queue:
+	 * mt76x02 matches MCU responses by the sequence number that info
+	 * carries (skb->cb, mt76x02_mcu_parse_response()).
+	 */
+	if ((dev->drv->drv_flags & MT_DRV_RX_NO_DMA_INFO) &&
+	    q != &dev->q_rx[MT_RXQ_MCU] &&
+	    !mt76_queue_is_wed_rx(q) && !(ctrl & MT_DMA_CTL_VER_MASK)) {
+		desc_info = 0;
+		buf1 = 0;
+	} else {
+		desc_info = le32_to_cpu(desc->info);
+		buf1 = le32_to_cpu(desc->buf1);
+	}
 	if (info)
 		*info = desc_info;
 
-	buf1 = le32_to_cpu(desc->buf1);
 	mt76_dma_should_drop_buf(drop, ctrl, buf1, desc_info);
 
 	if (mt76_queue_is_wed_rx(q)) {
@@ -569,7 +711,9 @@
 mt76_dma_dequeue(struct mt76_dev *dev, struct mt76_queue *q, bool flush,
 		 int *len, u32 *info, bool *more, bool *drop)
 {
+	const u32 *ctrl_read = NULL;
 	int idx = q->tail;
+	u32 ctrl;
 
 	*more = false;
 	if (!q->queued)
@@ -608,26 +752,31 @@
 
 		if (q->tail == q->ndesc - 1)
 			q->magic_cnt = (q->magic_cnt + 1) % MT_DMA_MAGIC_CNT;
+	} else if (flush) {
+		q->desc[idx].ctrl |= cpu_to_le32(MT_DMA_CTL_DMA_DONE);
 	} else {
-		if (flush)
-			q->desc[idx].ctrl |= cpu_to_le32(MT_DMA_CTL_DMA_DONE);
-		else if (!(q->desc[idx].ctrl & cpu_to_le32(MT_DMA_CTL_DMA_DONE)))
+		__le32 c = READ_ONCE(q->desc[idx].ctrl);
+
+		if (!(c & cpu_to_le32(MT_DMA_CTL_DMA_DONE)))
 			return NULL;
 #ifdef CONFIG_NET_MEDIATEK_SOC_WED
 		/* on WED v3 the M_DONE bit signals that WED is done reading
 		 * the txfree descriptor; WED v2 does not set it
 		 */
-		else if (dev->mmio.wed.version > 2 &&
-			 mt76_queue_is_wed_tx_free(q) &&
-			 !(q->desc[idx].ctrl & cpu_to_le32(MT_DMA_CTL_M_DONE)))
+		if (dev->mmio.wed.version > 2 &&
+		    mt76_queue_is_wed_tx_free(q) &&
+		    !(c & cpu_to_le32(MT_DMA_CTL_M_DONE)))
 			return NULL;
 #endif
+		ctrl = le32_to_cpu(c);
+		ctrl_read = &ctrl;
 	}
 done:
 	q->tail = (q->tail + 1) % q->ndesc;
 	q->queued--;
 
-	return mt76_dma_get_buf(dev, q, idx, len, info, more, drop, flush);
+	return mt76_dma_get_buf(dev, q, idx, len, info, more, drop, flush,
+				ctrl_read);
 }
 
 static int
@@ -663,6 +812,12 @@
 	return -ENOMEM;
 }
 
+static unsigned int tx_linearize_small;
+module_param(tx_linearize_small, uint, 0644);
+MODULE_PARM_DESC(tx_linearize_small, "lab: copy A-MSDUs of at most this many bytes into one TX buffer (0: off)");
+static unsigned int tx_linearized_small;
+module_param(tx_linearized_small, uint, 0444);
+
 static int
 mt76_dma_tx_queue_skb(struct mt76_phy *phy, struct mt76_queue *q,
 		      enum mt76_txq_id qid, struct sk_buff *skb,
@@ -716,6 +871,20 @@
 		mt76_insert_hdr_pad(skb);
 	}
 
+	/*
+	 * lab: a software A-MSDU of short subframes (typically TCP ACKs)
+	 * reaches the PDMA as many small buffers. Both MT7612 TX stalls seen
+	 * with amsdu_no_odd were frames like that (6 and 16 ACK subframes).
+	 * Copying up to tx_linearize_small bytes into one buffer is cheap and
+	 * keeps the A-MSDU, unlike linear_tx=1.
+	 */
+	if (skb_has_frag_list(skb) &&
+	    skb->len <= READ_ONCE(tx_linearize_small)) {
+		if (__skb_linearize(skb))
+			goto free;
+		tx_linearized_small++;
+	}
+
 	len = skb_headlen(skb);
 	addr = dma_map_single(dev->dma_dev, skb->data, len, DMA_TO_DEVICE);
 	if (unlikely(dma_mapping_error(dev->dma_dev, addr)))
@@ -1113,8 +1282,20 @@
 	return done;
 }
 
+/*
+ * lab: hand the frames to mac80211 and the WHNAT hook in batches of at most
+ * rx_batch DMA buffers instead of the whole NAPI budget. A 64-buffer batch
+ * of A-MSDUs touches more than the 32 KiB D-cache before the first subframe
+ * reaches the hook, which then misses again on its headers. It also bounds
+ * how long mt76_rx_complete() holds rx_lock. 0 keeps the old behaviour.
+ */
+static unsigned int rx_batch;
+module_param(rx_batch, uint, 0644);
+MODULE_PARM_DESC(rx_batch, "lab: RX buffers per mac80211 batch inside a NAPI poll (0: the whole budget)");
+
 int mt76_dma_rx_poll(struct napi_struct *napi, int budget)
 {
+	unsigned int batch = READ_ONCE(rx_batch);
 	struct mt76_dev *dev;
 	int qid, done = 0, cur;
 
@@ -1124,7 +1305,11 @@
 	rcu_read_lock();
 
 	do {
-		cur = mt76_dma_rx_process(dev, &dev->q_rx[qid], budget - done);
+		int n = budget - done;
+
+		if (batch && n > batch)
+			n = batch;
+		cur = mt76_dma_rx_process(dev, &dev->q_rx[qid], n);
 		mt76_rx_poll_complete(dev, qid, napi);
 		done += cur;
 	} while (cur && done < budget);
