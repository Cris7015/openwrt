+static void
+mt76_tx_status_report_deferred(struct mt76_dev *dev, struct sk_buff *skb,
+			       struct list_head *free_list)
+{
+	struct mt76_tx_cb *cb = mt76_tx_skb_cb(skb);
+	struct ieee80211_tx_status status = {
+		.skb = skb,
+		.free_list = free_list,
+	};
+	struct ieee80211_rate_status rs = {};
+	struct mt76_wcid *wcid;
+	struct ieee80211_hw *hw;
+
+	wcid = __mt76_wcid_ptr(dev, cb->wcid);
+	hw = mt76_tx_status_get_hw(dev, skb);
+	status.sta = wcid_to_sta(wcid);
+	if (status.sta && (wcid->rate.flags || wcid->rate.legacy)) {
+		rs.rate_idx = wcid->rate;
+		status.rates = &rs;
+		status.n_rates = 1;
+	}
+	ieee80211_tx_status_ext(hw, &status);
+}
+
+/*
+ * mac80211 must not report tx status while it processes rx, so the report
+ * takes rx_lock, which the rx path holds for a whole batch. The tx
+ * completion, on another CPU, spun on it for every frame. Queue the report
+ * instead and send the queue whenever rx_lock can be had: from the next
+ * completion, from the rx path once the queue grows, or, with @wait, from
+ * the periodic MAC work, so that no report is left behind.
+ */
+void mt76_tx_status_flush_deferred(struct mt76_dev *dev, bool wait)
+{
+	struct sk_buff *skb, *tmp;
+	struct sk_buff_head list;
+	LIST_HEAD(free_list);
+	unsigned long flags;
+
+	__skb_queue_head_init(&list);
+	while (!skb_queue_empty_lockless(&dev->tx_status_defer)) {
+		if (wait)
+			spin_lock_bh(&dev->rx_lock);
+		else if (!spin_trylock_bh(&dev->rx_lock))
+			break;
+
+		/* One irqsave round trip for the whole backlog, not two per skb. */
+		spin_lock_irqsave(&dev->tx_status_defer.lock, flags);
+		skb_queue_splice_init(&dev->tx_status_defer, &list);
+		spin_unlock_irqrestore(&dev->tx_status_defer.lock, flags);
+
+		rcu_read_lock();
+		while ((skb = __skb_dequeue(&list)) != NULL) {
+			struct sk_buff *next = skb_peek(&list);
+
+			/* mac80211 reads its cb, destructor and shinfo */
+			if (next && READ_ONCE(txs_prefetch)) {
+				prefetch(next->cb);
+				prefetch(&next->destructor);
+				prefetch(&next->head);
+			}
+			mt76_tx_status_report_deferred(dev, skb, &free_list);
+		}
+		rcu_read_unlock();
+		spin_unlock_bh(&dev->rx_lock);
+	}
+
+	/*
+	 * mac80211 is done with them. From the TX NAPI or with BH off they go
+	 * back through the per-CPU NAPI skb cache, freed in bulk.
+	 */
+	list_for_each_entry_safe(skb, tmp, &free_list, list) {
+		skb_list_del_init(skb);
+		napi_consume_skb(skb, in_softirq() ? 1 : 0);
+	}
+}
+EXPORT_SYMBOL_GPL(mt76_tx_status_flush_deferred);
