mt76x2: retain validated single-fragment TX profile on XR500v

Keep AMPDU and WHNAT. Limit software TX fragmentation only on this board,
with a load-time rollback option.

--- a/mt76x2/pci_init.c
+++ b/mt76x2/pci_init.c
@@ -4,9 +4,16 @@
  */
 
 #include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
 #include "mt76x2.h"
 #include "eeprom.h"
 #include "mcu.h"
+
+/* Preserve the validated XR500v single-fragment TX compatibility profile. */
+static bool linear_tx = true;
+module_param(linear_tx, bool, 0444);
+MODULE_PARM_DESC(linear_tx, "XR500v: disable software TX AMSDU/frag_list");
 #include "../mt76x02_mac.h"
 
 static void
@@ -301,6 +308,8 @@
 		return ret;
 
 	mt76x02_config_mac_addr_list(dev);
+	if (linear_tx && of_machine_is_compatible("tplink,archer-xr500v-v1"))
+		mt76_hw(dev)->max_tx_fragments = 1;
 
 	ret = mt76_register_device(&dev->mt76, true, mt76x02_rates,
 				   ARRAY_SIZE(mt76x02_rates));
@@ -317,4 +326,3 @@
 	mt76x2_stop_hardware(dev);
 	return ret;
 }
-
