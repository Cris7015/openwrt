+	if (parent) {
+		flow = airoha_ppe_v1_l2_subflow(ppe, parent, &tuple);
+		if (flow)
+			airoha_ppe_v1_bind_flow(ppe, flow, hash, ingress_gem);
 	}
+out:
 	spin_unlock_bh(&ppe->v1.lock);
 }
 
