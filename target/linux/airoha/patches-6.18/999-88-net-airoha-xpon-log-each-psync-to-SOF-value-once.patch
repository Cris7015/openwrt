From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Wed, 25 Nov 2026 00:16:22 -0300
Subject: [PATCH] net: airoha: xpon: log each psync-to-SOF value of the relock
 monitor once

For hours after the fiber panel's hourly eye scans, the PHY
psync-to-SOF delay of the XR500v toggled between its O5 reference
(39200) and 39192 every few seconds: 635 "GPON PHY relock in O5" lines
in under four hours, with no LOS/LOF latched, no O6, no BIP or FEC
error and no EqD adjustment from the OLT. Each change passed the three
stable reads, so the register did change; nothing shows the PHY lost
lock. The lines filled the kernel log and pushed out the ones a soak
counts (link ready, Deactivate).

Log each value once: a return to the reference, or to the last other
value, only counts in the new gpon_psync_changes debugfs file. The
correction (gpon_relock_comp=1) still follows every change; it stays
off by default.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/drivers/net/ethernet/airoha/airoha_xpon.h
+++ b/drivers/net/ethernet/airoha/airoha_xpon.h
@@ -588,6 +588,9 @@ struct xpon_priv {
 	u32			irq_status_latched;
 	/* Last stable psync-to-SOF delay seen in O5 */
 	u32			psync_sof_last;
+	/* The last value other than psync_sof_o5, and the changes seen in O5 */
+	u32			psync_sof_alt;
+	u32			psync_changes;
 	/*
 	 * Latched PHY events, per AIROHA_XPON_PHY_EV_* bit, from the link
 	 * poll; a missed loss is LOS or ILLG latched while the samples on
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -3331,6 +3331,7 @@ static void gpon_psync_check(struct xpon
 {
 	u8 base = priv->match_data->gpon_fine_delay, fine;
 	u32 delay, prev;
+	bool repeat;
 	int diff;
 
 	if (!READ_ONCE(gpon_relock_monitor) || priv->psync_sof_o5 == U32_MAX ||
@@ -3351,7 +3352,24 @@ static void gpon_psync_check(struct xpon
 	priv->psync_sof_last = delay;
 	diff = (int)delay - (int)priv->psync_sof_o5;
 
+	/*
+	 * On the XR500v the delay can toggle between the O5 reference and one
+	 * other value every few seconds for hours (seen after the eye scans of
+	 * the fiber panel), with no LOS/LOF latched, no O6, no BIP or FEC
+	 * errors and no EqD adjustment from the OLT: about 150 lines an hour
+	 * that pushed everything else out of the kernel log. Log each value
+	 * once; a return to the reference or to the last other value is only
+	 * counted (gpon_psync_changes in debugfs). The correction, when on,
+	 * still follows every change.
+	 */
+	priv->psync_changes++;
+	repeat = delay == priv->psync_sof_o5 || delay == priv->psync_sof_alt;
+	if (delay != priv->psync_sof_o5)
+		priv->psync_sof_alt = delay;
+
 	if (abs(diff) > GPON_RELOCK_MAX_DIFF) {
+		if (repeat)
+			return;
 		dev_warn_ratelimited(priv->dev,
 				     "GPON PHY relock in O5: psync-to-SOF %u -> %u, %d from ranging: outside +/-%d, MAC fine delay left at %#x\n",
 				     prev, delay, diff, GPON_RELOCK_MAX_DIFF,
@@ -3361,6 +3379,8 @@ static void gpon_psync_check(struct xpon
 
 	fine = base + diff / 2;
 	if (fine == priv->fine_delay) {
+		if (repeat)
+			return;
 		dev_info_ratelimited(priv->dev,
 				     "GPON PHY relock in O5: psync-to-SOF %u -> %u, %d from ranging, MAC fine delay %#x unchanged\n",
 				     prev, delay, diff, fine);
@@ -3368,15 +3388,18 @@ static void gpon_psync_check(struct xpon
 	}
 
 	if (!READ_ONCE(gpon_relock_comp)) {
+		if (repeat)
+			return;
 		dev_warn_ratelimited(priv->dev,
 				     "GPON PHY relock in O5: psync-to-SOF %u -> %u, %d from ranging; stock would set MAC fine delay %#x -> %#x (gpon_relock_comp=0)\n",
 				     prev, delay, diff, priv->fine_delay, fine);
 		return;
 	}
 
-	dev_warn_ratelimited(priv->dev,
-			     "GPON PHY relock in O5: psync-to-SOF %u -> %u, %d from ranging: MAC fine delay %#x -> %#x\n",
-			     prev, delay, diff, priv->fine_delay, fine);
+	if (!repeat)
+		dev_warn_ratelimited(priv->dev,
+				     "GPON PHY relock in O5: psync-to-SOF %u -> %u, %d from ranging: MAC fine delay %#x -> %#x\n",
+				     prev, delay, diff, priv->fine_delay, fine);
 	gpon_set_fine_delay(priv, fine);
 }
 
@@ -3404,6 +3427,7 @@ static void gpon_log_psync_sof(struct xp
 	if (priv->psync_sof_o5 == U32_MAX) {
 		priv->psync_sof_o5 = delay;
 		priv->psync_sof_last = delay;
+		priv->psync_sof_alt = U32_MAX;
 		dev_info(priv->dev, "GPON %s: PHY psync-to-SOF delay %u\n",
 			 when, delay);
 		return;
--- a/drivers/net/ethernet/airoha/airoha_xpon_blackbox.h
+++ b/drivers/net/ethernet/airoha/airoha_xpon_blackbox.h
@@ -764,6 +764,8 @@ static void gpon_bb_init(struct xpon_pri
 				   &bb->resync_glitch);
 		debugfs_create_x32("gpon_sfifo_glitch_last", 0400, bb->dir,
 				   &bb->resync_glitch_last);
+		debugfs_create_u32("gpon_psync_changes", 0400, bb->dir,
+				   &priv->psync_changes);
 	}
 	hrtimer_setup(&bb->ust_timer, gpon_ust_tick, CLOCK_MONOTONIC,
 		      HRTIMER_MODE_REL);
