 	if (content_len < 2 || response_capacity < 1)
@@ -4318,16 +4318,12 @@ static u8 omci_agent_get_locked(struct omci_device *odev, u16 class_id,
 	    omci_agent_refresh_nokia_optical(odev, object))
 		return OMCI_RESULT_PROCESSING_ERROR;
 
+	if (class_id == OMCI_CLASS_ANI_G &&
+	    (mask & OMCI_ANI_G_OPTICAL_LEVEL_MASK))
+		failed = omci_agent_refresh_ani_g_levels(odev, object, mask);
+
 	desc = omci_me_lookup(agent, class_id);
 	switch (class_id) {
-	case OMCI_CLASS_ONU_G:
-		attrs = omci_onu_g_attrs;
-		num_attrs = ARRAY_SIZE(omci_onu_g_attrs);
-		break;
-	case OMCI_CLASS_ONU2_G:
-		attrs = omci_onu2_g_attrs;
-		num_attrs = ARRAY_SIZE(omci_onu2_g_attrs);
-		break;
 	case OMCI_CLASS_PRIORITY_QUEUE:
 		num_attrs = omci_layout_attrs(omci_priority_queue_layout,
 					      ARRAY_SIZE(omci_priority_queue_layout),
@@ -4362,7 +4358,7 @@ static u8 omci_agent_get_locked(struct omci_device *odev, u16 class_id,
 		break;
 	}
 
-	return omci_me_get_encode(attrs, num_attrs, object->data, mask, 0,
+	return omci_me_get_encode(attrs, num_attrs, object->data, mask, failed,
 				  extended, response_content,
 				  response_capacity, response_len);
 }
