 static bool omci_agent_get_uses_ani_g_telemetry(u16 class_id, u16 entity_id,
 						u16 mask)
 {
@@ -4281,6 +4280,7 @@ static u8 omci_agent_get_locked(struct omci_device *odev, u16 class_id,
