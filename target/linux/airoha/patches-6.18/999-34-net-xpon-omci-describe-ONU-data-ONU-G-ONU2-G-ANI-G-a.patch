+/*
+ * Measure the ANI-G optical levels for a Get that mixes them with other
+ * attributes; the levels that cannot be measured are returned as failed.
+ */
+static u16 omci_agent_refresh_ani_g_levels(struct omci_device *odev,
+					   struct omci_mib_object *object,
+					   u16 mask)
+{
+	struct omci_telemetry telemetry = {};
+	u16 failed = mask & OMCI_ANI_G_OPTICAL_LEVEL_MASK;
+
+	if (!odev->ops->get_telemetry)
+		return 0;
+	if (odev->ops->get_telemetry(odev, &telemetry))
+		return failed;
+	if (telemetry.valid & OMCI_TELEMETRY_F_BOSA_RX_POWER) {
+		put_unaligned_be16((u16)omci_power_nw_to_ani_g_level(
+					telemetry.bosa_rx_power_nw),
+				   object->data + OMCI_ANI_G_RX_LEVEL_OFFSET);
+		failed &= ~OMCI_ANI_G_RX_LEVEL_MASK;
+	}
+	if (telemetry.valid & OMCI_TELEMETRY_F_BOSA_TX_POWER) {
+		put_unaligned_be16((u16)omci_power_nw_to_ani_g_level(
+					telemetry.bosa_tx_power_nw),
+				   object->data + OMCI_ANI_G_TX_LEVEL_OFFSET);
+		failed &= ~OMCI_ANI_G_TX_LEVEL_MASK;
+	}
+
+	return failed;
+}
