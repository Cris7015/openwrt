+
+/*
+ * Split the uploadable attributes of @object into MIB upload next records
+ * (G.988 MIB upload next: class, instance, attribute mask and up to 26
+ * bytes of values). Attributes that do not fit in the current record
+ * start the next one, so an ME whose attributes exceed 26 bytes is sent in
+ * several records with disjoint masks. An ME with nothing to upload still
+ * gets one record, with an empty mask.
+ *
+ * @records may be NULL to count; it must otherwise be zeroed.
+ * Returns the number of records.
+ */
+unsigned int omci_me_upload_records(const struct omci_me_desc *desc,
+				    const struct omci_mib_object *object,
+				    struct omci_upload_record *records)
+{
+	u16 mask = object->attr_mask & desc->mib_upload_mask &
+		   desc->valid_attr_mask;
+	struct omci_upload_record *record = records;
+	unsigned int count = 0;
+	u16 record_mask = 0;
 	size_t used = 0;
 	unsigned int bit;
-	u16 encoded = 0;
 
-	if (!desc)
-		return -ENOENT;
-	mask &= desc->valid_attr_mask;
 	for (bit = 0; bit < 16; bit++) {
 		const struct omci_attr_desc *attr;
 		u16 attr_mask = BIT(15 - bit);
@@ -1377,23 +1397,30 @@ int omci_me_encode_attributes(const struct omci_me_desc *desc,
 		if (!(mask & attr_mask))
 			continue;
 		attr = omci_me_find_attr(desc, attr_mask);
-		if (!attr || !(attr->access & OMCI_ATTR_ACCESS_READ))
+		if (!attr || !(attr->access & OMCI_ATTR_ACCESS_READ) ||
+		    attr->len > OMCI_UPLOAD_ATTR_LEN)
 			continue;
 		if (attr->offset != OMCI_ATTR_OFFSET_ZERO &&
 		    attr->offset + attr->len > sizeof(object->data))
-			return -EINVAL;
-		if (len - used < attr->len)
-			break;
-		omci_me_put_value(data + used, attr, object->data);
+			continue;
+		if (record_mask && used + attr->len > OMCI_UPLOAD_ATTR_LEN) {
+			if (records)
+				omci_me_upload_close(record++, object,
+						     record_mask);
+			count++;
+			record_mask = 0;
+			used = 0;
+		}
+		if (records)
+			omci_me_put_value(record->data + used, attr,
+					  object->data);
 		used += attr->len;
-		encoded |= attr_mask;
+		record_mask |= attr_mask;
 	}
-	if (encoded_mask)
-		*encoded_mask = encoded;
-	if (encoded_len)
-		*encoded_len = used;
+	if (records)
+		omci_me_upload_close(record, object, record_mask);
 
-	return encoded ? 0 : -ENOSPC;
+	return count + 1;
 }
 
