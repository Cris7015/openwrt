From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Sat, 14 Nov 2026 05:35:59 -0300
Subject: [PATCH] net: xpon: omci: bound the work of a service reconciliation

The service reconciliation walks the whole MIB once for every UNI-side
bridge port, to find the ANI-side ports of its bridge, and once more
for every path from there to a GEM port, to find the VLAN objects of
the path. The paths are the UNI-side ports times the ANI-side ports
times the priorities of a mapper, every Create, Set and Delete of a
datapath class starts a reconciliation, and all of it runs with the
agent lock held. With the 4096 objects the MIB now holds, an OLT that
fills it with bridge ports makes one message cost billions of object
visits.

Count the walks and give up at 4096 with -E2BIG. The Create or Set that
asked for more is then refused and rolled back like any other failed
reconciliation, and the services stay as they were. A provisioned HGU
needs far fewer: 130 here, against a Huawei OLT. Yield the CPU between
walks as well.

Found by reading the source in a security review of the OMCI agent.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>
---
--- a/net/xpon/omci/agent.c
+++ b/net/xpon/omci/agent.c
@@ -110,6 +110,14 @@ static bool omci_agent_result_can_be_fak
  * are always stored: their number is fixed by the code.
  */
 #define OMCI_MIB_MAX_OBJECTS		4096
+/*
+ * The most walks of the MIB one service reconciliation makes: one for every
+ * UNI-side bridge port and one for every path from it to a GEM port. They
+ * multiply (UNI-side ports by ANI-side ports by priorities), every Create,
+ * Set and Delete of a datapath class starts a reconciliation, and it runs
+ * with the agent lock held. The HGU this was sized on needs 130.
+ */
+#define OMCI_RECONCILE_MAX_WORK		4096
 
 #define OMCI_OMCI_ME_TYPE_TABLE_MASK		BIT(15)
 #define OMCI_OMCI_MESSAGE_TYPE_TABLE_MASK	BIT(14)
@@ -3142,6 +3150,21 @@ omci_agent_vlan_associated(const struct
 	return false;
 }
 
+static int omci_agent_reconcile_charge_locked(struct omci_device *odev)
+{
+	struct omci_agent *agent = &odev->agent;
+
+	if (++agent->reconcile_work > OMCI_RECONCILE_MAX_WORK) {
+		dev_warn_ratelimited(odev->parent,
+				     "OMCI service graph needs more than %u MIB walks: not applied\n",
+				     OMCI_RECONCILE_MAX_WORK);
+		return -E2BIG;
+	}
+	cond_resched();
+
+	return 0;
+}
+
 static int
 omci_agent_stage_path_locked(struct omci_device *odev,
 			     struct xarray *services,
@@ -3159,6 +3182,10 @@ omci_agent_stage_path_locked(struct omci
 	bool installed = false;
 	int ret;
 
+	ret = omci_agent_reconcile_charge_locked(odev);
+	if (ret)
+		return ret;
+
 	xa_for_each(&agent->mib, index, object) {
 		unsigned int i;
 
@@ -3227,6 +3254,10 @@ omci_agent_resolve_bridge_locked(struct
 	if (!omci_agent_uni_enabled(agent, lan_type, uni_entity))
 		return 0;
 
+	ret = omci_agent_reconcile_charge_locked(odev);
+	if (ret)
+		return ret;
+
 	xa_for_each(&agent->mib, index, wan_port) {
 		u16 mapper_entity;
 		u16 gem_iwtp_entity;
@@ -3301,6 +3332,7 @@ static int omci_agent_reconcile_services
 	int ret;
 
 	xa_init(&desired);
+	agent->reconcile_work = 0;
 	xa_for_each(&agent->mib, index, object) {
 		u8 tp_type;
 
--- a/net/xpon/omci/internal.h
+++ b/net/xpon/omci/internal.h
@@ -162,6 +162,8 @@ struct omci_agent {
 	struct mutex lock;
 	struct xarray mib;
 	struct xarray services;
+	/* MIB walks made so far by the service reconciliation under way */
+	unsigned int reconcile_work;
 	struct omci_agent_config config;
 	u32 upload_index;
 	/* MIB snapshot taken by MIB upload, served by MIB upload next */
