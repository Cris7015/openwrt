From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Sun, 22 Nov 2026 20:51:49 -0300
Subject: [PATCH] net: airoha: econet: drop an RX descriptor that never got DONE

RX_HWI can pass a descriptor before its write-back shows, so the driver
waits for DONE, and gives up after 256 polls so that a wrong assumption
cannot stall the ring. A descriptor given up was then handled like any
other. It still holds what the refill wrote: the buffer size as length
and an all-zero message. So a whole page of whatever it held before went
up the stack as a frame from port 0 with CPU reason 0: on the conduit of
the switch, or on a WiFi interface through WHNAT, which takes the frames
of port 0 for its own.

Without the write-back there is neither a length nor a source to trust:
consume the slot and return the buffer to the pool.

The give-up has not been seen on the XR500v (rx_wait_gave_up stays 0);
this only changes what happens if it ever is.

Found in the 22-nov-2026 code audit.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -435,7 +435,8 @@ MODULE_PARM_DESC(rx_lean_desc, "lab: EN7
 
 static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 				     enum dma_data_direction dir,
-				     struct airoha_whnat_batch *batch)
+				     struct airoha_whnat_batch *batch,
+				     bool no_done)
 {
 	struct econet_q_rx_ent *e = &q->entry[cpu_i];
 	struct airoha_eth *eth = q->qdma->qdma->eth;
@@ -470,6 +471,15 @@ static void econet_qdma_rx_process_one(s
 	if (!lean)
 		WRITE_ONCE(q->desc[cpu_i].pkt_addr, 0);
 
+	/*
+	 * The hardware never wrote this descriptor back: what it holds is
+	 * what the refill put there, the buffer size as length and an
+	 * all-zero message. There is no frame to deliver, only a page of
+	 * whatever it held before.
+	 */
+	if (unlikely(no_done))
+		goto return_page;
+
 	len = get_desc_info_pkt_len(&desc.info);
 	if (!len || len > SKB_WITH_OVERHEAD(q->buf_size) - headroom -
 				(q->qdma->cfg.rx_2b_offset ? NET_IP_ALIGN : 0))
@@ -575,11 +585,15 @@ MODULE_PARM_DESC(rx_wait_gave_up, "EN751
  * injects a PPE-rewritten downstream frame as RX on the vif). The vendor
  * driver (qdma_bm_receive_packets()) only consumes descriptors with DONE
  * set. Spin briefly for it; if it still is not there, leave the descriptor
- * for the next poll. A descriptor that never gets DONE is consumed as
- * before after ECONET_RX_DONE_POLLS polls, so a wrong assumption cannot
- * stall the ring.
+ * for the next poll. A descriptor that never gets DONE is given up after
+ * ECONET_RX_DONE_POLLS polls, so a wrong assumption cannot stall the ring:
+ * its slot is consumed and its buffer goes back to the pool, since without
+ * the write-back there is neither a length nor a source port to trust.
+ *
+ * Returns 1 when the descriptor is ready, 0 to wait for the next poll and
+ * -1 when it is given up.
  */
-static bool econet_rx_desc_ready(struct econet_q_rx *q, u32 i)
+static int econet_rx_desc_ready(struct econet_q_rx *q, u32 i)
 {
 	unsigned int id = q->qdma->qdma->id & 1;
 	int spin;
@@ -591,7 +605,7 @@ static bool econet_rx_desc_ready(struct
 			q->wait_polls = 0;
 			/* Read the rest of the descriptor after DONE. */
 			dma_rmb();
-			return true;
+			return 1;
 		}
 		cpu_relax();
 	}
@@ -599,15 +613,15 @@ static bool econet_rx_desc_ready(struct
 	if (++q->wait_polls < ECONET_RX_DONE_POLLS) {
 		if (q->wait_polls == 1)
 			rx_wait_done[id]++;
-		return false;
+		return 0;
 	}
 
 	rx_wait_gave_up[id]++;
 	q->wait_polls = 0;
-	pr_warn_ratelimited("airoha: qdma%u rx %u: no DONE after %d polls, info %08x\n",
+	pr_warn_ratelimited("airoha: qdma%u rx %u: no DONE after %d polls, info %08x: dropped\n",
 			    id, i, ECONET_RX_DONE_POLLS,
 			    READ_ONCE(q->desc[i].info.word));
-	return true;
+	return -1;
 }
 
 static int econet_qdma_rx_process(struct econet_q_rx *q, int budget,
@@ -633,11 +647,13 @@ static int econet_qdma_rx_process(struct
 	cpu_i = q->next_i;
 
 	for (done = 0; done < budget && cpu_i != hardware_i; done++) {
-		if (unlikely(!econet_rx_desc_ready(q, cpu_i))) {
+		int ready = econet_rx_desc_ready(q, cpu_i);
+
+		if (unlikely(!ready)) {
 			q->wait_done = true;
 			break;
 		}
-		econet_qdma_rx_process_one(q, cpu_i, dir, batch);
+		econet_qdma_rx_process_one(q, cpu_i, dir, batch, ready < 0);
 		cpu_i = (cpu_i + 1) % ndesc;
 	}
 
