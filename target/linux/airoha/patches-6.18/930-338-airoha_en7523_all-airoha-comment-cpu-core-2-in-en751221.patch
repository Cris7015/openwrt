From 2e2cf91fe84467d77649efebd99a28284f2124b3 Mon Sep 17 00:00:00 2001
From: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
Date: Sun, 6 Sep 2026 15:36:42 -0300
Subject: [PATCH] airoha: comment cpu core 2 in en751221

Signed-off-by: Matheus Sampaio Queiroga <srherobrine20@gmail.com>
---
 arch/mips/boot/dts/econet/en751221.dtsi | 26 +++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/arch/mips/boot/dts/econet/en751221.dtsi b/arch/mips/boot/dts/econet/en751221.dtsi
index 5bb0c7b04..2014653ec 100644
--- a/arch/mips/boot/dts/econet/en751221.dtsi
+++ b/arch/mips/boot/dts/econet/en751221.dtsi
@@ -27,11 +27,33 @@ cpus: cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
 
-		cpu@0 {
+		cpu0: cpu@0 {
 			device_type = "cpu";
 			compatible = "mips,mips34Kc";
 			reg = <0>;
 		};
+
+		/* Needs mapping and fix shadow cores
+		cpu1: cpu@1 {
+			device_type = "cpu";
+			compatible = "mips,mips34Kc";
+			reg = <1>;
+		};
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					thread0 {
+						cpu = <&cpu0>;
+					};
+
+					thread1 {
+						cpu = <&cpu1>;
+					};
+				};
+			};
+		};
+		*/
 	};
 
 	cpuintc: interrupt-controller {
@@ -117,7 +139,7 @@ watchdog: watchdog@1fbf0100 {
 	crypto@1e004000 {
 		compatible = "inside-secure,safexcel-eip93ies";
 		reg = <0x1fb70000 0x1000>;
-		
+
 		interrupt-parent = <&intc>;
 		interrupts = <28>;
 	};
