From 06520aff623ddddf2e6d9383ec3c9a7d8ccce2d9 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Sun, 27 Sep 2026 02:40:00 -0300
Subject: [PATCH] net: omci: create the OLT-G instance in every OLT profile

OLT profile autodetection reads the vendor ID the OLT writes into OLT-G
(class 131), but only the Nokia profile creates that instance, pre-seeded
with ALCL. With the default "auto" profile the MIB has no OLT-G, so the
OLT has nowhere to write its identity and the effective profile always
ends up "generic".

The ONU creates the OLT-G instance itself (G.988 9.12.2): add an empty
one to the default MIB. The Nokia profile still replaces it with its
pre-seeded one.

Assisted-by: Claude:claude-opus-5-5
(cherry picked from commit 513b662e7abb62e0f5ea694176826855182af76b)
---
 net/xpon/omci/agent.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/net/xpon/omci/agent.c b/net/xpon/omci/agent.c
index c992e4c8b..5c13c55c8 100644
--- a/net/xpon/omci/agent.c
+++ b/net/xpon/omci/agent.c
@@ -1773,6 +1773,17 @@ static int omci_agent_populate_defaults(struct omci_device *odev)
 	if (ret)
 		return ret;
 
+	/*
+	 * The ONU creates the OLT-G instance (G.988 9.12.2) and the OLT
+	 * writes its identity there: OLT profile autodetection relies on
+	 * it. The Nokia profile replaces it with its pre-seeded one.
+	 */
+	memset(data, 0, sizeof(data));
+	ret = omci_mib_add_default(agent, OMCI_CLASS_OLT_G, 0, data,
+				   sizeof(data));
+	if (ret)
+		return ret;
+
 	for (i = 0; i < agent->config.uni_count; i++) {
 		u16 entity_id = OMCI_UNI_ENTITY_ID(OMCI_ETHERNET_SLOT, i + 1);
 
