From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Sun, 22 Nov 2026 20:51:49 -0300
Subject: [PATCH] net: airoha: report a TX queue that stopped moving

The driver had no ndo_tx_timeout, and without one the stack does not arm
its TX watchdog: a queue that stopped for good, because completions were
lost or the ring never drained, left no trace, the interface just no
longer sent.

Add one that reports the queue, its byte queue limit state and, on the
EcoNet QDMA, the state of the TX rings, and counts the event in the
tx_timeouts parameter. It resets nothing.

Found in the 22-nov-2026 code audit.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
Co-Authored-By: Claude Mythos 5.2 <noreply@anthropic.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -9577,6 +9577,59 @@ static int airoha_gdm_dev_tc_setup(struc
 	}
 }
 
+/* TX queues the stack's watchdog found stopped with nothing sent. */
+static unsigned int tx_timeouts;
+module_param(tx_timeouts, uint, 0444);
+MODULE_PARM_DESC(tx_timeouts, "Times a TX queue stayed stopped for the watchdog time");
+
+/*
+ * Without this callback the stack does not run its TX watchdog at all, and a
+ * queue that stopped for good said nothing: the interface just no longer
+ * sent. Report it and count it. Nothing is reset: restarting a QDMA under
+ * traffic is not something this driver knows how to do safely, and the
+ * numbers below are what tells a ring that filled up from completions that
+ * were lost.
+ */
+static void airoha_dev_tx_timeout(struct net_device *netdev,
+				  unsigned int txqueue)
+{
+	struct airoha_gdm_dev *dev = netdev_priv(netdev);
+	struct netdev_queue *txq = netdev_get_tx_queue(netdev, txqueue);
+	struct airoha_qdma_mips *econet;
+	unsigned int inflight = 0;
+	int i;
+
+	WRITE_ONCE(tx_timeouts, READ_ONCE(tx_timeouts) + 1);
+	if (!net_ratelimit())
+		return;
+
+#ifdef CONFIG_BQL
+	inflight = READ_ONCE(txq->dql.num_queued) -
+		   READ_ONCE(txq->dql.num_completed);
+#endif
+	netdev_err(netdev,
+		   "TX queue %u stopped: state %#lx, %u bytes queued and not completed\n",
+		   txqueue, READ_ONCE(txq->state), inflight);
+
+	if (!airoha_has_legacy_qdma(dev->eth) || !dev->qdma ||
+	    !dev->qdma->econet)
+		return;
+
+	econet = dev->qdma->econet;
+	for (i = 0; i < ARRAY_SIZE(econet->q_tx); i++) {
+		struct econet_q_tx *q = &econet->q_tx[i];
+
+		if (!q->ndesc || !q->qchain_regs)
+			continue;
+		netdev_err(netdev,
+			   "qdma%u TX ring %d: %u of %d descriptors free, cpu index %u, hardware index %u, completions given up %u\n",
+			   dev->qdma->id, i, READ_ONCE(q->free_count), q->ndesc,
+			   econet_rreg(&q->qchain_regs->tx_cpui),
+			   econet_rreg(&q->qchain_regs->tx_hwi),
+			   tx_wait_gave_up[dev->qdma->id & 1]);
+	}
+}
+
 static const struct net_device_ops airoha_netdev_ops = {
 	.ndo_init		= airoha_dev_init,
 	.ndo_open		= airoha_dev_open,
@@ -9586,6 +9639,7 @@ static const struct net_device_ops airoh
 	.ndo_fix_features	= airoha_dev_fix_features,
 	.ndo_set_features	= airoha_dev_set_features,
 	.ndo_start_xmit		= airoha_dev_xmit,
+	.ndo_tx_timeout		= airoha_dev_tx_timeout,
 	.ndo_get_stats64	= airoha_gdm_dev_get_stats64,
 	.ndo_set_mac_address	= airoha_gdm_dev_set_macaddr,
 	.ndo_setup_tc		= airoha_gdm_dev_tc_setup,
