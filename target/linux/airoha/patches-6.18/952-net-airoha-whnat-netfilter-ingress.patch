From 4e99ebb8c7f9b9cb5b061aad8f1b8679ffb4e7af Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Wed, 14 Oct 2026 16:38:31 -0300
Subject: [PATCH] net: airoha: offer WHNAT upstream through netfilter ingress

Add an opt-in ingress path alongside the legacy pre-GRO mt76 hook. Disable and restore GRO with each automatic slot, bypass redirected returns using the standard skb redirect indication, and receive those returns without GRO so RPS and skb clones preserve the bypass. Keep CPU fallback for GSO and ingress TC. Use only the wireless_dev pointer to avoid assuming the layout of cfg80211 backports, and exclude devices requiring an ops lock during notifier teardown.
---
 drivers/net/ethernet/airoha/Kconfig        |  11 +-
 drivers/net/ethernet/airoha/airoha_whnat.c | 205 ++++++++++++++++++---
 2 files changed, 191 insertions(+), 25 deletions(-)

diff --git a/drivers/net/ethernet/airoha/Kconfig b/drivers/net/ethernet/airoha/Kconfig
index 2fba4acd8..b808a8ea4 100644
--- a/drivers/net/ethernet/airoha/Kconfig
+++ b/drivers/net/ethernet/airoha/Kconfig
@@ -66,12 +66,15 @@ config NET_AIROHA_WHNAT
 	help
 	  Let the EN751221 PPE forward NAT flows from and to WiFi netdevs
 	  whose radios have no WED support (MT7603, MT76x2), like the vendor
-	  WHNAT driver: mt76 hands received frames to the PPE through the LAN
+	  WHNAT driver: received frames are handed to the PPE through the LAN
 	  QDMA, and the PPE returns frames of flows bound towards a WiFi
 	  interface to the CPU, which queues them straight to that interface.
-	  The mt76 side registers its interfaces through
-	  en75_whnat_register_vif(). Nothing changes until the whnat_enable
-	  module parameter is set.
+	  By default mt76 registers interfaces and offers RX frames through
+	  exported hooks. Set whnat_auto_vifs=1 and whnat_rx_hook=ingress at
+	  boot or module load to use standard netdevice and netfilter hooks
+	  instead. The ingress path requires NETFILTER_INGRESS and disables
+	  GRO on participating interfaces until their slots are released.
+	  The whnat_enable parameter controls offering new frames to the PPE.
 
 	  If unsure, say N.
 
diff --git a/drivers/net/ethernet/airoha/airoha_whnat.c b/drivers/net/ethernet/airoha/airoha_whnat.c
index bdd7bcb27..83340114e 100644
--- a/drivers/net/ethernet/airoha/airoha_whnat.c
+++ b/drivers/net/ethernet/airoha/airoha_whnat.c
@@ -5,20 +5,19 @@
  * MT7603 and MT76x2 radios have no WED, so the vendor driver lets the PPE
  * handle their NAT flows through the CPU instead:
  *
- * - Upstream, mt76 offers each received Ethernet frame to
- *   en75_whnat_upstream_early() before GRO. The frame gets an 802.1Q tag
+ * - Upstream, either the legacy mt76 hook or a netfilter ingress hook
+ *   offers received Ethernet frames. The frame gets an 802.1Q tag
  *   carrying the index of its vif and goes to the PPE through the LAN QDMA.
  *   A bound flow leaves through its GDM port. An unbound one comes back to
- *   the CPU still tagged, which lets the PPE bind it, and is handed to GRO
- *   on its vif as if mt76 had never offered it.
+ *   the CPU still tagged, which lets the PPE bind it. The ingress path
+ *   marks these returns as redirected to avoid offering them again.
  * - Downstream, a flow towards a vif is bound with the CPU as destination and
  *   the vif index in its L2 tag. The PPE returns the rewritten frames with
  *   CRSN_22, and they are queued straight to the vif.
  *
- * mt76 registers the vif netdevs with en75_whnat_register_vif(), which gives
- * each one of the AIROHA_WHNAT_VIFS slots. The offload is on whenever it is
- * built and a PPE is active; clearing the whnat_enable module parameter hands
- * nothing more to the PPE.
+ * Slots may be managed by netdevice events or the legacy mt76 exports.
+ * The ingress path requires automatic slots and disables GRO on their vifs.
+ * Clearing whnat_enable stops offering new frames to the PPE.
  */
 
 #include <linux/etherdevice.h>
@@ -26,10 +25,11 @@
 #include <linux/if_vlan.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/netfilter.h>
 #include <linux/rcupdate.h>
 #include <linux/unaligned.h>
-#include <net/cfg80211.h>
 #include <net/dsa.h>
+#include <net/netdev_lock.h>
 #include <net/sch_generic.h>
 
 #include "airoha_eth.h"
@@ -40,13 +40,45 @@ static struct airoha_ppe __rcu *active_ppe;
 static struct airoha_qdma __rcu *active_qdma;
 static DEFINE_MUTEX(vif_lock);
 static bool notifier_registered;
+static bool whnat_ingress;
+
+static int rx_hook_set(const char *val, const struct kernel_param *kp)
+{
+	bool ingress;
+
+	if (sysfs_streq(val, "mt76"))
+		ingress = false;
+	else if (sysfs_streq(val, "ingress"))
+		ingress = true;
+	else
+		return -EINVAL;
+
+	if (ingress && !IS_ENABLED(CONFIG_NETFILTER_INGRESS))
+		return -EOPNOTSUPP;
+
+	*(bool *)kp->arg = ingress;
+	return 0;
+}
+
+static int rx_hook_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%s\n", *(bool *)kp->arg ? "ingress" : "mt76");
+}
+
+static const struct kernel_param_ops rx_hook_ops = {
+	.set = rx_hook_set,
+	.get = rx_hook_get,
+};
+
+module_param_cb(whnat_rx_hook, &rx_hook_ops, &whnat_ingress, 0444);
+MODULE_PARM_DESC(whnat_rx_hook, "Receive path: mt76 or ingress (requires auto_vifs)");
 
 static bool whnat_auto_vifs;
 module_param(whnat_auto_vifs, bool, 0444);
 MODULE_PARM_DESC(whnat_auto_vifs, "Manage WiFi slots through netdevice events");
 
 static int airoha_whnat_netdev_event(struct notifier_block *nb,
-				    unsigned long event, void *ptr);
+				     unsigned long event, void *ptr);
 
 static struct notifier_block airoha_whnat_netdev_notifier = {
 	.notifier_call = airoha_whnat_netdev_event,
@@ -61,6 +93,9 @@ static atomic_t completed = ATOMIC_INIT(0);
 static atomic_t returned = ATOMIC_INIT(0);
 static atomic_t downstream = ATOMIC_INIT(0);
 static atomic_t fallback = ATOMIC_INIT(0);
+static atomic_t ingress_redirected = ATOMIC_INIT(0);
+static atomic_t ingress_gso = ATOMIC_INIT(0);
+static atomic_t ingress_tc = ATOMIC_INIT(0);
 
 static int counter_get(char *buf, const struct kernel_param *kp)
 {
@@ -82,6 +117,115 @@ module_param_cb(whnat_completed, &counter_ops, &completed, 0444);
 module_param_cb(whnat_returned, &counter_ops, &returned, 0444);
 module_param_cb(whnat_downstream, &counter_ops, &downstream, 0444);
 module_param_cb(whnat_fallback, &counter_ops, &fallback, 0444);
+module_param_cb(whnat_ingress_redirected, &counter_ops, &ingress_redirected, 0444);
+module_param_cb(whnat_ingress_gso, &counter_ops, &ingress_gso, 0444);
+module_param_cb(whnat_ingress_tc, &counter_ops, &ingress_tc, 0444);
+
+static bool airoha_whnat_upstream(struct sk_buff *skb);
+
+#if IS_ENABLED(CONFIG_NETFILTER_INGRESS)
+#define AIROHA_WHNAT_GRO_FEATURES (NETIF_F_GRO | NETIF_F_GRO_FRAGLIST)
+
+static struct airoha_whnat_ingress {
+	struct nf_hook_ops hook;
+	netdev_features_t wanted_gro;
+	netdev_features_t hw_gro;
+} ingress_hooks[AIROHA_WHNAT_VIFS];
+
+static unsigned int airoha_whnat_ingress_hook(void *priv, struct sk_buff *skb,
+					      const struct nf_hook_state *state)
+{
+	/* The RX core clears this after netfilter, even with RPS or clones. */
+	if (skb_is_redirected(skb)) {
+		atomic_inc(&ingress_redirected);
+		return NF_ACCEPT;
+	}
+	if (!READ_ONCE(whnat_enable))
+		return NF_ACCEPT;
+
+#ifdef CONFIG_NET_XGRESS
+	/* An unbound return would charge ingress policers a second time. */
+	if (rcu_access_pointer(skb->dev->tcx_ingress)) {
+		atomic_inc(&ingress_tc);
+		return NF_ACCEPT;
+	}
+#endif
+	if (skb_is_gso(skb)) {
+		atomic_inc(&ingress_gso);
+		return NF_ACCEPT;
+	}
+
+	return airoha_whnat_upstream(skb) ? NF_STOLEN : NF_ACCEPT;
+}
+
+static void airoha_whnat_restore_gro(struct airoha_whnat_ingress *ingress,
+				     struct net_device *dev)
+{
+	dev->hw_features |= ingress->hw_gro;
+	dev->wanted_features &= ~AIROHA_WHNAT_GRO_FEATURES;
+	dev->wanted_features |= ingress->wanted_gro;
+	netdev_update_features(dev);
+}
+
+/* Called with RTNL and vif_lock held; feature notifications are ignored. */
+static int airoha_whnat_add_ingress(struct net_device *dev, int idx)
+{
+	struct airoha_whnat_ingress *ingress = &ingress_hooks[idx];
+	int err;
+
+	if (!whnat_ingress || ingress->hook.dev)
+		return 0;
+
+	ingress->wanted_gro = dev->wanted_features & AIROHA_WHNAT_GRO_FEATURES;
+	ingress->hw_gro = dev->hw_features & AIROHA_WHNAT_GRO_FEATURES;
+	dev->wanted_features &= ~AIROHA_WHNAT_GRO_FEATURES;
+	netdev_update_features(dev);
+	if (dev->features & AIROHA_WHNAT_GRO_FEATURES) {
+		err = -EOPNOTSUPP;
+		goto restore;
+	}
+	/* Keep ethtool from re-enabling aggregation while the hook owns RX. */
+	dev->hw_features &= ~AIROHA_WHNAT_GRO_FEATURES;
+	ingress->hook = (struct nf_hook_ops) {
+		.hook = airoha_whnat_ingress_hook,
+		.dev = dev,
+		.pf = NFPROTO_NETDEV,
+		.hooknum = NF_NETDEV_INGRESS,
+		.priority = INT_MIN,
+	};
+	err = nf_register_net_hook(dev_net(dev), &ingress->hook);
+	if (!err)
+		return 0;
+
+	ingress->hook.dev = NULL;
+restore:
+	airoha_whnat_restore_gro(ingress, dev);
+	return err;
+}
+
+static void airoha_whnat_remove_ingress(int idx)
+{
+	struct airoha_whnat_ingress *ingress = &ingress_hooks[idx];
+	struct net_device *dev = ingress->hook.dev;
+
+	if (!dev)
+		return;
+
+	nf_unregister_net_hook(dev_net(dev), &ingress->hook);
+	synchronize_net();
+	ingress->hook.dev = NULL;
+	airoha_whnat_restore_gro(ingress, dev);
+}
+#else
+static int airoha_whnat_add_ingress(struct net_device *dev, int idx)
+{
+	return whnat_ingress ? -EOPNOTSUPP : 0;
+}
+
+static void airoha_whnat_remove_ingress(int idx)
+{
+}
+#endif
 
 bool airoha_whnat_active(void)
 {
@@ -98,6 +242,8 @@ void airoha_whnat_set_ppe(struct airoha_ppe *ppe)
 	int err;
 
 	rcu_assign_pointer(active_ppe, ppe);
+	if (whnat_ingress && !whnat_auto_vifs)
+		pr_warn("airoha: WHNAT ingress requires whnat_auto_vifs=1\n");
 	if (!whnat_auto_vifs)
 		return;
 
@@ -119,6 +265,7 @@ static void airoha_whnat_release_slot(int idx, bool invalidate)
 		return;
 
 	RCU_INIT_POINTER(vifs[idx], NULL);
+	airoha_whnat_remove_ingress(idx);
 	synchronize_net();
 
 	if (invalidate) {
@@ -194,6 +341,9 @@ static int airoha_whnat_register_vif(struct net_device *dev)
 	}
 
 	if (idx >= 0) {
+		idx = airoha_whnat_add_ingress(dev, idx) ?: idx;
+		if (idx < 0)
+			goto out;
 		dev_hold(dev);
 		rcu_assign_pointer(vifs[idx], dev);
 	}
@@ -205,6 +355,9 @@ static int airoha_whnat_register_vif(struct net_device *dev)
 
 int en75_whnat_register_vif(struct net_device *dev)
 {
+	if (whnat_ingress && !whnat_auto_vifs)
+		return -EOPNOTSUPP;
+
 	/* In automatic mode only NETDEV_UP may publish a slot. */
 	if (whnat_auto_vifs)
 		return airoha_whnat_vif_index(dev);
@@ -237,20 +390,17 @@ EXPORT_SYMBOL_GPL(en75_whnat_unregister_vif);
 
 static bool airoha_whnat_eligible(struct net_device *dev)
 {
-	struct wireless_dev *wdev = dev->ieee80211_ptr;
-
-	/* Native airoha netdevs have no wireless_dev. */
-	if (!wdev || dev->type != ARPHRD_ETHER ||
+	/* Do not dereference wireless_dev: cfg80211 may come from backports. */
+	if (!dev->ieee80211_ptr || dev->type != ARPHRD_ETHER ||
 	    netdev_uses_dsa(dev) || dsa_user_dev_check(dev))
 		return false;
 
-	return wdev->iftype == NL80211_IFTYPE_AP ||
-	       wdev->iftype == NL80211_IFTYPE_AP_VLAN ||
-	       wdev->iftype == NL80211_IFTYPE_STATION;
+	/* Notifier teardown replays events with RTNL, without device locks. */
+	return !netdev_need_ops_lock(dev);
 }
 
 static int airoha_whnat_netdev_event(struct notifier_block *nb,
-				    unsigned long event, void *ptr)
+				     unsigned long event, void *ptr)
 {
 	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
 	int idx;
@@ -293,7 +443,7 @@ int airoha_whnat_vif_index(struct net_device *dev)
 	return idx;
 }
 
-bool en75_whnat_upstream_early(struct sk_buff *skb)
+static bool airoha_whnat_upstream(struct sk_buff *skb)
 {
 	struct net_device *vif_dev;
 	struct airoha_qdma *qdma;
@@ -345,6 +495,14 @@ bool en75_whnat_upstream_early(struct sk_buff *skb)
 
 	return taken;
 }
+
+bool en75_whnat_upstream_early(struct sk_buff *skb)
+{
+	if (whnat_ingress)
+		return false;
+
+	return airoha_whnat_upstream(skb);
+}
 EXPORT_SYMBOL_GPL(en75_whnat_upstream_early);
 
 void airoha_whnat_batch_init(struct airoha_whnat_batch *batch)
@@ -468,8 +626,13 @@ bool airoha_whnat_rx(struct sk_buff *skb, struct napi_struct *napi,
 	} else {
 		skb->protocol = eth_type_trans(skb, dev);
 		atomic_inc(&returned);
-		/* Below the mt76 hook: this frame is never offered again. */
-		napi_gro_receive(napi, skb);
+		if (whnat_ingress) {
+			/* Preserve the redirect indication through RPS, without GRO. */
+			skb_set_redirected(skb, true);
+			netif_receive_skb(skb);
+		} else {
+			napi_gro_receive(napi, skb);
+		}
 	}
 	rcu_read_unlock_bh();
 
-- 
