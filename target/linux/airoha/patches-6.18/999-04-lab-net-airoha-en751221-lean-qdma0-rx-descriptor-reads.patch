From: Cristian Papa <pcristian292@gmail.com>
Subject: [PATCH] lab: net: airoha: en751221: read only the QDMA0 RX descriptor words in use

On QDMA0 (LAN and WHNAT downstream) econet_qdma_rx_process_one() only
uses the info word and msg.erx.bitfield_0 (CRSN, SPORT, PPE entry and
the IP/L4 flags) of a descriptor; word 0 of the message is only read
for QDMA1 (xPON OAM and GEM). Copying the whole 32-byte descriptor cost
eight uncached loads per frame on napi/qdma_eth-0, which is the thread
that limits WiFi download and whose ring 1 overflows into GDM drops,
plus a pkt_addr store that the refill rewrites anyway.

With rx_lean_desc=Y, read just those two words on QDMA0 and skip the
store. QDMA1 keeps the full copy. On by default: an A/B on the XR500v
(TCP download through WHNAT, same 493 Mbit/s) gave -2.0 points of total
CPU, -3.7 points on napi/qdma_eth-0 and 19 % fewer TCP retransmissions;
N restores the full copy.

Signed-off-by: Cristian Papa <pcristian292@gmail.com>
---
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -420,6 +420,19 @@
 module_param_array(rx_overflow, uint, NULL, 0444);
 MODULE_PARM_DESC(rx_overflow, "EN751221 RX descriptors with the overflow bit, dropped, per QDMA");
 
+/*
+ * lab: on QDMA0 (LAN/WHNAT) the RX path only uses the info word and
+ * msg.erx.bitfield_0 of a descriptor; the other words matter for QDMA1
+ * (xPON OAM and GEM) only. Copying the whole descriptor costs eight
+ * uncached loads per frame on the thread that empties ring 1, and the
+ * pkt_addr clear is rewritten by the refill anyway. On by default since the
+ * A/B of 1-nov-2026 (-2 pts of CPU, -3.7 pts on napi/qdma_eth-0 at the same
+ * WiFi download rate); N restores the full copy.
+ */
+static bool rx_lean_desc = true;
+module_param(rx_lean_desc, bool, 0644);
+MODULE_PARM_DESC(rx_lean_desc, "lab: EN751221 QDMA0 RX reads only the descriptor words it uses");
+
 static void econet_qdma_rx_process_one(struct econet_q_rx *q, u32 cpu_i,
 				     enum dma_data_direction dir,
 				     struct airoha_whnat_batch *batch)
@@ -431,11 +444,22 @@
 	struct page *page;
 	struct desc desc;
 	u16 ingress_gem;
+	bool lean;
 	u32 hash;
 	u8 sport, reason;
 	int len;
 
-	memcpy(&desc, &q->desc[cpu_i], sizeof(desc));
+	lean = READ_ONCE(rx_lean_desc) && q->qdma->qdma->id == 0 &&
+	       airoha_is(eth, econet_en751221);
+	if (lean) {
+		/* DONE was seen and dma_rmb() issued by econet_rx_desc_ready(). */
+		memset(&desc, 0, sizeof(desc));
+		desc.info.word = READ_ONCE(q->desc[cpu_i].info.word);
+		desc.msg.erx.bitfield_0 =
+			READ_ONCE(q->desc[cpu_i].msg.erx.bitfield_0);
+	} else {
+		memcpy(&desc, &q->desc[cpu_i], sizeof(desc));
+	}
 
 	dma_sync_single_for_cpu(q->qdma->qdma->eth->dev, e->dma_addr, e->dma_len, dir);
 
@@ -443,7 +467,8 @@
 	e->dma_addr = 0;
 
 	/* Make debug more readable */
-	WRITE_ONCE(q->desc[cpu_i].pkt_addr, 0);
+	if (!lean)
+		WRITE_ONCE(q->desc[cpu_i].pkt_addr, 0);
 
 	len = get_desc_info_pkt_len(&desc.info);
 	if (!len || len > SKB_WITH_OVERHEAD(q->buf_size) - headroom -
