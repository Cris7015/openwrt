From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Thu, 5 Nov 2026 13:02:22 -0300
Subject: [PATCH 04/48] net: xpon: omci: send the dying gasp without waiting
 for the agent lock

The dying gasp notification only needs the agent enable flags and the
alarm sequence number, but it took agent->lock to read them. The OMCI
worker holds that mutex across a whole request, hardware programming and
service reconciliation included, and the PM work holds it while it polls
the per-GEM counters, so a dying gasp raised meanwhile waited for them
while the hold-up capacitance drained.

Give the alarm sequence number its own spinlock, read the two flags with
READ_ONCE() (their writers now use WRITE_ONCE()), and leave agent->lock
out of the dying gasp path.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 net/xpon/omci/agent.c    | 37 ++++++++++++++++++++++++-------------
 net/xpon/omci/internal.h |  2 ++
 2 files changed, 26 insertions(+), 13 deletions(-)

diff --git a/net/xpon/omci/agent.c b/net/xpon/omci/agent.c
index 4cbc71d..9f025d3 100644
--- a/net/xpon/omci/agent.c
+++ b/net/xpon/omci/agent.c
@@ -719,6 +719,13 @@ static void omci_agent_increment_mib_sync_locked(struct omci_agent *agent)
 	omci_agent_set_mib_sync_locked(agent, sync ? sync : 1);
 }
 
+static void omci_agent_reset_alarm_sequence(struct omci_agent *agent)
+{
+	spin_lock(&agent->alarm_lock);
+	agent->alarm_sequence = 0;
+	spin_unlock(&agent->alarm_lock);
+}
+
 static int omci_mib_store_locked(struct omci_agent *agent,
 				 const struct omci_mib_object *source)
 {
@@ -1894,6 +1901,7 @@ int omci_agent_init(struct omci_device *odev)
 	mutex_init(&agent->lock);
 	xa_init(&agent->mib);
 	xa_init(&agent->services);
+	spin_lock_init(&agent->alarm_lock);
 	agent->enabled = true;
 	agent->permissive = false;
 	agent->fake_omci = false;
@@ -2667,7 +2675,7 @@ static int omci_agent_mib_reset_locked(struct omci_device *odev, bool all,
 
 	omci_agent_set_mib_sync_locked(agent, 0);
 	agent->upload_index = 0;
-	agent->alarm_sequence = 0;
+	omci_agent_reset_alarm_sequence(agent);
 	omci_agent_reset_duplicate_locked(agent);
 
 	/*
@@ -4732,7 +4740,7 @@ omci_agent_build_response_locked(struct omci_device *odev,
 		 * Get all alarms resynchronises the OLT with the alarm state;
 		 * the next notification starts the sequence again at 1.
 		 */
-		agent->alarm_sequence = 0;
+		omci_agent_reset_alarm_sequence(agent);
 		content[0] = OMCI_RESULT_SUCCESS;
 		put_unaligned_be16(0, content + 1);
 		*content_len = 3;
@@ -4954,16 +4962,19 @@ int omci_agent_send_dying_gasp(struct omci_device *odev)
 	bool enabled;
 	int ret;
 
-	mutex_lock(&agent->lock);
-	enabled = agent->enabled && agent->dying_gasp;
-	if (enabled) {
-		sequence = ++agent->alarm_sequence;
-		if (!sequence)
-			sequence = ++agent->alarm_sequence;
-	}
-	mutex_unlock(&agent->lock);
+	/*
+	 * The supply is going away: do not queue behind agent->lock, which
+	 * the OMCI worker holds across a whole request including hardware
+	 * programming, and the PM work across a GEM counter poll.
+	 */
+	enabled = READ_ONCE(agent->enabled) && READ_ONCE(agent->dying_gasp);
 	if (!enabled)
 		return -EOPNOTSUPP;
+	spin_lock(&agent->alarm_lock);
+	sequence = ++agent->alarm_sequence;
+	if (!sequence)
+		sequence = ++agent->alarm_sequence;
+	spin_unlock(&agent->alarm_lock);
 
 	pdu[2] = OMCI_MSG_TYPE_ALARM_NOTIFICATION;
 	pdu[3] = OMCI_BASELINE_DEV_ID;
@@ -4995,7 +5006,7 @@ void omci_agent_channel_changed(struct omci_device *odev, bool valid)
 	omci_agent_reset_table_snapshot_locked(agent);
 	agent->upload_index = 0;
 	if (!valid) {
-		agent->alarm_sequence = 0;
+		omci_agent_reset_alarm_sequence(agent);
 		omci_agent_clear_services_locked(odev);
 	} else {
 		omci_agent_reconcile_services_locked(odev);
@@ -5338,7 +5349,7 @@ __omci_agent_config_set_source(struct omci_device *odev, u16 key,
 		}
 		scalar = *(const u8 *)value;
 		changed = agent->dying_gasp != !!scalar;
-		agent->dying_gasp = !!scalar;
+		WRITE_ONCE(agent->dying_gasp, !!scalar);
 		agent->config.dying_gasp_source = source;
 		omci_agent_reset_duplicate_locked(agent);
 		break;
@@ -5395,7 +5406,7 @@ __omci_agent_config_set_source(struct omci_device *odev, u16 key,
 			agent->config.uni_count = scalar;
 		} else if (key == OMCI_CONFIG_AGENT_ENABLED) {
 			changed = agent->enabled != !!scalar;
-			agent->enabled = !!scalar;
+			WRITE_ONCE(agent->enabled, !!scalar);
 			if (!agent->enabled && agent->operational) {
 				agent->operational = false;
 				operational_changed = true;
diff --git a/net/xpon/omci/internal.h b/net/xpon/omci/internal.h
index 37adfcc..306ce00 100644
--- a/net/xpon/omci/internal.h
+++ b/net/xpon/omci/internal.h
@@ -141,6 +141,8 @@ struct omci_agent {
 	u8 pm_interval;
 	bool pm_synchronized;
 	bool operational;
+	/* Protects alarm_sequence, so a dying gasp never waits for @lock. */
+	spinlock_t alarm_lock;
 	u8 alarm_sequence;
 	u8 profile_effective;
 	u32 profile_quirks;
