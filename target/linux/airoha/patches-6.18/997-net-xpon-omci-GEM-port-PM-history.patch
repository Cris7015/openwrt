+/*
+ * GEM port network CTP performance monitoring history data (G.988 9.2.13,
+ * ME 341) on the 15-min interval clock of G.988 clause I.4.
+ *
+ * The MAC keeps free-running totals per GEM port. Each instance remembers
+ * the totals at the start of the current interval; when the interval
+ * closes the difference becomes the history attributes, so Get returns the
+ * counts of the last completed interval and Get current data the running
+ * counts. Interval end time numbers the last completed interval: 0 after
+ * Synchronize time, then one more every 15 min, modulo 256. An instance
+ * created later takes the current number and counts from its creation.
+ *
+ * The ME ID is that of the GEM port network CTP, whose Port-ID attribute
+ * names the GEM port. Transmitted counts are upstream, received counts
+ * downstream. Encryption key errors exist on G.987 systems only and stay 0.
+ */
+#define OMCI_GEM_PM_END_TIME_OFFSET	0
+#define OMCI_GEM_PM_THRESHOLD_OFFSET	1
+#define OMCI_GEM_PM_COUNTERS_OFFSET	3
+#define OMCI_GEM_PM_DATA_LEN		31
+#define OMCI_GEM_PM_NO_PORT		U16_MAX
+
+/* Baseline Get response: 25 attribute bytes, then the two failure masks */
+#define OMCI_BASELINE_CONTENT_LEN	32
+#define OMCI_BASELINE_GET_ATTR_OFFSET	3
+#define OMCI_BASELINE_GET_ATTR_LEN	25
+#define OMCI_BASELINE_GET_OPT_MASK	28
+#define OMCI_BASELINE_GET_EXEC_MASK	30
+/* Extended Get response: result, attribute mask, both failure masks */
+#define OMCI_EXTENDED_GET_ATTR_OFFSET	7
+
+#define omci_for_each_gem_pm(_agent, _index, _object) \
+	xa_for_each_range(&(_agent)->mib, _index, _object, \
+			  omci_mib_key(OMCI_CLASS_GEM_PORT_CTP_PM, 0), \
+			  omci_mib_key(OMCI_CLASS_GEM_PORT_CTP_PM, U16_MAX)) \
+		if ((_object)->pending_delete) {} else
+
+static int omci_gem_pm_counter(u16 mask)
+{
+	switch (mask) {
+	case BIT(13):
+		return OMCI_GEM_PM_TX_FRAMES;
+	case BIT(12):
+		return OMCI_GEM_PM_RX_FRAMES;
+	case BIT(11):
+		return OMCI_GEM_PM_RX_BYTES;
+	case BIT(10):
+		return OMCI_GEM_PM_TX_BYTES;
+	default:
+		return -1;
+	}
+}
+
+static const struct omci_attr_desc *
+omci_gem_pm_attr(const struct omci_me_desc *desc, u16 mask)
+{
+	unsigned int i;
+
+	for (i = 0; i < desc->num_attrs; i++)
+		if (desc->attrs[i].mask == mask)
+			return &desc->attrs[i];
+
+	return NULL;
+}
+
+/* PM counters saturate at their maximum instead of wrapping (G.988 I.4). */
+static void omci_gem_pm_put_counter(u8 *dest, u8 len, u64 value)
+{
+	if (len == sizeof(u32))
+		put_unaligned_be32(min_t(u64, value, U32_MAX), dest);
+	else if (len == sizeof(u64))
+		put_unaligned_be64(value, dest);
+}
+
+static u64 omci_gem_pm_current(const struct omci_gem_pm *pm,
+			       unsigned int counter)
+{
+	u64 value = pm->count[counter];
+
+	if (pm->sampled)
+		value += pm->last[counter] - pm->base[counter];
+
+	return value;
+}
+
+static void omci_gem_pm_fold(struct omci_gem_pm *pm)
+{
+	unsigned int i;
+
+	for (i = 0; i < OMCI_GEM_PM_COUNTERS; i++)
+		pm->count[i] += pm->last[i] - pm->base[i];
+}
+
+static u16 omci_gem_pm_port_locked(struct omci_agent *agent, u16 entity_id)
+{
+	const struct omci_mib_object *ctp;
+
+	ctp = omci_mib_lookup(agent, OMCI_CLASS_GEM_PORT_CTP, entity_id);
+
+	return ctp ? get_unaligned_be16(ctp->data) : OMCI_GEM_PM_NO_PORT;
+}
+
+/*
+ * Fold one sample of the MAC totals into @pm. @known tells whether the MAC
+ * answered at all: a GEM port it does not count only shows up again with
+ * totals that restarted after this point.
+ */
+static void omci_gem_pm_apply(struct omci_gem_pm *pm,
+			      const struct omci_gem_counters *counters,
+			      bool known)
+{
+	u64 now[OMCI_GEM_PM_COUNTERS];
+
+	if (!counters->valid) {
+		if (known)
+			pm->waiting = true;
+		return;
+	}
+
+	now[OMCI_GEM_PM_TX_FRAMES] = counters->tx_frames;
+	now[OMCI_GEM_PM_RX_FRAMES] = counters->rx_frames;
+	now[OMCI_GEM_PM_RX_BYTES] = counters->rx_bytes;
+	now[OMCI_GEM_PM_TX_BYTES] = counters->tx_bytes;
+
+	if (pm->sampled && pm->gem_port_id == counters->gem_port_id) {
+		if (pm->generation == counters->generation) {
+			memcpy(pm->last, now, sizeof(pm->last));
+			return;
+		}
+		/* The totals restarted from zero after the last sample. */
+		omci_gem_pm_fold(pm);
+		memset(pm->base, 0, sizeof(pm->base));
+	} else if (pm->sampled) {
+		/* The CTP names another GEM port now; count it from here. */
+		omci_gem_pm_fold(pm);
+		memcpy(pm->base, now, sizeof(pm->base));
+	} else if (pm->waiting) {
+		/* The GEM port appeared after the interval started. */
+		memset(pm->base, 0, sizeof(pm->base));
+	} else {
+		memcpy(pm->base, now, sizeof(pm->base));
+	}
+	memcpy(pm->last, now, sizeof(pm->last));
+	pm->generation = counters->generation;
+	pm->gem_port_id = counters->gem_port_id;
+	pm->sampled = true;
+	pm->waiting = false;
+}
+
+/* Sample every ME 341 instance; instances not yet on the clock join it. */
+static void omci_gem_pm_sample_locked(struct omci_device *odev)
+{
+	struct omci_agent *agent = &odev->agent;
+	struct omci_gem_counters *counters;
+	struct omci_mib_object *object;
+	unsigned int count = 0;
+	unsigned int i = 0;
+	unsigned long index;
+	bool known;
+
+	lockdep_assert_held(&agent->lock);
+	omci_for_each_gem_pm(agent, index, object)
+		count++;
+	if (!count)
+		return;
+
+	counters = kcalloc(count, sizeof(*counters), GFP_KERNEL);
+	if (!counters)
+		return;
+
+	omci_for_each_gem_pm(agent, index, object) {
+		struct omci_gem_pm *pm = &object->gem_pm;
+
+		if (i == count)
+			break;
+		if (!pm->started) {
+			object->data[OMCI_GEM_PM_END_TIME_OFFSET] =
+				agent->pm_interval;
+			if (object->data_len < OMCI_GEM_PM_DATA_LEN)
+				object->data_len = OMCI_GEM_PM_DATA_LEN;
+			pm->started = true;
+		}
+		counters[i++].gem_port_id =
+			omci_gem_pm_port_locked(agent, object->entity_id);
+	}
+	count = i;
+
+	known = odev->ops->get_gem_counters &&
+		!odev->ops->get_gem_counters(odev, counters, count);
+
+	i = 0;
+	omci_for_each_gem_pm(agent, index, object) {
+		if (i == count)
+			break;
+		omci_gem_pm_apply(&object->gem_pm, &counters[i++], known);
+	}
+	agent->pm_sample_jiffies = jiffies;
+	kfree(counters);
+}
+
+/* The interval just closed: its counts become the history attributes. */
+static void omci_gem_pm_close_locked(struct omci_agent *agent,
+				     const struct omci_me_desc *desc,
+				     struct omci_mib_object *object)
+{
+	struct omci_gem_pm *pm = &object->gem_pm;
+	unsigned int i;
+
+	for (i = 0; i < desc->num_attrs; i++) {
+		const struct omci_attr_desc *attr = &desc->attrs[i];
+		int counter = omci_gem_pm_counter(attr->mask);
+
+		if (counter < 0)
+			continue;
+		omci_gem_pm_put_counter(object->data + attr->offset, attr->len,
+					omci_gem_pm_current(pm, counter));
+	}
+	object->data[OMCI_GEM_PM_END_TIME_OFFSET] = agent->pm_interval;
+	memset(pm->count, 0, sizeof(pm->count));
+	if (pm->sampled)
+		memcpy(pm->base, pm->last, sizeof(pm->base));
+}
+
+/* Close the current interval if its end has passed. */
+static void omci_pm_tick_locked(struct omci_device *odev)
+{
+	struct omci_agent *agent = &odev->agent;
+	const struct omci_me_desc *desc;
+	struct omci_mib_object *object;
+	unsigned long index;
+
+	lockdep_assert_held(&agent->lock);
+	if (time_before(jiffies, agent->pm_interval_end))
+		return;
+
+	omci_gem_pm_sample_locked(odev);
+	agent->pm_interval++;
+	desc = omci_me_lookup(agent, OMCI_CLASS_GEM_PORT_CTP_PM);
+	omci_for_each_gem_pm(agent, index, object) {
+		if (desc && object->gem_pm.started)
+			omci_gem_pm_close_locked(agent, desc, object);
+	}
+
+	agent->pm_interval_end += OMCI_PM_INTERVAL;
+	/* More than a whole interval late: start the next one now. */
+	if (!time_before(jiffies, agent->pm_interval_end))
+		agent->pm_interval_end = jiffies + OMCI_PM_INTERVAL;
+}
+
+static unsigned long omci_pm_delay_locked(struct omci_agent *agent)
+{
+	unsigned long now = jiffies;
+
+	if (!time_before(now, agent->pm_interval_end))
+		return 0;
+
+	return min_t(unsigned long, agent->pm_interval_end - now,
+		     OMCI_PM_SAMPLE_INTERVAL);
+}
+
+static void omci_pm_work(struct work_struct *work)
+{
+	struct omci_agent *agent = container_of(to_delayed_work(work),
+						struct omci_agent, pm_work);
+	struct omci_device *odev = container_of(agent, struct omci_device,
+						agent);
+	unsigned long delay;
+
+	mutex_lock(&agent->lock);
+	if (time_before(jiffies, agent->pm_interval_end))
+		omci_gem_pm_sample_locked(odev);
+	else
+		omci_pm_tick_locked(odev);
+	delay = omci_pm_delay_locked(agent);
+	mutex_unlock(&agent->lock);
+
+	queue_delayed_work(system_power_efficient_wq, &agent->pm_work, delay);
+}
+
+/*
+ * Synchronize time aligns the interval clock with the OLT: interval 0
+ * starts now and every PM counter restarts from 0.
+ */
+static void omci_pm_synchronize_locked(struct omci_device *odev)
+{
+	struct omci_agent *agent = &odev->agent;
+	struct omci_mib_object *object;
+	unsigned long index;
+
+	omci_gem_pm_sample_locked(odev);
+	agent->pm_interval = 0;
+	agent->pm_interval_end = jiffies + OMCI_PM_INTERVAL;
+	agent->pm_synchronized = true;
+	agent->pm_syncs++;
+
+	omci_for_each_gem_pm(agent, index, object) {
+		struct omci_gem_pm *pm = &object->gem_pm;
+
+		object->data[OMCI_GEM_PM_END_TIME_OFFSET] = 0;
+		memset(object->data + OMCI_GEM_PM_COUNTERS_OFFSET, 0,
+		       OMCI_GEM_PM_DATA_LEN - OMCI_GEM_PM_COUNTERS_OFFSET);
+		memset(pm->count, 0, sizeof(pm->count));
+		if (pm->sampled)
+			memcpy(pm->base, pm->last, sizeof(pm->base));
+	}
+
+	mod_delayed_work(system_power_efficient_wq, &agent->pm_work,
+			 omci_pm_delay_locked(agent));
+}
+
+/*
+ * Get and Get current data on ME 341. Get returns the history attributes
+ * of the last completed interval, Get current data the running counts of
+ * the current one. Attributes that do not fit the response come back in
+ * the attribute execution mask with result 9, so the OLT can ask for them
+ * again; a baseline response has room for 25 attribute bytes.
+ */
+static u8 omci_gem_pm_get_locked(struct omci_device *odev,
+				 const struct omci_wire_request *request,
+				 u8 action, u8 *content, size_t capacity,
+				 size_t *content_len)
+{
+	bool extended = request->device_id == OMCI_EXTENDED_DEV_ID;
+	bool current_data = action == OMCI_MSG_TYPE_GET_CURRENT_DATA;
+	struct omci_agent *agent = &odev->agent;
+	const struct omci_me_desc *desc;
+	struct omci_mib_object *object;
+	u16 encoded = 0, failed = 0;
+	u16 unsupported;
+	size_t used = 0;
+	size_t room;
+	u8 *values;
+	u16 mask;
+	int bit;
+
+	if (request->payload_len < 2)
+		return OMCI_RESULT_PARAMETER_ERROR;
+	if (capacity < (extended ? OMCI_EXTENDED_GET_ATTR_OFFSET :
+				   OMCI_BASELINE_CONTENT_LEN))
+		return OMCI_RESULT_PARAMETER_ERROR;
+	desc = omci_me_lookup(agent, OMCI_CLASS_GEM_PORT_CTP_PM);
+	if (!desc || !(desc->actions & (current_data ?
+					OMCI_ME_ACTION_GET_CURRENT_DATA :
+					OMCI_ME_ACTION_GET)))
+		return OMCI_RESULT_NOT_SUPPORTED;
+
+	mask = get_unaligned_be16(request->payload);
+	object = omci_get_or_create_locked(agent, OMCI_CLASS_GEM_PORT_CTP_PM,
+					   request->entity_id,
+					   agent->permissive ||
+					   agent->fake_omci);
+	if (!object)
+		return OMCI_RESULT_UNKNOWN_INSTANCE;
+
+	/* Do not serve a closed interval the work has not got to yet. */
+	omci_pm_tick_locked(odev);
+	if (current_data || !object->gem_pm.started)
+		omci_gem_pm_sample_locked(odev);
+
+	if (extended) {
+		values = content + OMCI_EXTENDED_GET_ATTR_OFFSET;
+		room = capacity - OMCI_EXTENDED_GET_ATTR_OFFSET;
+	} else {
+		values = content + OMCI_BASELINE_GET_ATTR_OFFSET;
+		room = OMCI_BASELINE_GET_ATTR_LEN;
+	}
+
+	unsupported = mask & ~desc->valid_attr_mask;
+	for (bit = 15; bit >= 0; bit--) {
+		const struct omci_attr_desc *attr;
+		u16 attr_mask = BIT(bit);
+		int counter;
+
+		if (!(mask & attr_mask) || (unsupported & attr_mask))
+			continue;
+		attr = omci_gem_pm_attr(desc, attr_mask);
+		if (!attr) {
+			unsupported |= attr_mask;
+			continue;
+		}
+		if (attr->len > room - used) {
+			failed |= attr_mask;
+			continue;
+		}
+		counter = omci_gem_pm_counter(attr_mask);
+		if (current_data && counter >= 0)
+			omci_gem_pm_put_counter(values + used, attr->len,
+				omci_gem_pm_current(&object->gem_pm, counter));
+		else
+			memcpy(values + used, object->data + attr->offset,
+			       attr->len);
+		used += attr->len;
+		encoded |= attr_mask;
+	}
+
+	content[0] = failed || unsupported ? OMCI_RESULT_ATTRIBUTE_FAILED :
+					     OMCI_RESULT_SUCCESS;
+	put_unaligned_be16(encoded, content + 1);
+	if (extended) {
+		put_unaligned_be16(unsupported, content + 3);
+		put_unaligned_be16(failed, content + 5);
+		*content_len = OMCI_EXTENDED_GET_ATTR_OFFSET + used;
+	} else {
+		put_unaligned_be16(unsupported,
+				   content + OMCI_BASELINE_GET_OPT_MASK);
+		put_unaligned_be16(failed, content + OMCI_BASELINE_GET_EXEC_MASK);
+		*content_len = OMCI_BASELINE_CONTENT_LEN;
+	}
+
+	return content[0];
+}
+
+ssize_t omci_agent_gem_pm_show(struct omci_device *odev, char *buf)
+{
+	struct omci_agent *agent = &odev->agent;
+	struct omci_mib_object *object;
+	unsigned long index;
+	unsigned long now;
+	int len;
+
+	mutex_lock(&agent->lock);
+	now = jiffies;
+	len = sysfs_emit(buf,
+			 "synchronized=%u syncs=%u interval=%u next_close=%us last_sample=%ds\n",
+			 agent->pm_synchronized, agent->pm_syncs,
+			 agent->pm_interval,
+			 time_before(now, agent->pm_interval_end) ?
+			 jiffies_to_msecs(agent->pm_interval_end - now) / 1000 :
+			 0,
+			 agent->pm_sample_jiffies ?
+			 (int)(jiffies_to_msecs(now - agent->pm_sample_jiffies) /
+			       1000) : -1);
+	/* History attributes as stored, see omci_gem_port_ctp_pm_attrs */
+	omci_for_each_gem_pm(agent, index, object) {
+		const struct omci_gem_pm *pm = &object->gem_pm;
+		const u8 *data = object->data;
+
+		len += sysfs_emit_at(buf, len,
+				     "me=%#06x gem=%u end=%u threshold=%#06x tx_frames=%u rx_frames=%u rx_bytes=%llu tx_bytes=%llu cur_tx_frames=%llu cur_rx_frames=%llu cur_rx_bytes=%llu cur_tx_bytes=%llu\n",
+				     object->entity_id,
+				     omci_gem_pm_port_locked(agent,
+							     object->entity_id),
+				     data[OMCI_GEM_PM_END_TIME_OFFSET],
+				     get_unaligned_be16(data +
+					OMCI_GEM_PM_THRESHOLD_OFFSET),
+				     get_unaligned_be32(data + 3),
+				     get_unaligned_be32(data + 7),
+				     get_unaligned_be64(data + 11),
+				     get_unaligned_be64(data + 19),
+				     omci_gem_pm_current(pm, OMCI_GEM_PM_TX_FRAMES),
+				     omci_gem_pm_current(pm, OMCI_GEM_PM_RX_FRAMES),
+				     omci_gem_pm_current(pm, OMCI_GEM_PM_RX_BYTES),
+				     omci_gem_pm_current(pm, OMCI_GEM_PM_TX_BYTES));
+	}
+	mutex_unlock(&agent->lock);
+
+	return len;
+}
