+/*
+ * Per-GEM totals for OMCI performance monitoring (G.988 ME 341). The MIB
+ * is folded in first, so the totals are current to the call. Process
+ * context only: gem_mib_lock is a mutex and the MIB window is polled.
+ */
+int airoha_gpon_omci_hw_get_gem_counters(void *hw_priv,
+					 struct omci_gem_counters *counters,
+					 unsigned int count)
+{
+	struct xpon_priv *priv = hw_priv;
+	unsigned int i, j;
+
+	might_sleep();
+	for (i = 0; i < count; i++)
+		counters[i].valid = false;
+
+	mutex_lock(&priv->gem_mib_lock);
+	if (!priv->gem_mib_enabled) {
+		mutex_unlock(&priv->gem_mib_lock);
+		return -EOPNOTSUPP;
+	}
+	gpon_mib_accumulate_locked(priv);
+	for (i = 0; i < count; i++) {
+		struct omci_gem_counters *c = &counters[i];
+
+		if (c->gem_port_id >= GPON_MAX_GEM_ID)
+			continue;
+		for (j = 0; j < GPON_GEM_MIB_SLOTS; j++) {
+			const struct gpon_gem_mib *m = &priv->gem_mib[j];
+
+			if (m->gem != c->gem_port_id)
+				continue;
+			c->generation = m->generation;
+			c->rx_frames = m->total[GPON_MIB_RX_FRAMES];
+			c->rx_bytes = m->total[GPON_MIB_RX_BYTES];
+			c->tx_frames = m->total[GPON_MIB_TX_FRAMES];
+			c->tx_bytes = m->total[GPON_MIB_TX_BYTES];
+			c->valid = true;
+			break;
+		}
+	}
+	mutex_unlock(&priv->gem_mib_lock);
+
+	return 0;
+}
