From aee73c897bf7c345b30b18b990089e007153ca95 Mon Sep 17 00:00:00 2001
From: Codex <codex@localhost>
Date: Mon, 19 Oct 2026 19:42:03 -0300
Subject: [PATCH] net: airoha: keep bounded GPON metadata before Deactivate

Keep two fixed RAM rings of IRQ, PLOAM metadata, state and cached counters.
Freeze one bank before shutdown and print a bounded tail from a separate
worker after a delay. Expose private snapshots through read-only debugfs.

Do not log payloads or add counter reads. Preserve the PLOAM TX critical
section from the prerequisite serialization patch. Recording adds bounded
CPU work; hardware timing has not been validated.
---
 drivers/net/ethernet/airoha/airoha_ploam.c    |  12 +-
 drivers/net/ethernet/airoha/airoha_ploam.h    |   3 +
 drivers/net/ethernet/airoha/airoha_xpon.c     |  61 ++-
 drivers/net/ethernet/airoha/airoha_xpon.h     |   3 +
 .../ethernet/airoha/airoha_xpon_blackbox.h    | 466 ++++++++++++++++++
 5 files changed, 526 insertions(+), 19 deletions(-)
 create mode 100644 drivers/net/ethernet/airoha/airoha_xpon_blackbox.h

diff --git a/drivers/net/ethernet/airoha/airoha_ploam.c b/drivers/net/ethernet/airoha/airoha_ploam.c
index bc0478a..6137733 100644
--- a/drivers/net/ethernet/airoha/airoha_ploam.c
+++ b/drivers/net/ethernet/airoha/airoha_ploam.c
@@ -665,12 +665,20 @@ void ploam_handle_downstream(struct ploam_priv *pp,
 	ploam_unpack(msg, &onu_id, &type, content);
 
 	/* Drop messages not addressed to us */
-	if (onu_id != PLOAM_ONU_BCAST && onu_id != pp->onu_id)
+	if (onu_id != PLOAM_ONU_BCAST && onu_id != pp->onu_id) {
+		if (pp->ops->rx_trace)
+			pp->ops->rx_trace(pp->hw_priv, type, onu_id, 0);
 		return;
+	}
 
 	/* EN7521 deduplication filter */
-	if (ploam_filter_suppress(pp, msg, type))
+	if (ploam_filter_suppress(pp, msg, type)) {
+		if (pp->ops->rx_trace)
+			pp->ops->rx_trace(pp->hw_priv, type, onu_id, 1);
 		return;
+	}
+	if (pp->ops->rx_trace)
+		pp->ops->rx_trace(pp->hw_priv, type, onu_id, 2);
 
 	switch (type) {
 	case PLOAM_DOWN_UPSTREAM_OVERHEAD:
diff --git a/drivers/net/ethernet/airoha/airoha_ploam.h b/drivers/net/ethernet/airoha/airoha_ploam.h
index 86a6af2..5f580a3 100644
--- a/drivers/net/ethernet/airoha/airoha_ploam.h
+++ b/drivers/net/ethernet/airoha/airoha_ploam.h
@@ -88,6 +88,7 @@ struct ploam_msg {
 /**
  * struct ploam_ops - callbacks from the PLOAM layer to the hardware layer
  *
+ * @rx_trace: optional metadata-only receive observer.
  * @send_upstream: write @times copies of upstream PLOAM to the TX FIFO.
  * @set_onu_id: program the OLT-assigned ONU-ID into G_ONU_ID.
  * @set_eqd_o4: program equalization delay in O4; byteDelay = eqd & ~7,
@@ -114,6 +115,8 @@ struct ploam_msg {
  * @deactivate: OLT sent Deactivate_ONU; trigger a full hardware disable/reset.
  */
 struct ploam_ops {
+	/* Observer only: 0=other ONU, 1=duplicate, 2=dispatch; no payload. */
+	void (*rx_trace)(void *hw_priv, u8 type, u8 onu_id, u8 result);
 	void (*send_upstream)(void *priv, const struct ploam_msg *msg, int times);
 	void (*set_onu_id)(void *priv, u8 onu_id);
 	void (*set_eqd_o4)(void *priv, u32 byte_delay, u32 bit_delay);
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.c b/drivers/net/ethernet/airoha/airoha_xpon.c
index 69ff806..ab0ba89 100644
--- a/drivers/net/ethernet/airoha/airoha_xpon.c
+++ b/drivers/net/ethernet/airoha/airoha_xpon.c
@@ -63,6 +63,8 @@ static const u8 airoha_default_vendor_id[4] = {'M', 'T', 'K', 'G'};
 
 static inline u32 gpon_read(struct xpon_priv *priv, u32 reg);
 
+#include "airoha_xpon_blackbox.h"
+
 static int airoha_xpon_tx_timing_calibrate(struct xpon_priv *priv)
 {
 	int restore_ret, ret;
@@ -486,6 +488,11 @@ static inline u32 gpon_read(struct xpon_priv *priv, u32 reg)
 static inline void gpon_write(struct xpon_priv *priv, u32 reg, u32 val)
 {
 	writel(val, priv->gpon_reg + reg);
+	if (reg == GPON_RSP_TIME || reg == GPON_EQD) {
+		gpon_bb_cache_value(priv, reg == GPON_RSP_TIME ? GPON_BB_RSP :
+				    GPON_BB_EQD, val);
+		gpon_bb_record(priv, GPON_BB_CFG, reg, val, 0, 0);
+	}
 }
 
 static inline void gpon_set_bits(struct xpon_priv *priv, u32 reg, u32 bits)
@@ -1197,20 +1204,18 @@ static void gpon_hw_send_ploam(struct xpon_priv *priv,
 			dev_dbg_ratelimited(priv->dev,
 					    "dropping PLOAM type %#04x while PHY ready=%u LOS=%u\n",
 					     type, ready, los);
+			gpon_bb_record(priv, GPON_BB_TX, type, 0, -ENOLINK, 0);
 			return;
 		}
 	}
 
-	if (type != PLOAM_UP_REI)
-		dev_dbg(priv->dev,
-			"PLOAM TX: onu=%u type=%#04x copies=%d words=%08x/%08x/%08x\n",
-			onu_id, type, times, msg->value[0], msg->value[1], msg->value[2]);
-
 	for (t = 0; t < times; t++) {
 		u32 avail;
 		int ret;
 
+		gpon_bb_record(priv, GPON_BB_TX_BEGIN, type, t + 1, 0, onu_id);
 		ret = gpon_send_ploam_copy(priv, msg, &avail);
+		gpon_bb_record(priv, GPON_BB_TX, type, t + 1, ret, avail);
 		if (ret) {
 			dev_warn_ratelimited(priv->dev,
 					     "PLOAM TX FIFO timeout: avail=%u requested_words=%u copy=%d/%d\n",
@@ -1235,10 +1240,18 @@ static bool gpon_ploam_rx_queue_push(struct xpon_priv *priv,
 	/* Pairs with the consumer release when it advances the tail. */
 	if (next == smp_load_acquire(&priv->ploam_rx_tail)) {
 		priv->ploam_rx_drops++;
+		gpon_bb_record(priv, GPON_BB_RX_FIFO,
+			       (msg->value[0] >> 16) & 0xff, msg->value[0] >> 24,
+			       0, 0);
 		return false;
 	}
 
 	priv->ploam_rx_queue[head] = *msg;
+	/* Only the assigned numeric ONU-ID is retained, never its serial. */
+	gpon_bb_record(priv, GPON_BB_RX_FIFO,
+		       (msg->value[0] >> 16) & 0xff, msg->value[0] >> 24, 1,
+		       ((msg->value[0] >> 16) & 0xff) == PLOAM_DOWN_ASSIGN_ONU_ID ?
+		       (msg->value[0] >> 8) & 0xff : 0);
 	/* Publish the message before making the new head visible. */
 	smp_store_release(&priv->ploam_rx_head, next);
 	priv->ploam_rx_messages++;
@@ -1329,10 +1342,6 @@ static void gpon_process_ploam_queue(struct xpon_priv *priv)
 	struct ploam_msg msg;
 
 	while (gpon_ploam_rx_queue_pop(priv, &msg)) {
-		dev_dbg(priv->dev,
-			"PLOAM RX: onu=%u type=%#04x words=%08x/%08x/%08x\n",
-			msg.value[0] >> 24, (msg.value[0] >> 16) & 0xff,
-			msg.value[0], msg.value[1], msg.value[2]);
 		ploam_handle_downstream(priv->ploam, &msg);
 	}
 }
@@ -2147,6 +2156,7 @@ int airoha_gpon_omci_hw_get_telemetry(void *hw_priv,
 						  &downstream_fec,
 						  &upstream_fec);
 	if (!ret) {
+		gpon_bb_cache_value(priv, GPON_BB_FEC, downstream_fec | (upstream_fec << 1));
 		telemetry->downstream_fec = downstream_fec ?
 			OMCI_FEC_STATUS_UP : OMCI_FEC_STATUS_DOWN;
 		telemetry->upstream_fec = upstream_fec ?
@@ -2200,6 +2210,8 @@ static void gpon_cb_state_changed(void *hw_priv, enum gpon_state state)
 	bool update_phy_state = true;
 	int ret;
 
+	gpon_bb_state(priv, state);
+
 	/*
 	 * Mirror the vendor PHY state sequencing before updating the MAC
 	 * activation state: disabled in O2, ranging formatter in O3/O4 and
@@ -2369,6 +2381,8 @@ static void gpon_cb_deactivate(void *hw_priv)
 {
 	struct xpon_priv *priv = hw_priv;
 
+	gpon_bb_deactivate(priv);
+
 	/*
 	 * The callback runs while the ordered IRQ worker is processing the
 	 * downstream FIFO. Defer the stop/restart sequence until that worker
@@ -2379,7 +2393,13 @@ static void gpon_cb_deactivate(void *hw_priv)
 		mod_delayed_work(priv->fsm_wq, &priv->restart_work, 0);
 }
 
+static void gpon_cb_rx_trace(void *hw_priv, u8 type, u8 onu_id, u8 result)
+{
+	gpon_bb_record(hw_priv, GPON_BB_RX, type, onu_id, result, 0);
+}
+
 static const struct ploam_ops gpon_ploam_ops = {
+	.rx_trace = gpon_cb_rx_trace,
 	.send_upstream       = gpon_cb_send_upstream,
 	.set_onu_id          = gpon_cb_set_onu_id,
 	.set_eqd_o4          = gpon_cb_set_eqd_o4,
@@ -2744,6 +2764,7 @@ static void gpon_handle_irq_status(struct xpon_priv *priv, u32 raw, u32 enabled)
 
 	/* G_INT_STATUS is W1C; acknowledge the complete hardware snapshot. */
 	gpon_write(priv, GPON_INT_STATUS, raw);
+	gpon_bb_record(priv, GPON_BB_IRQ, raw, enabled, 0, 0);
 
 	if (!active)
 		return;
@@ -2779,6 +2800,8 @@ static void airoha_xpon_phy_link_work_fn(struct work_struct *work)
 	if (priv->xpon)
 		xpon_device_report_optical(priv->xpon, ready, los);
 
+	if (changed)
+		gpon_bb_record(priv, GPON_BB_PHY, ready, los, GPON_BB_UNKNOWN, 0);
 	if (changed)
 		dev_info(priv->dev,
 			 "%s digital PHY link %s: ready=%u LOS=%u\n",
@@ -2814,6 +2837,7 @@ static void airoha_xpon_phy_link_work_fn(struct work_struct *work)
 	}
 
 rearm:
+	gpon_bb_sample(priv);
 	if (READ_ONCE(priv->phy_powered))
 		mod_delayed_work(priv->fsm_wq, &priv->phy_link_work,
 				 msecs_to_jiffies(XPON_LINK_POLL_MS));
@@ -3053,14 +3077,14 @@ static void gpon_dump_error_counters(struct xpon_priv *priv, u32 errors)
 			     gpon_read(priv, GPON_DBG_ERR_CTRL));
 	dev_warn_ratelimited(priv->dev,
 			     "GPON counters: rx=%u/%u/%u tx=%u/%u hec=%u/%u/%u\n",
-			     gpon_read(priv, GPON_DBG_RX_GEM_CNT),
-			     gpon_read(priv, GPON_DBG_RX_CRC_ERR_CNT),
-			     gpon_read(priv, GPON_DBG_RX_GTC_CNT),
-			     gpon_read(priv, GPON_DBG_TX_GEM_CNT),
-			     gpon_read(priv, GPON_DBG_TX_BST_CNT),
-			     gpon_read(priv, GPON_DBG_GEM_HEC_ONE_ERR_CNT),
-			     gpon_read(priv, GPON_DBG_GEM_HEC_TWO_ERR_CNT),
-			     gpon_read(priv, GPON_DBG_GEM_HEC_UC_ERR_CNT));
+			     gpon_bb_read_counter(priv, GPON_DBG_RX_GEM_CNT, GPON_BB_RX_GEM),
+			     gpon_bb_read_counter(priv, GPON_DBG_RX_CRC_ERR_CNT, GPON_BB_RX_CRC),
+			     gpon_bb_read_counter(priv, GPON_DBG_RX_GTC_CNT, GPON_BB_RX_GTC),
+			     gpon_bb_read_counter(priv, GPON_DBG_TX_GEM_CNT, GPON_BB_TX_GEM),
+			     gpon_bb_read_counter(priv, GPON_DBG_TX_BST_CNT, GPON_BB_TX_BURST),
+			     gpon_bb_read_counter(priv, GPON_DBG_GEM_HEC_ONE_ERR_CNT, GPON_BB_HEC1),
+			     gpon_bb_read_counter(priv, GPON_DBG_GEM_HEC_TWO_ERR_CNT, GPON_BB_HEC2),
+			     gpon_bb_read_counter(priv, GPON_DBG_GEM_HEC_UC_ERR_CNT, GPON_BB_HECU));
 }
 
 static void gpon_irq_work_fn(struct work_struct *work)
@@ -4221,6 +4245,7 @@ static int airoha_xpon_init_gpon(struct platform_device *pdev,
 	mutex_init(&priv->omci_config_lock);
 	mutex_init(&priv->link_state_lock);
 	spin_lock_init(&priv->ploam_tx_lock);
+	gpon_bb_init(priv);
 	bitmap_zero(priv->service_gems, GPON_MAX_GEM_ID);
 	bitmap_zero(priv->encrypted_gems, GPON_MAX_GEM_ID);
 	memset(priv->tcont_alloc_id, 0xff, sizeof(priv->tcont_alloc_id));
@@ -4261,6 +4286,7 @@ static int airoha_xpon_init_gpon(struct platform_device *pdev,
 	return 0;
 
 err_destroy_fsm_wq:
+	gpon_bb_cleanup(priv);
 	destroy_workqueue(priv->fsm_wq);
 	priv->fsm_wq = NULL;
 	return ret;
@@ -4268,6 +4294,7 @@ err_destroy_fsm_wq:
 
 static void airoha_xpon_cleanup_gpon(struct xpon_priv *priv)
 {
+	gpon_bb_cleanup(priv);
 	ploam_free(priv->ploam);
 	priv->ploam = NULL;
 
diff --git a/drivers/net/ethernet/airoha/airoha_xpon.h b/drivers/net/ethernet/airoha/airoha_xpon.h
