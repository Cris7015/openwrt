 }
 static DEVICE_ATTR_RO(gpon_gem_delin);
 
+static ssize_t gpon_gem_mib_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct xpon_priv *priv = dev_get_drvdata(dev);
+	unsigned int i;
+	bool eth;
+	int len;
+
+	if (!priv)
+		return -ENODEV;
+
+	mutex_lock(&priv->gem_mib_lock);
+	if (!priv->gem_mib_enabled) {
+		mutex_unlock(&priv->gem_mib_lock);
+		return sysfs_emit(buf, "enabled=0\n");
+	}
+	gpon_mib_accumulate_locked(priv);
+	eth = priv->gem_mib_ready &&
+	      (gpon_read(priv, GPON_FLEX_ONU_CAP) & FLEX_ONU_CAP_CNT_ETH);
+	len = sysfs_emit(buf, "enabled=1 ready=%u epoch=%u type=%s\n",
+			 priv->gem_mib_ready, priv->gem_mib_epoch,
+			 eth ? "ethernet" : "gem");
+	for (i = 0; i < GPON_GEM_MIB_SLOTS; i++) {
+		const struct gpon_gem_mib *m = &priv->gem_mib[i];
+
+		if (m->gem >= GPON_MAX_GEM_ID)
+			continue;
+		len += sysfs_emit_at(buf, len,
+				     "gem=%u rx_frames=%llu rx_bytes=%llu tx_frames=%llu tx_bytes=%llu\n",
+				     m->gem, m->total[GPON_MIB_RX_FRAMES],
+				     m->total[GPON_MIB_RX_BYTES],
+				     m->total[GPON_MIB_TX_FRAMES],
+				     m->total[GPON_MIB_TX_BYTES]);
+	}
+	mutex_unlock(&priv->gem_mib_lock);
+
+	return len;
+}
+static DEVICE_ATTR_RO(gpon_gem_mib);
+
+static ssize_t gpon_gem_mib_enable_show(struct device *dev,
+					struct device_attribute *attr,
+					char *buf)
+{
+	struct xpon_priv *priv = dev_get_drvdata(dev);
+
+	if (!priv)
+		return -ENODEV;
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(priv->gem_mib_enabled));
+}
+
+static ssize_t gpon_gem_mib_enable_store(struct device *dev,
+					 struct device_attribute *attr,
+					 const char *buf, size_t count)
+{
+	struct xpon_priv *priv = dev_get_drvdata(dev);
+	bool enable;
+	int ret;
+
+	if (!priv)
+		return -ENODEV;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->gem_mib_lock);
+	if (enable && !priv->gem_mib_enabled) {
+		priv->gem_mib_enabled = true;
+		if (!bitmap_empty(priv->hw_gems, GPON_MAX_GEM_ID))
+			gpon_mib_rebuild_locked(priv);
+		schedule_delayed_work(&priv->gem_mib_work,
+				      msecs_to_jiffies(GPON_MIB_POLL_MS));
+	} else if (!enable) {
+		priv->gem_mib_enabled = false;
+		priv->gem_mib_ready = false;
+	}
+	mutex_unlock(&priv->gem_mib_lock);
+
+	if (!enable)
+		cancel_delayed_work_sync(&priv->gem_mib_work);
+
+	return count;
+}
+static DEVICE_ATTR_RW(gpon_gem_mib_enable);
