+/*
+ * Per-GEM MIB counters. The MAC keeps RX/TX frame and payload byte counters
+ * for every valid GEM port in a dense MIB indexed through a table: row r
+ * holds the number of valid GEM ports below 16 * r. Adding or removing a
+ * GEM port shifts the rows of the higher ones, so the MIB is re-initialised
+ * (which zeroes it) and the table rebuilt right away; the counts are folded
+ * into software totals first.
+ */
+#define GPON_MIB_POLL_MS	5000
+
+static int gpon_mib_read_locked(struct xpon_priv *priv, u16 gem,
+				unsigned int type, u64 *val)
+{
+	u32 hi, lo;
+
+	lockdep_assert_held(&priv->gem_mib_lock);
+	gpon_write(priv, GPON_MIB_CTRL_STS,
+		   FIELD_PREP(MIB_CMD_TYPE_MASK, type) |
+		   FIELD_PREP(MIB_CMD_GEM_ID_MASK, gem));
+	/* Same stale completion bit as G_GEM_PORT_STS. */
+	udelay(1);
+	if (gpon_wait_bits(priv, GPON_MIB_CTRL_STS, MIB_CMD_DONE,
+			   GPON_CMD_TIMEOUT_US))
+		return -ETIMEDOUT;
+
+	hi = gpon_read(priv, GPON_MIB_RDATA_H32);
+	lo = gpon_read(priv, GPON_MIB_RDATA_L32);
+	*val = (u64)hi << 32 | lo;
+
+	return 0;
+}
+
+static void gpon_mib_accumulate_locked(struct xpon_priv *priv)
+{
+	unsigned int i, t;
+	u64 val;
+
+	lockdep_assert_held(&priv->gem_mib_lock);
+	if (!priv->gem_mib_ready || !READ_ONCE(priv->mac_enabled))
+		return;
+
+	for (i = 0; i < GPON_GEM_MIB_SLOTS; i++) {
+		struct gpon_gem_mib *m = &priv->gem_mib[i];
+
+		if (m->gem >= GPON_MAX_GEM_ID)
+			continue;
+		for (t = 0; t < GPON_MIB_NR; t++) {
+			if (gpon_mib_read_locked(priv, m->gem, t, &val))
+				continue;
+			/* The window is 64-bit; the counter width is unknown. */
+			if (val >= m->last[t])
+				m->total[t] += val - m->last[t];
+			else if (!(m->last[t] >> 32))
+				m->total[t] += (u32)(val - m->last[t]);
+			else
+				m->total[t] += val;
+			m->last[t] = val;
+		}
+	}
+}
+
+static int gpon_mib_rebuild_locked(struct xpon_priv *priv)
+{
+	unsigned int row, base = 0, i;
+	int ret;
+
+	lockdep_assert_held(&priv->gem_mib_lock);
+	priv->gem_mib_ready = false;
+	if (!READ_ONCE(priv->mac_enabled))
+		return -ENETDOWN;
+
+	gpon_write(priv, GPON_MIB_TBL_INIT, MIB_TBL_INIT_START);
+	gpon_write(priv, GPON_MIB_IDX_TBL_INIT, MIB_TBL_INIT_START);
+	ret = gpon_wait_bits(priv, GPON_MIB_TBL_INIT, MIB_TBL_INIT_DONE,
+			     GPON_CMD_TIMEOUT_US);
+	if (!ret)
+		ret = gpon_wait_bits(priv, GPON_MIB_IDX_TBL_INIT,
+				     MIB_TBL_INIT_DONE, GPON_CMD_TIMEOUT_US);
+
+	for (row = 0; !ret && row < GPON_MIB_IDX_ROWS; row++) {
+		if (row)
+			base += hweight16(bitmap_read(priv->hw_gems,
+						      (row - 1) * 16, 16));
+		gpon_write(priv, GPON_MIB_IDX_CFG, MIB_IDX_CMD_WRITE |
+			   FIELD_PREP(MIB_IDX_ROW_MASK, row) |
+			   FIELD_PREP(MIB_IDX_BASE_MASK, base));
+		udelay(1);
+		ret = gpon_wait_bits(priv, GPON_MIB_IDX_STS, MIB_IDX_CMD_DONE,
+				     GPON_CMD_TIMEOUT_US);
+	}
+
+	for (i = 0; i < GPON_GEM_MIB_SLOTS; i++)
+		memset(priv->gem_mib[i].last, 0, sizeof(priv->gem_mib[i].last));
+	priv->gem_mib_epoch++;
+	if (ret) {
+		dev_warn_ratelimited(priv->dev,
+				     "GPON MIB table init failed at row %u: %d\n",
+				     row, ret);
+		return ret;
+	}
+	priv->gem_mib_ready = true;
+
+	return 0;
+}
+
+static void gpon_mib_slot_update_locked(struct xpon_priv *priv, u16 gem,
+					bool valid)
+{
+	struct gpon_gem_mib *free = NULL;
+	unsigned int i;
+
+	for (i = 0; i < GPON_GEM_MIB_SLOTS; i++) {
+		struct gpon_gem_mib *m = &priv->gem_mib[i];
+
+		if (m->gem == gem) {
+			if (!valid)
+				m->gem = GPON_MAX_GEM_ID;
+			return;
+		}
+		if (!free && m->gem >= GPON_MAX_GEM_ID)
+			free = m;
+	}
+	if (valid && free) {
+		memset(free, 0, sizeof(*free));
+		free->gem = gem;
+	}
+}
+
+static void gpon_mib_invalidate(struct xpon_priv *priv)
+{
+	unsigned int i;
+
+	mutex_lock(&priv->gem_mib_lock);
+	priv->gem_mib_ready = false;
+	bitmap_zero(priv->hw_gems, GPON_MAX_GEM_ID);
+	for (i = 0; i < GPON_GEM_MIB_SLOTS; i++)
+		priv->gem_mib[i].gem = GPON_MAX_GEM_ID;
+	priv->gem_mib_epoch++;
+	mutex_unlock(&priv->gem_mib_lock);
+}
+
+static void gpon_mib_work_fn(struct work_struct *work)
+{
+	struct xpon_priv *priv = container_of(to_delayed_work(work),
+					      struct xpon_priv, gem_mib_work);
+	bool again;
+
+	mutex_lock(&priv->gem_mib_lock);
+	if (priv->gem_mib_enabled && !priv->gem_mib_ready &&
+	    !bitmap_empty(priv->hw_gems, GPON_MAX_GEM_ID))
+		gpon_mib_rebuild_locked(priv);
+	gpon_mib_accumulate_locked(priv);
+	again = priv->gem_mib_enabled;
+	mutex_unlock(&priv->gem_mib_lock);
+
+	if (again)
+		schedule_delayed_work(&priv->gem_mib_work,
+				      msecs_to_jiffies(GPON_MIB_POLL_MS));
+}
+
+static void gpon_mib_init(struct xpon_priv *priv)
+{
+	unsigned int i;
+
+	mutex_init(&priv->gem_mib_lock);
+	INIT_DELAYED_WORK(&priv->gem_mib_work, gpon_mib_work_fn);
+	bitmap_zero(priv->hw_gems, GPON_MAX_GEM_ID);
+	for (i = 0; i < GPON_GEM_MIB_SLOTS; i++)
+		priv->gem_mib[i].gem = GPON_MAX_GEM_ID;
+}
+
+static int gpon_set_gem_port_hw(struct xpon_priv *priv, u16 gem_port_id,
+				bool valid, bool encrypted)
+{
+	bool was;
+	int ret;
+
+	if (gem_port_id >= GPON_MAX_GEM_ID)
+		return -EINVAL;
+
+	mutex_lock(&priv->gem_mib_lock);
+	was = test_bit(gem_port_id, priv->hw_gems);
+	/* Fold the counts in while the rows still match the old GEM set. */
+	if (was != valid && priv->gem_mib_enabled)
+		gpon_mib_accumulate_locked(priv);
+	ret = gpon_write_gem_port_hw(priv, gem_port_id, valid, encrypted);
+	if (!ret && was != valid) {
+		__assign_bit(gem_port_id, priv->hw_gems, valid);
+		gpon_mib_slot_update_locked(priv, gem_port_id, valid);
+		if (priv->gem_mib_enabled)
+			gpon_mib_rebuild_locked(priv);
+	}
+	mutex_unlock(&priv->gem_mib_lock);
+
+	return ret;
+}
+
 static int gpon_set_alloc_id_hw(struct xpon_priv *priv, u16 alloc_id,
 				bool allocate)
