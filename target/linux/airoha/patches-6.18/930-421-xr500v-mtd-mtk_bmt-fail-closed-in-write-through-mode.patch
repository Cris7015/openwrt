From 7b3cdf83556295b9d2fc37c02b942ab0976e62a2 Mon Sep 17 00:00:00 2001
From: Cristian Papa <76759272+Cris7015@users.noreply.github.com>
Date: Wed, 7 Oct 2026 01:22:29 -0300
Subject: [PATCH] mtd: mtk_bmt: fail closed in write-through mode

EcoNet write-through mode deliberately disables dynamic remapping and
table updates.  Return bad-block detection as an I/O error instead of
entering the generic skip/remap path, and reject explicit markbad requests
so a caller cannot mutate the OEM metadata behind that policy.

Signed-off-by: Cristian Papa <76759272+Cris7015@users.noreply.github.com>
---
 drivers/mtd/nand/mtk_bmt.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/drivers/mtd/nand/mtk_bmt.c b/drivers/mtd/nand/mtk_bmt.c
index 2737496ae..39d832130 100644
--- a/drivers/mtd/nand/mtk_bmt.c
+++ b/drivers/mtd/nand/mtk_bmt.c
@@ -271,6 +271,12 @@ mtk_bmt_block_isbad(struct mtd_info *mtd, loff_t ofs)
 retry:
 	block = bmtd.ops->get_mapping_block(orig_block);
 	ret = bmtd._block_isbad(mtd, (loff_t)block << bmtd.blk_shift);
+	if (ret && of_property_read_bool(mtd_get_of_node(mtd),
+					 "econet,bmt-write-through")) {
+		pr_err_ratelimited("mtk_bmt: bad-block result %d in write-through mode; aborting without skip/remap\n",
+				   ret);
+		return ret > 0 ? -EIO : ret;
+	}
 	if (ret) {
 		if (mtk_bmt_remap_block(orig_block, block, bmtd.blk_size) &&
 		    retry_count++ < 10)
@@ -285,6 +291,10 @@ mtk_bmt_block_markbad(struct mtd_info *mtd, loff_t ofs)
 	u16 orig_block = ofs >> bmtd.blk_shift;
 	int block;
 
+	if (of_property_read_bool(mtd_get_of_node(mtd),
+				  "econet,bmt-write-through"))
+		return -EOPNOTSUPP;
+
 	block = bmtd.ops->get_mapping_block(orig_block);
 	if (block < 0)
 		return -EIO;
