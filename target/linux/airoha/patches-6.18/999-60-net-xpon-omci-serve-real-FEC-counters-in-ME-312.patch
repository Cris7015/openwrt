 		memcpy(pm->base, pm->last, sizeof(pm->base));
 }
 
+/*
+ * Fold the hardware FEC totals into the running interval. They are 32 bits
+ * wide and sampled every minute, so an unsigned difference survives a wrap.
+ * A new generation means they restarted from zero.
+ */
+static void omci_fec_pm_sample_locked(struct omci_device *odev)
+{
+	struct omci_fec_pm *pm = &odev->agent.fec_pm;
+	u32 now[OMCI_FEC_PM_COUNTERS];
+	struct omci_fec_counters c;
+	unsigned int i;
+
+	lockdep_assert_held(&odev->agent.lock);
+	if (!odev->ops->get_fec_counters ||
+	    odev->ops->get_fec_counters(odev, &c))
+		return;
+
+	now[OMCI_FEC_PM_CORRECTED_BYTES] = c.corrected_bytes;
+	now[OMCI_FEC_PM_CORRECTED_CODEWORDS] = c.corrected_codewords;
+	now[OMCI_FEC_PM_UNCORRECTABLE_CODEWORDS] = c.uncorrectable_codewords;
+	now[OMCI_FEC_PM_TOTAL_CODEWORDS] = c.total_codewords;
+	now[OMCI_FEC_PM_SECONDS] = c.seconds;
+
+	for (i = 0; pm->sampled && i < OMCI_FEC_PM_COUNTERS; i++)
+		pm->count[i] += pm->generation == c.generation ?
+				now[i] - pm->last[i] : now[i];
+
+	memcpy(pm->last, now, sizeof(pm->last));
+	pm->generation = c.generation;
+	pm->sampled = true;
+}
+
+/* A PM history instance counts from its creation (G.988 I.4). */
+static void omci_fec_pm_start_locked(struct omci_device *odev, u16 entity_id)
+{
+	struct omci_agent *agent = &odev->agent;
+	struct omci_mib_object *object;
+
+	omci_fec_pm_sample_locked(odev);
+	memset(agent->fec_pm.count, 0, sizeof(agent->fec_pm.count));
+	object = omci_mib_lookup(agent, OMCI_CLASS_FEC_PM, entity_id);
+	if (!object)
+		return;
+	object->data[OMCI_GEM_PM_END_TIME_OFFSET] = agent->pm_interval;
+	if (object->data_len < OMCI_FEC_PM_DATA_LEN)
+		object->data_len = OMCI_FEC_PM_DATA_LEN;
+}
+
+/* The interval just closed: its counts become the history attributes. */
+static void omci_fec_pm_close_locked(struct omci_agent *agent)
+{
+	const struct omci_me_desc *desc;
+	struct omci_mib_object *object;
+	unsigned long index;
+	unsigned int i;
+
+	desc = omci_me_lookup(agent, OMCI_CLASS_FEC_PM);
+	omci_for_each_fec_pm(agent, index, object) {
+		for (i = 0; desc && i < desc->num_attrs; i++) {
+			const struct omci_attr_desc *attr = &desc->attrs[i];
+			int counter = omci_fec_pm_counter(attr->mask);
+
+			if (counter < 0)
+				continue;
+			omci_gem_pm_put_counter(object->data + attr->offset,
+						attr->len,
+						agent->fec_pm.count[counter]);
+		}
+		object->data[OMCI_GEM_PM_END_TIME_OFFSET] = agent->pm_interval;
+		if (object->data_len < OMCI_FEC_PM_DATA_LEN)
+			object->data_len = OMCI_FEC_PM_DATA_LEN;
+	}
+	memset(agent->fec_pm.count, 0, sizeof(agent->fec_pm.count));
+}
+
