+static int omci_fec_pm_counter(u16 mask)
+{
+	switch (mask) {
+	case BIT(13):
+		return OMCI_FEC_PM_CORRECTED_BYTES;
+	case BIT(12):
+		return OMCI_FEC_PM_CORRECTED_CODEWORDS;
+	case BIT(11):
+		return OMCI_FEC_PM_UNCORRECTABLE_CODEWORDS;
+	case BIT(10):
+		return OMCI_FEC_PM_TOTAL_CODEWORDS;
+	case BIT(9):
+		return OMCI_FEC_PM_SECONDS;
+	default:
+		return -1;
+	}
+}
