+/*
+ * FoE v1 routes IPv6 TCP/UDP 5-tuples without extension headers. Offer only
+ * those, towards a unicast address beyond the link: neighbour discovery,
+ * multicast and link-local traffic always ends up on the CPU.
+ */
+static bool airoha_whnat_ipv6_offerable(const struct sk_buff *skb)
+{
+	const struct ipv6hdr *ip6h;
+	struct ipv6hdr _ip6h;
+	int type;
+
+	if (!READ_ONCE(whnat_ipv6))
+		return false;
+
+	ip6h = skb_header_pointer(skb, 0, sizeof(_ip6h), &_ip6h);
+	if (!ip6h || ip6h->version != 6 ||
+	    (ip6h->nexthdr != IPPROTO_TCP && ip6h->nexthdr != IPPROTO_UDP))
+		return false;
+
+	type = ipv6_addr_type(&ip6h->daddr);
+	return (type & IPV6_ADDR_UNICAST) &&
+	       !(type & (IPV6_ADDR_LINKLOCAL | IPV6_ADDR_LOOPBACK));
+}
+
 static bool airoha_whnat_upstream(struct sk_buff *skb)
 {
 	struct net_device *vif_dev;
 	struct airoha_qdma *qdma;
 	struct airoha_ppe *ppe;
 	bool taken = false;
+	bool ipv6;
 	int idx;
 
 	if (!READ_ONCE(whnat_enable) || !skb || !skb->dev ||
-	    skb->protocol != htons(ETH_P_IP) || skb_is_gso(skb) ||
-	    skb_vlan_tag_present(skb))
+	    skb_is_gso(skb) || skb_vlan_tag_present(skb))
+		return false;
+
+	ipv6 = skb->protocol == htons(ETH_P_IPV6);
+	if (ipv6 ? !airoha_whnat_ipv6_offerable(skb) :
+		   skb->protocol != htons(ETH_P_IP))
 		return false;
 
 	idx = airoha_whnat_vif_index(skb->dev);
@@ -482,6 +526,8 @@
 	skb->dev = NULL;
 	if (airoha_whnat_qdma_xmit(qdma, skb) >= 0) {
 		atomic_inc(&handed);
+		if (ipv6)
+			atomic_inc(&handed6);
 		taken = true;
 	} else {
 		memmove(skb->data + VLAN_HLEN, skb->data, 2 * ETH_ALEN);
@@ -614,6 +660,8 @@
 		skb_set_network_header(skb, ETH_HLEN);
 		skb->protocol = eth_hdr(skb)->h_proto;
 		atomic_inc(&downstream);
+		if (skb->protocol == htons(ETH_P_IPV6))
+			atomic_inc(&downstream6);
 		if (batch) {
 			if (!batch->dev[idx]) {
 				dev_hold(dev);
