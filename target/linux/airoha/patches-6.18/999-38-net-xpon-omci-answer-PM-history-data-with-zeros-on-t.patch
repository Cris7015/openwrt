From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cristian Papa <pcristian292@gmail.com>
Date: Thu, 5 Nov 2026 13:22:15 -0300
Subject: [PATCH 29/48] net: xpon: omci: answer PM history data with zeros on
 the PM clock

The OLT creates PM history data MEs for its UNIs, bridge ports, FEC and
GAL and reads them every 15 minutes. Apart from ME 341 they had no
descriptor, so a Get returned the stored Create contents from offset 0
under whatever mask was asked for: the threshold data 1/2 ID the OLT had
written came back as the interval end time or as the most significant
bytes of the first counter (0x00010000 for ID 1 when the mask starts at
the counters), and the interval end time never moved.

Describe the PM history data MEs whose G.988 layout is plain: Ethernet
PM history data (24), its parts 2 and 3 (89, 296), MAC bridge (51) and
MAC bridge port (52) PM, GAL Ethernet PM (276), FEC PM (312), Ethernet
frame PM upstream and downstream (322, 321) and Ethernet frame extended
PM (334). The agent has no counters behind them, so a Get and a Get
current data now return zeros of the right sizes, the stored threshold
data pointer (or control block) and an interval end time taken from the
15-min clock ME 341 runs on, restarted by Synchronize time. Requests
that do not fit come back with result 9 and the attribute masks.

They are flagged as shadow support so that the OMCI ME type table keeps
listing them only once the OLT creates an instance, as before. ME 341 is
unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 net/xpon/omci/agent.c |  10 ++++
 net/xpon/omci/me.c    | 103 ++++++++++++++++++++++++++++++++++++++++++
 net/xpon/omci/me.h    |  19 ++++++++
 3 files changed, 132 insertions(+)

diff --git a/net/xpon/omci/agent.c b/net/xpon/omci/agent.c
index cd6d8a1..695faac 100644
--- a/net/xpon/omci/agent.c
+++ b/net/xpon/omci/agent.c
@@ -4323,6 +4323,16 @@ static u8 omci_agent_get_locked(struct omci_device *odev, u16 class_id,
 		failed = omci_agent_refresh_ani_g_levels(odev, object, mask);
 
 	desc = omci_me_lookup(agent, class_id);
+	if (desc && (desc->flags & OMCI_ME_F_PM)) {
+		/*
+		 * No counters behind this PM ME: they read as zeros, and the
+		 * interval end time numbers the last completed 15-min interval
+		 * of the same clock ME 341 runs on.
+		 */
+		omci_pm_tick_locked(odev);
+		object->data[OMCI_PM_INTERVAL_END_TIME_OFFSET] =
+			agent->pm_interval;
+	}
 	switch (class_id) {
 	case OMCI_CLASS_PRIORITY_QUEUE:
 		num_attrs = omci_layout_attrs(omci_priority_queue_layout,
diff --git a/net/xpon/omci/me.c b/net/xpon/omci/me.c
index 6490250..017a960 100644
--- a/net/xpon/omci/me.c
+++ b/net/xpon/omci/me.c
@@ -687,6 +687,67 @@ static const struct omci_attr_desc omci_olt_g_attrs[] = {
 	OMCI_ATTR(12, 38, 14, OMCI_RW),		/* Time of day information */
 };
 
+/*
+ * PM history data MEs the agent has no counters for. Attribute 1 is the
+ * interval end time and attribute 2 the threshold data 1/2 ID (G.988 I.4);
+ * the counters are not kept and read as zeros.
+ */
+#define OMCI_PM_COUNTER(_bit, _len) \
+	OMCI_ATTR(_bit, OMCI_ATTR_OFFSET_ZERO, _len, OMCI_R)
+#define OMCI_PM_HEADER \
+	OMCI_ATTR(15, 0, 1, OMCI_R),		/* Interval end time */ \
+	OMCI_ATTR(14, 1, 2, OMCI_RW_SC)		/* Threshold data 1/2 ID */
+/* Ethernet PM history data: 14 counters */
+static const struct omci_attr_desc omci_ethernet_pm_attrs[] = {
+	OMCI_PM_HEADER,
+	OMCI_PM_COUNTER(13, 4), OMCI_PM_COUNTER(12, 4), OMCI_PM_COUNTER(11, 4),
+	OMCI_PM_COUNTER(10, 4), OMCI_PM_COUNTER(9, 4), OMCI_PM_COUNTER(8, 4),
+	OMCI_PM_COUNTER(7, 4), OMCI_PM_COUNTER(6, 4), OMCI_PM_COUNTER(5, 4),
+	OMCI_PM_COUNTER(4, 4), OMCI_PM_COUNTER(3, 4), OMCI_PM_COUNTER(2, 4),
+	OMCI_PM_COUNTER(1, 4), OMCI_PM_COUNTER(0, 4),
+};
+
+/*
+ * Ethernet PM history data 3 (296) and Ethernet frame PM history data
+ * upstream/downstream (322/321) share the layout: 14 counters of 4 bytes.
+ */
+#define omci_ethernet_pm3_attrs		omci_ethernet_pm_attrs
+#define omci_ethernet_frame_pm_attrs	omci_ethernet_pm_attrs
+
+/* One 4-byte counter: Ethernet PM 2, MAC bridge PM, GAL Ethernet PM */
+static const struct omci_attr_desc omci_pm_one_counter_attrs[] = {
+	OMCI_PM_HEADER,
+	OMCI_PM_COUNTER(13, 4),
+};
+
+/* MAC bridge port PM history data: 5 counters */
+static const struct omci_attr_desc omci_mac_bridge_port_pm_attrs[] = {
+	OMCI_PM_HEADER,
+	OMCI_PM_COUNTER(13, 4), OMCI_PM_COUNTER(12, 4), OMCI_PM_COUNTER(11, 4),
+	OMCI_PM_COUNTER(10, 4), OMCI_PM_COUNTER(9, 4),
+};
+
+/* FEC PM history data: 4 counters, then FEC seconds (2 bytes) */
+static const struct omci_attr_desc omci_fec_pm_attrs[] = {
+	OMCI_PM_HEADER,
+	OMCI_PM_COUNTER(13, 4), OMCI_PM_COUNTER(12, 4), OMCI_PM_COUNTER(11, 4),
+	OMCI_PM_COUNTER(10, 4), OMCI_PM_COUNTER(9, 2),
+};
+
+/*
+ * Ethernet frame extended PM: a 16-byte control block in
+ * place of the threshold data pointer, then 14 counters of 4 bytes.
+ */
+static const struct omci_attr_desc omci_ethernet_frame_ext_pm_attrs[] = {
+	OMCI_ATTR(15, 0, 1, OMCI_R),		/* Interval end time */
+	OMCI_ATTR(14, 1, 16, OMCI_RW_SC),	/* Control block */
+	OMCI_PM_COUNTER(13, 4), OMCI_PM_COUNTER(12, 4), OMCI_PM_COUNTER(11, 4),
+	OMCI_PM_COUNTER(10, 4), OMCI_PM_COUNTER(9, 4), OMCI_PM_COUNTER(8, 4),
+	OMCI_PM_COUNTER(7, 4), OMCI_PM_COUNTER(6, 4), OMCI_PM_COUNTER(5, 4),
+	OMCI_PM_COUNTER(4, 4), OMCI_PM_COUNTER(3, 4), OMCI_PM_COUNTER(2, 4),
+	OMCI_PM_COUNTER(1, 4), OMCI_PM_COUNTER(0, 4),
+};
+
 #define STANDARD_ACTIONS (OMCI_ME_ACTION_GET | OMCI_ME_ACTION_SET)
 #define OLT_CREATED_ACTIONS (OMCI_ME_ACTION_CREATE | OMCI_ME_ACTION_DELETE | \
 			     OMCI_ME_ACTION_GET | OMCI_ME_ACTION_SET)
@@ -894,6 +955,48 @@ static const struct omci_me_desc omci_me_descs[] = {
 		      OMCI_ME_F_ONU_CREATED, GENMASK(15, 12), GENMASK(15, 12), 52,
 		      OMCI_CLASS_CATEGORY_MANAGEMENT, OMCI_CLASS_SUPPORT_NATIVE,
 		      omci_olt_g_attrs),
+
+	/*
+	 * PM history data the OLT creates and the agent has no counters for:
+	 * the interval end time follows the PM clock and the counters read
+	 * as zeros. Shadow support keeps them out of the OMCI ME type table
+	 * until the OLT creates one, as before.
+	 */
+#define PM_DESC(_class, _name, _mask, _len, _attrs) \
+	STANDARD_DESC((_class), (_name), \
+		      OLT_CREATED_ACTIONS | OMCI_ME_ACTION_GET_CURRENT_DATA, \
+		      OMCI_ME_F_PM, (_mask), BIT(14), (_len), \
+		      OMCI_CLASS_CATEGORY_PERFORMANCE, OMCI_CLASS_SUPPORT_SHADOW, \
+		      _attrs)
+	PM_DESC(OMCI_CLASS_ETHERNET_PM,
+		"Ethernet performance monitoring history data",
+		GENMASK(15, 0), 3, omci_ethernet_pm_attrs),
+	PM_DESC(OMCI_CLASS_MAC_BRIDGE_PM,
+		"MAC bridge performance monitoring history data",
+		GENMASK(15, 13), 3, omci_pm_one_counter_attrs),
+	PM_DESC(OMCI_CLASS_MAC_BRIDGE_PORT_PM,
+		"MAC bridge port performance monitoring history data",
+		GENMASK(15, 9), 3, omci_mac_bridge_port_pm_attrs),
+	PM_DESC(OMCI_CLASS_ETHERNET_PM2,
+		"Ethernet performance monitoring history data 2",
+		GENMASK(15, 13), 3, omci_pm_one_counter_attrs),
+	PM_DESC(OMCI_CLASS_GAL_ETHERNET_PM,
+		"GAL Ethernet performance monitoring history data",
+		GENMASK(15, 13), 3, omci_pm_one_counter_attrs),
+	PM_DESC(OMCI_CLASS_ETHERNET_PM3,
+		"Ethernet performance monitoring history data 3",
+		GENMASK(15, 0), 3, omci_ethernet_pm3_attrs),
+	PM_DESC(OMCI_CLASS_FEC_PM, "FEC performance monitoring history data",
+		GENMASK(15, 9), 3, omci_fec_pm_attrs),
+	PM_DESC(OMCI_CLASS_ETHERNET_FRAME_PM_DS,
+		"Ethernet frame performance monitoring history data downstream",
+		GENMASK(15, 0), 3, omci_ethernet_frame_pm_attrs),
+	PM_DESC(OMCI_CLASS_ETHERNET_FRAME_PM_US,
+		"Ethernet frame performance monitoring history data upstream",
+		GENMASK(15, 0), 3, omci_ethernet_frame_pm_attrs),
+	PM_DESC(OMCI_CLASS_ETHERNET_FRAME_EXT_PM, "Ethernet frame extended PM",
+		GENMASK(15, 0), 17, omci_ethernet_frame_ext_pm_attrs),
+#undef PM_DESC
 };
 
 static bool omci_class_name_contains(const char *name, const char *needle)
diff --git a/net/xpon/omci/me.h b/net/xpon/omci/me.h
index 7eb5f3f..d5f569e 100644
--- a/net/xpon/omci/me.h
+++ b/net/xpon/omci/me.h
@@ -70,6 +70,20 @@ struct omci_mib_object;
 #define OMCI_CLASS_VEIP		329
 #define OMCI_CLASS_GEM_PORT_CTP_PM	341
 
+/* PM history data MEs without counters behind them (zeros) */
+#define OMCI_CLASS_ETHERNET_PM		24
+#define OMCI_CLASS_MAC_BRIDGE_PM	51
+#define OMCI_CLASS_MAC_BRIDGE_PORT_PM	52
+#define OMCI_CLASS_ETHERNET_PM2		89
+#define OMCI_CLASS_GAL_ETHERNET_PM	276
+#define OMCI_CLASS_ETHERNET_PM3		296
+#define OMCI_CLASS_FEC_PM		312
+#define OMCI_CLASS_ETHERNET_FRAME_PM_DS	321
+#define OMCI_CLASS_ETHERNET_FRAME_PM_US	322
+#define OMCI_CLASS_ETHERNET_FRAME_EXT_PM	334
+/* Attribute 1 of every PM history data ME */
+#define OMCI_PM_INTERVAL_END_TIME_OFFSET	0
+
 #define OMCI_CLASS_HUAWEI_FLOW_MAPPING	350
 #define OMCI_CLASS_HUAWEI_VLAN_MAPPING	352
 #define OMCI_CLASS_HUAWEI_SW_IMAGE_EXT	353
@@ -114,6 +128,11 @@ struct omci_mib_object;
 #define OMCI_ME_F_DATAPATH		BIT(2)
 #define OMCI_ME_F_SAFE_FAKE		BIT(3)
 #define OMCI_ME_F_VENDOR		BIT(4)
+/*
+ * PM history data ME on the 15-min interval clock: the agent fills in the
+ * interval end time, the counters it cannot measure read as zeros.
+ */
+#define OMCI_ME_F_PM			BIT(5)
 
 #define OMCI_PROFILE_BIT(_profile)	BIT(_profile)
 #define OMCI_PROFILE_STANDARD_MASK	GENMASK(7, 1)
