/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

#include "en751221.dtsi"

/ {
	model = "TP-Link Archer XR500v v1";
	compatible = "tplink,archer-xr500v-v1", "econet,en751221";

	memory@0 {
		device_type = "memory";
		reg = <0x00000000 0x10000000>;
	};

	chosen {
		stdout-path = "/serial@1fbf0000:115200";
		linux,usable-memory-range = <0x00020000 0x0ffe0000>;
	};

	leds {
		compatible = "gpio-leds";

		led-wps {
			label = "green:wps";
			gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
		};

		led-usb {
			label = "green:usb";
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
		};

		led-internet {
			label = "green:internet";
			gpios = <&gpio0 28 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		key-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wifi {
			label = "wifi";
			linux,code = <KEY_RFKILL>;
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};

		key-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	/*
	 * The EN751221 contains an on-die MT7530-class switch.  Its port 5
	 * cascades into the MCM switch, whose ports 1 through 4 are the four
	 * physical LAN jacks.  Port 6 of the on-die switch is the CPU conduit.
	 */
	switch_ondie: switch@1fb58000 {
		compatible = "econet,en751221-switch";
		reg = <0x1fb58000 0x8000>;
		resets = <&scuclk EN751221_GSW_RST>;
		#address-cells = <1>;
		#size-cells = <0>;
		dsa,member = <0 0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ondie_port5: port@5 {
				reg = <5>;
				phy-mode = "trgmii";
				link = <&mcm_port6>;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@6 {
				reg = <6>;
				label = "cpu";
				ethernet = <&gmac0>;
				phy-mode = "trgmii";

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			switch_mcm: switch@1f {
				compatible = "econet,en751221-switch";
				reg = <0x1f>;
				mediatek,mcm;
				#address-cells = <1>;
				#size-cells = <0>;
				dsa,member = <0 1>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						phy-mode = "gmii";
						phy-handle = <&mcmphy0>;
						status = "disabled";
					};

					port@1 {
						reg = <1>;
						label = "lan4";
						phy-mode = "gmii";
						phy-handle = <&mcmphy1>;
					};

					port@2 {
						reg = <2>;
						label = "lan3";
						phy-mode = "gmii";
						phy-handle = <&mcmphy2>;
					};

					port@3 {
						reg = <3>;
						label = "lan2";
						phy-mode = "gmii";
						phy-handle = <&mcmphy3>;
					};

					port@4 {
						reg = <4>;
						label = "lan1";
						phy-mode = "gmii";
						phy-handle = <&mcmphy4>;
					};

					mcm_port6: port@6 {
						reg = <6>;
						phy-mode = "trgmii";
						link = <&ondie_port5>;

						fixed-link {
							speed = <1000>;
							full-duplex;
						};
					};
				};

				mdio {
					#address-cells = <1>;
					#size-cells = <0>;

					mcmphy0: ethernet-phy@0 {
						compatible = "ethernet-phy-ieee802.3-c22";
						reg = <0>;
					};

					mcmphy1: ethernet-phy@1 {
						compatible = "ethernet-phy-ieee802.3-c22";
						reg = <1>;
					};

					mcmphy2: ethernet-phy@2 {
						compatible = "ethernet-phy-ieee802.3-c22";
						reg = <2>;
					};

					mcmphy3: ethernet-phy@3 {
						compatible = "ethernet-phy-ieee802.3-c22";
						reg = <3>;
					};

					mcmphy4: ethernet-phy@4 {
						compatible = "ethernet-phy-ieee802.3-c22";
						reg = <4>;
					};
				};
			};
		};
	};
};

&ethernet {
	/* The adjacent 0x1fb58000 window belongs exclusively to switch_ondie. */
	reg = <0x1fb50000 0x8000>;
	resets = <&scuclk EN751221_FE_RST>,
		 <&scuclk EN751221_FE_QDMA1_RST>,
		 <&scuclk EN751221_FE_QDMA2_RST>;
	reset-names = "fe", "qdma0", "qdma1";

	/delete-node/ mdio-bus;
};

&nand {
	status = "okay";
	econet,bmt;
	econet,esmt-f50l1g41a-oem-fdm;
	econet,bmt-write-through;
	/* Fail closed unless the OEM reserve geometry matches tested hardware. */
	econet,assert-reserve-size = <94>;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		partition@0 {
			label = "bootloader";
			reg = <0x0 0x40000>;
			read-only;
		};

		partition@40000 {
			label = "romfile";
			reg = <0x40000 0x40000>;
			read-only;
		};

		partition@80000 {
			label = "kernel";
			reg = <0x80000 0x300000>;
			read-only;
		};

		partition@380000 {
			label = "rootfs_stock";
			reg = <0x380000 0x1000000>;
			read-only;
		};

		partition@1380000 {
			label = "misc";
			reg = <0x1380000 0x480000>;
			read-only;

			nvmem-layout {
				compatible = "fixed-layout";
				#address-cells = <1>;
				#size-cells = <1>;

				macaddr_misc_f100: macaddr@f100 {
					compatible = "mac-base";
					reg = <0xf100 0x6>;
					#nvmem-cell-cells = <1>;
				};

				eeprom_misc_e0000: eeprom@e0000 {
					reg = <0xe0000 0x200>;
				};
			};
		};

		partition@1800000 {
			label = "kernel1";
			reg = <0x1800000 0x300000>;
		};

		partition@1b00000 {
			label = "rootfs1";
			reg = <0x1b00000 0x1000000>;
			linux,rootfs;
		};

		partition@2b00000 {
			label = "others";
			reg = <0x2b00000 0x4e0000>;
			read-only;
		};

		partition@2fe0000 {
			label = "bootflag";
			reg = <0x2fe0000 0x20000>;
			read-only;
		};

		/*
		 * Dedicated OpenWrt overlay area in the OEM-unallocated NAND range.
		 * Keep this separate from the 16 MiB firmware slots and from the
		 * EN75 BMT reserve at the end of the device.
		 */
		partition@3000000 {
			label = "openwrt_ubi";
			reg = <0x3000000 0x4000000>;
		};
	};
};

&gmac0 {
	status = "okay";
	nvmem-cells = <&macaddr_misc_f100 0>;
	nvmem-cell-names = "mac-address";
};

&pcie0 {
	status = "okay";
	/* Opt in only this controller to the EN751221 config-TLP quirks. */
	econet,en751221-port0-quirks;
};

&slot0 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;

		/*
		 * MT7603 expects a 1 KiB EEPROM. mt76 zero-initializes that
		 * buffer before copying this compact 256-byte non-zero prefix;
		 * the resulting image is byte-identical to the reconstructed
		 * 1 KiB lab EEPROM. Runtime eFuse calibration is merged where
		 * the chip reports valid calibration-free fields.
		 */
		mediatek,eeprom-data = [
			03 76 00 00 02 76 03 50 00 01 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 22 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 b8 40 c8 20 00 00 00 40 c8 20 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
			05 00 00 00 a4 00 00 88 00 00 00 00 00 00 00 00
		];
		mediatek,eeprom-merge-otp;
		nvmem-cells = <&macaddr_misc_f100 1>;
		nvmem-cell-names = "mac-address";
	};
};

&pcie1 {
	status = "okay";
};

&slot1 {
	wifi@0,0 {
		compatible = "mediatek,mt76";
		reg = <0x0000 0 0 0 0>;
		nvmem-cells = <&eeprom_misc_e0000>, <&macaddr_misc_f100 2>;
		nvmem-cell-names = "eeprom", "mac-address";

		led {
			led-sources = <2>;
			led-active-low;
		};
	};
};

&usb {
	mediatek,u3p-dis-msk = <0x1>;
};
