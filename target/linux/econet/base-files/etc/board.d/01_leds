#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
tplink,archer-xr500v-v1)
	ucidef_set_led_netdev "internet" "Internet" "green:internet" "eth0" "link tx rx"
	ucidef_set_led_usbport "usb" "USB" "green:usb" \
		"usb1-port1" "usb1-port2" "usb2-port1" "usb2-port2"
	;;
esac

board_config_flush

exit 0
