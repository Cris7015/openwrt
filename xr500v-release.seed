CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_en751221=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_airoha_en751221_DEVICE_tplink_archer-xr500v-v1=y
CONFIG_TARGET_DEVICE_airoha_en751221_DEVICE_tplink_archer-xr500v-v1-oem=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_omci-agent=y
CONFIG_PACKAGE_xr500v-voip=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-xr500v-voip=y
CONFIG_PACKAGE_luci-app-omci=y
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_TIMEOUT=1
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_MPTCP is not set
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_BUILD_DOMAIN="openwrt"
CONFIG_PACKAGE_kmod-usb3=m
CONFIG_PACKAGE_kmod-usb-storage=m
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=m

CONFIG_VERSIONOPT=y
CONFIG_VERSION_NUMBER="2026.10.25"
CONFIG_PACKAGE_bridger=y
